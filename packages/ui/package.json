{
  "name": "@hms/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "imports": {
    "#components/*": "./src/components/*.tsx",
    "#hooks/*": "./src/hooks/*.ts",
    "#lib/*": "./src/lib/*.ts"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./components/*": "./src/components/*.tsx",
    "./hooks/*": "./src/hooks/*.ts",
    "./lib/*": "./src/lib/*.ts",
    "./styles/globals.css": "./src/styles/globals.css"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "format": "prettier --check ."
  },
  "dependencies": {
    "react": "^19.1.1"
  },
  "devDependencies": {
    "@hms/config": "workspace:*",
    "@types/react": "^19.1.11",
    "eslint": "^9.34.0",
    "prettier": "^3.6.2",
    "typescript": "^6.0.3"
  }
}
