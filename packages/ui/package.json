{
  "name": "@hms/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "imports": {
    "#components/*": "./src/components/*.tsx",
    "#hooks/*": "./src/hooks/*.ts",
    "#lib/*": "./src/lib/*.ts",
    "#rbac/*": "./src/rbac/*"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./components/*": "./src/components/*.tsx",
    "./hooks/*": "./src/hooks/*.ts",
    "./lib/*": "./src/lib/*.ts",
    "./rbac/*": "./src/rbac/*",
    "./styles/globals.css": "./src/styles/globals.css"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "format": "prettier --check ."
  },
  "dependencies": {
    "@casl/ability": "^6.7.3",
    "@casl/react": "^5.0.0",
    "@radix-ui/react-checkbox": "^1.3.7",
    "@radix-ui/react-select": "^2.3.3",
    "@radix-ui/react-slot": "^1.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.23.0",
    "material-symbols": "^0.45.8",
    "radix-ui": "^1.6.2",
    "react": "^19.1.1",
    "shadcn": "^4.13.0",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@hms/config": "workspace:*",
    "@types/react": "^19.1.11",
    "eslint": "^9.34.0",
    "prettier": "^3.6.2",
    "typescript": "^6.0.3"
  }
}
