{
  "name": "@hms/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "imports": {
    "#components/*": "./components/*.tsx",
    "#hooks/*": "./hooks/*.ts",
    "#lib/*": "./lib/*.ts"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
