    "format": "prettier --check ."
  },
  "dependencies": {
    "axios": "^1.13.1",
    "@hms/shared-types": "workspace:*",
    "@hms/ui": "workspace:*",
    "@tanstack/react-form": "^1.25.0",
    "@tanstack/react-query": "^5.90.2",
    "next": "^16.2.10",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@hms/config": "workspace:*",
    "@tailwindcss/postcss": "^4.1.13",
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.11",
    "@types/react-dom": "^19.1.7",
    "eslint": "^9.34.0",
    "orval": "^8.1.0",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.1.13",
    "typescript": "^6.0.3"
  }
