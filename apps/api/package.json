{
  "name": "@hms/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "nest start --watch --builder swc",
    "build": "nest build --builder swc",
    "start": "node dist/main.js",
    "lint": "eslint \"src/**/*.ts\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "format": "prettier --check .",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:validate": "prisma validate",
    "prisma:seed": "prisma db seed",
    "prisma:migrate:reset": "prisma migrate reset"
  },
  "dependencies": {
    "@casl/ability": "^6.7.3",
    "@hms/shared-types": "workspace:*",
    "@nestjs/common": "^11.1.8",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.8",
    "@nestjs/jwt": "^11.0.1",
    "@nestjs/platform-express": "^11.1.8",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "bcryptjs": "^3.0.2",
    "nestjs-zod": "^5.4.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@hms/config": "workspace:*",
    "@nestjs/cli": "^11.0.10",
    "@swc/cli": "^0.7.8",
    "@swc/core": "^1.13.5",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.20.0",
    "@types/pg": "^8.15.6",
    "eslint": "^9.34.0",
    "pg": "^8.22.0",
    "prettier": "^3.6.2",
    "prisma": "^7.8.0",
    "typescript": "^6.0.3"
  }
}
