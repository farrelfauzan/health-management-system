DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hms_dev?schema=public"
JWT_ACCESS_SECRET="replace-with-strong-secret"
JWT_REFRESH_SECRET="replace-with-strong-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
S3_REGION="us-east-1"
S3_BUCKET="hms-dev-objects"
S3_ENDPOINT=""
S3_FORCE_PATH_STYLE="false"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_REQUEST_TIMEOUT_MS="10000"
S3_SIGNED_URL_EXPIRES_IN_SECONDS="300"
S3_MAX_UPLOAD_SIZE_BYTES="5242880"
S3_ALLOWED_MIME_TYPES="image/jpeg,image/png,image/webp,application/pdf"
CLINIC_TIMEZONE="Asia/Jakarta"
# Patient identifier encryption (P7-T01). Both must be distinct 32-byte secrets,
# base64 or hex encoded, and distinct from each other. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Losing PATIENT_PII_ENCRYPTION_KEY is unrecoverable data loss; rotating
# PATIENT_PII_INDEX_KEY requires a full decrypt-and-rehash backfill, so choose
# it once and rotate only on compromise.
PATIENT_PII_ENCRYPTION_KEY=""
PATIENT_PII_INDEX_KEY=""
PATIENT_PII_KEY_VERSION="1"
# Medical record number format (P7-T06). Server-generated, zero-padded, with an
# optional facility prefix (uppercase letters, digits and hyphens only). Front
# desk staff read these aloud and write them on physical folders, so keep them
# short. Both are baked into every number already allocated — decide before the
# first patient exists, because changing them later means live records in two
# formats and no way to renumber folders already printed.
PATIENT_MRN_PREFIX=""
PATIENT_MRN_WIDTH="8"
# SATUSEHAT platform adapter (P10-T01). Credentials are issued per facility by
# Kemenkes (satusehat.kemkes.go.id); all three must be set together, or all
# omitted — then the API boots normally and SATUSEHAT calls fail with
# SATUSEHAT_NOT_CONFIGURED. URL defaults point at the public staging sandbox;
# override both for production (api-satusehat.dto.kemkes.go.id). Never commit
# real credentials.
SATUSEHAT_FHIR_BASE_URL="https://api-satusehat-stg.dto.kemkes.go.id/fhir-r4/v1"
SATUSEHAT_AUTH_BASE_URL="https://api-satusehat-stg.dto.kemkes.go.id/oauth2/v1"
SATUSEHAT_ORGANIZATION_ID=""
SATUSEHAT_CLIENT_ID=""
SATUSEHAT_CLIENT_SECRET=""
# The facility's registered Location resource on the platform (P10-T03) —
# created once during SATUSEHAT onboarding, required for Encounter submission.
# The name is display-only.
SATUSEHAT_LOCATION_ID=""
SATUSEHAT_LOCATION_NAME=""
SATUSEHAT_REQUEST_TIMEOUT_MS="30000"
SATUSEHAT_MAX_RETRY_ATTEMPTS="2"
SATUSEHAT_RETRY_BASE_DELAY_MS="250"
SATUSEHAT_CIRCUIT_BREAKER_FAILURE_THRESHOLD="5"
SATUSEHAT_CIRCUIT_BREAKER_OPEN_DURATION_MS="30000"
# Submission outbox worker (P10-T04). The worker only starts when the adapter
# credentials above are configured AND the flag is "true"; each closed
# encounter's bundle is retried with exponential backoff (base delay doubling
# per attempt) until the attempt cap, then parked FAILED for admin retry.
SATUSEHAT_WORKER_ENABLED="true"
SATUSEHAT_WORKER_POLL_INTERVAL_MS="15000"
SATUSEHAT_SUBMISSION_MAX_ATTEMPTS="8"
SATUSEHAT_SUBMISSION_RETRY_BASE_DELAY_MS="60000"
# BPJS PCare adapter (P11-T02). Base URLs and resilience only — the facility's
# credentials (consId, secretKey, userKey, PCare login) are stored encrypted in
# the database via Settings -> Integrasi BPJS, never in the environment. The
# encryption key must be a 32-byte secret (base64 or hex), distinct from the
# PATIENT_PII keys; without it the API boots normally but storing or using BPJS
# credentials fails with BPJS_PCARE_NOT_CONFIGURED. Losing it is recoverable:
# re-enter the credentials from the BPJS issuance letter (runbook 5.3).
BPJS_CREDENTIAL_ENCRYPTION_KEY=""
BPJS_CREDENTIAL_KEY_VERSION="1"
# The development host has varied across BPJS issuance eras (ADR D-022) —
# confirm it against the facility's credential issuance letter and override
# when it differs. The production default is the documented PCare REST v3.0
# base.
BPJS_PCARE_DEVELOPMENT_BASE_URL="https://apijkn-dev.bpjs-kesehatan.go.id/pcare-rest-dev"
BPJS_PCARE_PRODUCTION_BASE_URL="https://new-api.bpjs-kesehatan.go.id/pcare-rest-v3.0"
BPJS_PCARE_REQUEST_TIMEOUT_MS="30000"
BPJS_PCARE_MAX_RETRY_ATTEMPTS="2"
BPJS_PCARE_RETRY_BASE_DELAY_MS="250"
BPJS_PCARE_CIRCUIT_BREAKER_FAILURE_THRESHOLD="5"
BPJS_PCARE_CIRCUIT_BREAKER_OPEN_DURATION_MS="30000"
# AI chatbot provider credentials (P13-T03). The clinic's upstream API keys
# (OpenAI, DeepSeek, Anthropic, …) are stored encrypted in the database via
# the admin provider settings, never in the environment. The encryption key
# must be a 32-byte secret (base64 or hex), distinct from the BPJS and
# PATIENT_PII keys; without it the API boots normally but storing or using AI
# provider keys fails with AI_NOT_CONFIGURED. Losing it is recoverable:
# re-enter the API keys from the vendor dashboard.
AI_PROVIDER_ENCRYPTION_KEY=""
AI_PROVIDER_KEY_VERSION="1"
# AI provider adapter resilience (P13-T04). Per-call timeout and token budget
# are per-config database columns, not env; these govern every provider call.
# Retries apply only to unreachable-transport errors (never timeouts, never
# HTTP responses) because a chat user is waiting synchronously.
AI_PROVIDER_MAX_RETRY_ATTEMPTS="1"
AI_PROVIDER_RETRY_BASE_DELAY_MS="250"
AI_PROVIDER_CIRCUIT_BREAKER_FAILURE_THRESHOLD="5"
AI_PROVIDER_CIRCUIT_BREAKER_OPEN_DURATION_MS="30000"
# Optional platform fallback used only when no AiProviderConfig row exists
# (single-tenant dev). Kind and model are both required to activate it;
# multi-tenant production should configure providers per clinic instead.
AI_PLATFORM_PROVIDER_KIND=""
AI_PLATFORM_API_KEY=""
AI_PLATFORM_BASE_URL=""
AI_PLATFORM_MODEL=""
AI_PROVIDER_TIMEOUT_MS="30000"
