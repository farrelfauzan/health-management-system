DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hms_dev?schema=public"
# Required. The API refuses to start without these (SJ-5) — there is no
# compiled-in fallback, because a fallback turns a missing secret into a
# working deployment signed with a value published in this repository. With
# NODE_ENV=production they must also be >= 32 characters and must not be one
# of the known placeholders, this line included.
JWT_ACCESS_SECRET="replace-with-strong-secret"
# Retired signing keys, comma-separated, verify-only. Rotation without logging
# the clinic out: put the new key in JWT_ACCESS_SECRET, move the old one here,
# restart. Tokens already in circulation keep verifying. After one refresh-token
# lifetime (JWT_REFRESH_EXPIRES_IN) nothing signed with the old key can still be
# presented, so clear this and restart again. Full procedure in
# docs/security/secrets.md.
JWT_ACCESS_SECRET_PREVIOUS=""
# JWT_REFRESH_SECRET is gone as of SJ-6. Refresh tokens are opaque 256-bit
# random strings checked against a stored SHA-256, so nothing signs them and
# there is no key to rotate. Setting it does no harm; it is simply never read.
# Optional path to a full breached-password wordlist (SJ-7), one entry per
# line — a SecLists top-10k file, for example. Entries are merged with the
# curated list compiled into the API, never replacing it. Left unset, only the
# built-in list applies.
BREACHED_PASSWORD_LIST_PATH=""
# Deliberately a third of SESSION_IDLE_TIMEOUT_MINUTES (SJ-9): an active
# session only contacts the server when this expires, so a value equal to the
# idle window would time out sessions that are being used.
JWT_ACCESS_EXPIRES_IN="5m"
# Also the refresh-token lifetime, and therefore the Max-Age of the httpOnly
# refresh cookie.
JWT_REFRESH_EXPIRES_IN="7d"
# TOTP second factor for privileged accounts (SJ-8). A 32-byte secret (base64
# or hex), distinct from every other encryption key here. TOTP secrets are
# *encrypted* rather than hashed because the construction is symmetric — the
# server recomputes the same HMAC the phone does — so this key is what stands
# between a database disclosure and a working second factor.
#
# Required with NODE_ENV=production: the API refuses to boot without it.
# Unset elsewhere, MFA enrolment is unavailable and enforcement stays off, so
# development and CI need no key. Losing it is recoverable but disruptive —
# every enrolled user must re-scan a QR code, via MFA_RESET by an admin.
MFA_SECRET_ENCRYPTION_KEY=""
MFA_SECRET_KEY_VERSION="1"
# When enforcement starts biting, as an absolute ISO-8601 instant. Until then
# a privileged account with no second factor still gets tokens and the login
# response carries mfaEnrolmentRequired so the web app can nag; from then on
# login issues an enrolment ticket instead of tokens.
#
# Absolute rather than "N days per account" on purpose. A per-account window
# measured from when someone became privileged has already elapsed for every
# administrator who has been one for a year — so the first deploy would lock
# them all out with no warning at all, which is the opposite of a grace period.
# Leave it unset to enforce immediately (the right setting for a new clinic
# with no privileged accounts yet).
MFA_ENFORCEMENT_GRACE_UNTIL=""
# What the authenticator app lists the account under. Changing it after people
# have enrolled does not break their codes — it is a label, not an input to the
# HMAC — but their app keeps showing the old name until they re-enrol.
MFA_ISSUER_NAME="HMS Clinic"
# Shared-workstation session hygiene (SJ-9). How long a session may sit
# untouched before the server kills it — enforced on the refresh path, so a
# walked-away terminal is genuinely dead and not merely hidden behind a login
# screen the browser drew. Minimum 2; below that staff route around it.
#
# Keep JWT_ACCESS_EXPIRES_IN well under this. An active session only refreshes
# when its access token expires, so if the two are equal every working session
# times out at the boundary and the clinic sees random logouts. A third of the
# window is a good ratio — 15 minutes idle, 5 minute access token. The API
# warns at boot if you get this wrong.
SESSION_IDLE_TIMEOUT_MINUTES="15"
# Which origins may call this API with credentials (SJ-1). Comma-separated,
# exact origins including scheme and port. Replaces the old `origin: true`,
# which reflected whatever Origin arrived — with credentials on, that let any
# site a signed-in user visited call this API and read the replies.
#
# Behind the SJ-1 proxy the web app is same-origin, so this can stay empty in
# that topology; it exists for split-host deployments and for local work.
#
# Unset outside production it falls back to http://localhost:3000. Unset *in*
# production it allows nothing, on purpose: a misconfigured deployment should
# be visibly broken rather than invisibly permissive.
CORS_ALLOWED_ORIGINS=""
# Object storage. One adapter serves both providers; the difference is only
# these values.
#   AWS S3 (production): leave S3_ENDPOINT empty and S3_FORCE_PATH_STYLE
#     "false" so the SDK uses the region's real endpoint and virtual-host
#     bucket addressing. Leave the credentials empty on infrastructure that
#     has an instance/task role — empty (not blank-but-set) is what hands
#     resolution to the default AWS credential provider chain. Set both or
#     neither; a half-set pair is rejected at startup.
#   MinIO (local docker, `pnpm docker:dev:up`): S3_ENDPOINT
#     "http://localhost:9000", S3_FORCE_PATH_STYLE "true", and the dev
#     credentials from docker-compose.dev.yml.
S3_REGION="us-east-1"
S3_BUCKET="hms-dev-objects"
S3_ENDPOINT=""
S3_FORCE_PATH_STYLE="false"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# Opt-in gate for the storage round-trip in `pnpm integration:test`. Unset,
# that suite skips; set, it uploads and deletes fixtures in this bucket, so
# name a dedicated test bucket and never the one the app itself uses.
S3_INTEGRATION_TEST_BUCKET=""
S3_REQUEST_TIMEOUT_MS="10000"
S3_SIGNED_URL_EXPIRES_IN_SECONDS="300"
S3_MAX_UPLOAD_SIZE_BYTES="5242880"
# The bucket-wide allowlist. Each feature narrows it further for its own
# uploads: the document store (P15-T10) accepts only application/pdf,
# text/markdown, and text/plain, so widening this list never widens what may
# be uploaded as a clinic document. Image types are deliberately absent until
# an image-bearing feature ships with the sharp re-encode step SJ-21 requires
# (docs/security/file-uploads.md).
S3_ALLOWED_MIME_TYPES="application/pdf,text/markdown,text/plain"
CLINIC_TIMEZONE="Asia/Jakarta"
# How many proxy hops in front of the API may be trusted to have appended
# X-Forwarded-For. This decides `request.ip`, and therefore the client address
# recorded on every audit row (SJ-4). Leave at 0 until a TLS terminator is
# genuinely in front (SJ-1): with 0 the socket address decides and the header
# is ignored, so a caller cannot write a false origin into the audit log by
# setting a header they control. One hop too many hands them the first entry.
#
# Set to 1 when running behind SJ-1's Caddy proxy and nothing else. Add one per
# additional trusted hop — a cloud load balancer in front of Caddy makes it 2.
# Count the hops you control; never round up "to be safe", because each extra
# hop is one more entry of the header the client itself supplied.
TRUSTED_PROXY_HOPS="0"
# Patient identifier encryption (P7-T01). Both must be distinct 32-byte secrets,
# base64 or hex encoded, and distinct from each other. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Losing PATIENT_PII_ENCRYPTION_KEY is unrecoverable data loss; rotating
# PATIENT_PII_INDEX_KEY requires a full decrypt-and-rehash backfill, so choose
# it once and rotate only on compromise.
PATIENT_PII_ENCRYPTION_KEY=""
PATIENT_PII_INDEX_KEY=""
PATIENT_PII_KEY_VERSION="1"
# Medical record number format (P7-T06). Server-generated, zero-padded, with an
# optional facility prefix (uppercase letters, digits and hyphens only). Front
# desk staff read these aloud and write them on physical folders, so keep them
# short. Both are baked into every number already allocated — decide before the
# first patient exists, because changing them later means live records in two
# formats and no way to renumber folders already printed.
PATIENT_MRN_PREFIX=""
PATIENT_MRN_WIDTH="8"
# SATUSEHAT platform adapter (P10-T01). Credentials are issued per facility by
# Kemenkes (satusehat.kemkes.go.id); all three must be set together, or all
# omitted — then the API boots normally and SATUSEHAT calls fail with
# SATUSEHAT_NOT_CONFIGURED. URL defaults point at the public staging sandbox;
# override both for production (api-satusehat.dto.kemkes.go.id). Never commit
# real credentials.
SATUSEHAT_FHIR_BASE_URL="https://api-satusehat-stg.dto.kemkes.go.id/fhir-r4/v1"
SATUSEHAT_AUTH_BASE_URL="https://api-satusehat-stg.dto.kemkes.go.id/oauth2/v1"
SATUSEHAT_ORGANIZATION_ID=""
SATUSEHAT_CLIENT_ID=""
SATUSEHAT_CLIENT_SECRET=""
# The facility's registered Location resource on the platform (P10-T03) —
# created once during SATUSEHAT onboarding, required for Encounter submission.
# The name is display-only.
SATUSEHAT_LOCATION_ID=""
SATUSEHAT_LOCATION_NAME=""
SATUSEHAT_REQUEST_TIMEOUT_MS="30000"
SATUSEHAT_MAX_RETRY_ATTEMPTS="2"
SATUSEHAT_RETRY_BASE_DELAY_MS="250"
SATUSEHAT_CIRCUIT_BREAKER_FAILURE_THRESHOLD="5"
SATUSEHAT_CIRCUIT_BREAKER_OPEN_DURATION_MS="30000"
# Submission outbox worker (P10-T04). The worker only starts when the adapter
# credentials above are configured AND the flag is "true"; each closed
# encounter's bundle is retried with exponential backoff (base delay doubling
# per attempt) until the attempt cap, then parked FAILED for admin retry.
SATUSEHAT_WORKER_ENABLED="true"
SATUSEHAT_WORKER_POLL_INTERVAL_MS="15000"
SATUSEHAT_SUBMISSION_MAX_ATTEMPTS="8"
SATUSEHAT_SUBMISSION_RETRY_BASE_DELAY_MS="60000"
# How long a claimed outbox row stays invisible to other workers (SJ-76). Rows
# are claimed with FOR UPDATE SKIP LOCKED under this lease, so running more than
# one API instance divides the queue instead of double-submitting. Must exceed
# the worst case for one batch of five rows processed sequentially; a crashed
# worker's rows return to the queue when the lease lapses.
SATUSEHAT_SUBMISSION_LEASE_MS="900000"
# BPJS PCare adapter (P11-T02). Base URLs and resilience only — the facility's
# credentials (consId, secretKey, userKey, PCare login) are stored encrypted in
# the database via Settings -> Integrasi BPJS, never in the environment. The
# encryption key must be a 32-byte secret (base64 or hex), distinct from the
# PATIENT_PII keys; without it the API boots normally but storing or using BPJS
# credentials fails with BPJS_PCARE_NOT_CONFIGURED. Losing it is recoverable:
# re-enter the credentials from the BPJS issuance letter (runbook 5.3).
BPJS_CREDENTIAL_ENCRYPTION_KEY=""
BPJS_CREDENTIAL_KEY_VERSION="1"
# The development host has varied across BPJS issuance eras (ADR D-022) —
# confirm it against the facility's credential issuance letter and override
# when it differs. The production default is the documented PCare REST v3.0
# base.
BPJS_PCARE_DEVELOPMENT_BASE_URL="https://apijkn-dev.bpjs-kesehatan.go.id/pcare-rest-dev"
BPJS_PCARE_PRODUCTION_BASE_URL="https://new-api.bpjs-kesehatan.go.id/pcare-rest-v3.0"
BPJS_PCARE_REQUEST_TIMEOUT_MS="30000"
BPJS_PCARE_MAX_RETRY_ATTEMPTS="2"
BPJS_PCARE_RETRY_BASE_DELAY_MS="250"
BPJS_PCARE_CIRCUIT_BREAKER_FAILURE_THRESHOLD="5"
BPJS_PCARE_CIRCUIT_BREAKER_OPEN_DURATION_MS="30000"
# BPJS Antrean Online adapter (P14-T03). Hosts and resilience only — the
# Antrean service's own consId/secretKey/userKey are a separate credential set
# from PCare's, issued and revoked separately, and are stored encrypted in the
# database via Settings -> Integrasi BPJS -> BPJS Antrean. They share
# BPJS_CREDENTIAL_ENCRYPTION_KEY above, so one rotation runbook covers both.
# Both defaults below are the P14 evaluation's working assumption and have
# never been confirmed against an issued credential set (spike questions Q2 and
# Q11, docs/post-mvp/bpjs-antrean-spike.md) — override them with whatever the
# branch office actually issues. Resilience knobs default to the same values as
# PCare's when unset; only set them to diverge.
BPJS_ANTREAN_DEVELOPMENT_BASE_URL="https://apijkn-dev.bpjs-kesehatan.go.id/antreanfktp_dev"
BPJS_ANTREAN_PRODUCTION_BASE_URL="https://apijkn.bpjs-kesehatan.go.id/antreanfktp"
# AI chatbot provider credentials (P13-T03). The clinic's upstream API keys
# (OpenAI, DeepSeek, Anthropic, …) are stored encrypted in the database via
# the admin provider settings, never in the environment. The encryption key
# must be a 32-byte secret (base64 or hex), distinct from the BPJS and
# PATIENT_PII keys; without it the API boots normally but storing or using AI
# provider keys fails with AI_NOT_CONFIGURED. Losing it is recoverable:
# re-enter the API keys from the vendor dashboard.
AI_PROVIDER_ENCRYPTION_KEY=""
AI_PROVIDER_KEY_VERSION="1"
# AI provider adapter resilience (P13-T04). Per-call timeout and token budget
# are per-config database columns, not env; these govern every provider call.
# Retries apply only to unreachable-transport errors (never timeouts, never
# HTTP responses) because a chat user is waiting synchronously.
AI_PROVIDER_MAX_RETRY_ATTEMPTS="1"
AI_PROVIDER_RETRY_BASE_DELAY_MS="250"
AI_PROVIDER_CIRCUIT_BREAKER_FAILURE_THRESHOLD="5"
AI_PROVIDER_CIRCUIT_BREAKER_OPEN_DURATION_MS="30000"
# Optional platform fallback used only when no AiProviderConfig row exists
# (single-tenant dev). Kind and model are both required to activate it;
# multi-tenant production should configure providers per clinic instead.
AI_PLATFORM_PROVIDER_KIND=""
AI_PLATFORM_API_KEY=""
AI_PLATFORM_BASE_URL=""
AI_PLATFORM_MODEL=""
AI_PROVIDER_TIMEOUT_MS="30000"
# Chat feature flag (P13-T05), default off until Phase 13 is complete. Only
# starting a session and sending a message are gated — reading an existing
# transcript keeps working after a clinic pauses AI.
AI_CHAT_ENABLED="false"
# Redacted clinical context enrichment (P13-T06), default off. The delivery
# plan gates this on verified SATUSEHAT master-data linkage: with it off the
# chatbot answers from the conversation alone and sends the provider no
# patient data at all. With it on, only the fields ai-chatbot.md §5.3 allows
# are sent — display name, next appointment summary, queue number, counts —
# and each exchange records exactly what was sent as a SYSTEM turn.
AI_CHAT_CONTEXT_ENRICHMENT_ENABLED="false"
# Tool dispatch (P15-T05), default off — gates the tool track as a whole. Off
# means no tool is registered, so no `tools` field is sent and the request
# body is byte-identical to Phase 13. On, the assistant may run the read-only
# lookups the caller's own permissions already open (the two pharmacy tools
# today), executed as that user and returned to the client — results are not
# sent back to the provider unless AI_CHAT_TOOL_RESULT_TO_PROVIDER is on,
# which is a separate flag with its own legal preconditions (P15-T07).
AI_CHAT_TOOLS_ENABLED="false"
# Hybrid retrieval over the clinic document corpus (P15-T11), default off.
# Off means no corpus is queried at all, no SYSTEM turn is written, and the
# completion body is the Phase 13 one. On, each message retrieves passages
# before the completion — one round trip, not a tool the model asks for —
# scoped to the clinic corpus the channel may see plus the asking user's own
# knowledge base, and the reply comes back with citations in meta. Needs an
# ingested corpus and a reachable embedder — whichever EMBEDDING_PROVIDER
# names, hosted Together by default; with neither, retrieval finds nothing and
# the assistant answers as it does today. Note the question itself is embedded
# on every retrieval, so with the hosted default it reaches that vendor even
# though the enrichment and tool payloads are behind their own flags (SJ-17).
AI_CHAT_RETRIEVAL_ENABLED="false"
# Chat abuse limits (P13-T07). Messages are counted per user across all their
# sessions, so opening a second conversation does not buy a fresh budget, and
# the session quota counts soft-deleted sessions so a DELETE does not reset
# it. Emergency messages bypass both — a quota is an anti-abuse measure, not
# a reason to withhold the ambulance number.
AI_CHAT_RATE_LIMIT_PER_HOUR="60"
AI_CHAT_MAX_SESSIONS_PER_DAY="20"

# --- BPJS Antrean inbound web services (P14-T04) ---
#
# THIS EMPTY LIST IS THE OFF SWITCH. The inbound surface BPJS calls is a
# public write path into bookings and patient master data. While no range is
# listed, every request to /api/v1/bpjs/antrean/ws/* is refused before it is
# parsed and before any domain service is reached — which is the state every
# deployment should be in until a clinic is genuinely onboarded.
#
# Fill it only with the source ranges BPJS's branch office publishes for the
# facility (spike question Q6). Comma-separated addresses or CIDR ranges,
# IPv4 or IPv6. A malformed entry fails startup rather than being skipped: an
# allowlist that silently drops what it could not parse is one nobody knows
# the contents of. The surface also needs the inbound credential pair stored
# on BpjsAntreanConfig (agreed at UAT) — the allowlist alone is not enough.
BPJS_ANTREAN_INBOUND_ALLOWED_IPS=""
# How many proxy hops in front of the API may be trusted to have appended
# X-Forwarded-For. Leave at 0 unless something genuinely rewrites the header:
# with 0 the socket address decides and the header is ignored entirely, so a
# caller cannot claim to be BPJS by setting a header they control.
BPJS_ANTREAN_INBOUND_TRUSTED_PROXY_HOPS="0"
# Lifetime of an issued inbound token. Rotation of the inbound password is
# what revokes outstanding tokens; there is no token table to purge.
BPJS_ANTREAN_INBOUND_TOKEN_TTL_SECONDS="3600"
# Per-minute budgets, counted per (endpoint, source address) in process. A
# zero means the endpoint is closed, not unlimited. Multi-replica deployments
# should enforce the real ceiling in front of the API.
BPJS_ANTREAN_INBOUND_READ_RPM="120"
BPJS_ANTREAN_INBOUND_WRITE_RPM="30"
BPJS_ANTREAN_INBOUND_TOKEN_RPM="10"
# Minutes per patient used to estimate `estimasidilayani` (evaluation §3.6).
# HMS measures nothing about consultation duration yet, so this is an honest
# configured constant rather than a computed figure.
BPJS_ANTREAN_AVERAGE_SERVICE_MINUTES="15"

# --- BPJS protocol capture (P14-T06) ---
#
# A UAT INSTRUMENT, NOT TELEMETRY. Leave unset in production.
#
# When set to a directory path, every BPJS exchange — outbound PCare and
# Antrean calls, and the inbound Antrean calls BPJS makes into the facility —
# is appended as redacted NDJSON. This is how P14-T02's fixtures become
# evidence recorded from real responses rather than a restatement of what HMS
# already believes the protocol to be.
#
# Redaction removes credentials, signatures and the inbound token, and
# replaces member identifiers with structurally valid synthetic values before
# anything reaches disk. `X-Timestamp` is deliberately kept: the response AES
# key derives from it, and a fixture without it cannot be decoded again.
#
# The API logs a warning at every boot while this is on. Unset it and restart
# as soon as the UAT session ends — see docs/post-mvp/bpjs-antrean-uat.md §4.
BPJS_PROTOCOL_CAPTURE_DIR=""

# --- Document store ingestion (P15-T10) ---
#
# The extract → chunk → embed pipeline behind the shared document store.
# Default OFF: with the flag off nothing polls, uploaded knowledge-base
# documents rest at ingestStatus PENDING, and a deployment with no reachable
# embedding host boots without a background loop failing on a timer.
DOCUMENT_INGESTION_ENABLED="false"
DOCUMENT_INGESTION_POLL_INTERVAL_MS="15000"
DOCUMENT_INGESTION_POLL_BATCH_LIMIT="3"
# Chunk sizes are characters, not tokens — roughly four characters per token
# for both Indonesian and English. The overlap must be smaller than the chunk
# size or the pipeline refuses to start.
DOCUMENT_INGESTION_MAX_CHUNK_CHARACTERS="2000"
DOCUMENT_INGESTION_CHUNK_OVERLAP_CHARACTERS="200"
# A ceiling, not a target: one uploaded book must not become ten thousand
# embedding calls. Documents past the cap are truncated and the API logs it.
DOCUMENT_INGESTION_MAX_CHUNKS_PER_DOCUMENT="400"

# --- Document retrieval tuning (P15-T11) ---
#
# There is no enable flag here: retrieval mechanics belong to the document
# store, but whether a chat exchange uses them is AI_CHAT_RETRIEVAL_ENABLED.
# CANDIDATE_LIMIT is per half of the hybrid (vector and full-text) before
# fusion; MAX_PASSAGES is what survives fusion and reaches the provider, so it
# is what bounds the prompt and must not exceed the candidate limit.
DOCUMENT_RETRIEVAL_CANDIDATE_LIMIT="20"
DOCUMENT_RETRIEVAL_MAX_PASSAGES="5"
# Reciprocal rank fusion's constant, conventionally 60. Raising it flattens
# the two halves toward equal influence; lowering it lets a single half's
# first result dominate.
DOCUMENT_RETRIEVAL_RANK_CONSTANT="60"
# Passages shorter than this are dropped after fusion: a stray heading or page
# number ranks fine lexically, grounds nothing, and spends prompt budget a
# real passage could have used.
DOCUMENT_RETRIEVAL_MIN_PASSAGE_CHARACTERS="40"

# --- Embeddings (P15-T10, provider switch at PCS-T12) ---
#
# Which backend embeds the corpus: TOGETHER (hosted, the default) or OLLAMA
# (local). Read once at startup, and an unrecognised value THROWS rather than
# falling back — unlike WA_GATEWAY_KIND, because picking the wrong WhatsApp
# bridge still delivers the message whereas picking the wrong embedder
# silently decides which company sees the clinic's documents.
#
# ⚠️ Switching this changes the vector space. Retrieval filters on the model
# and version stamped on each chunk, so the failure mode is ZERO RESULTS
# rather than wrong ones — a safe failure, but it means a full re-ingest of
# every document is required after a switch. It is not a schema migration:
# both defaults below are 1024-wide, matching the `vector(1024)` column.
#
# ⚠️ D-EMB-01: TOGETHER makes the embedder a DATA PROCESSOR. Every ingested
# chunk and every retrieval query crosses to a third party. What is embedded
# is the CLINIC FAQ corpus and DOCTOR/ADMIN personal knowledge bases; patient
# documents are GENERAL and are never embedded, so no patient record text
# crosses — but staff knowledge-base text and question text do. Add the
# processor to the clinic's UU PDP register before enabling this in
# production. OLLAMA remains fully supported for a deployment that will not.
EMBEDDING_PROVIDER="TOGETHER"

# --- Hosted embeddings: Together AI (PCS-T12) ---
#
# The OpenAI-compatible /v1/embeddings surface. Empty key is safe at boot: the
# adapter refuses to embed with an actionable message rather than failing to
# start, because an API whose operator has not finished configuring embeddings
# must still serve every route that does not need one.
TOGETHER_API_KEY=""
TOGETHER_EMBEDDING_BASE_URL="https://api.together.xyz"
# 1024 dimensions AND genuinely multilingual — the pair is the requirement.
# The width keeps the `vector(1024)` column, and the multilinguality keeps the
# cross-lingual ID↔EN retrieval that chose bge-m3 at PCS-T02. Together's
# English-only embedders (BAAI/bge-large-en-v1.5 and friends) fit the column
# and would give that up without any error at all.
TOGETHER_EMBEDDING_MODEL="intfloat/multilingual-e5-large-instruct"
TOGETHER_EMBEDDING_DIMENSION="1024"
TOGETHER_EMBEDDING_VERSION="1"
TOGETHER_EMBEDDING_TIMEOUT_MS="30000"
TOGETHER_EMBEDDING_BATCH_SIZE="16"
# Retries AFTER the first attempt, so 2 means at most three requests. Only 429
# and 5xx are retried; a 400 or 401 answers identically however many times it
# is asked. 0 is a legal value meaning "try once". A hosted embedder has a
# rate limit that a local one did not, which is the whole reason this exists.
TOGETHER_EMBEDDING_MAX_RETRIES="2"
# Ceiling on any single wait, including one the provider's x-ratelimit-reset
# header asks for. Honouring that header beats guessing, but unclamped it
# could hold an ingestion worker open for as long as the provider likes.
TOGETHER_EMBEDDING_MAX_RETRY_DELAY_MS="10000"

# --- Local embeddings: Ollama (P15-T10) ---
#
# Used when EMBEDDING_PROVIDER=OLLAMA. Local means no second data processor to
# account for under UU PDP — the reason this was the original default. In
# Docker the host must be host.docker.internal, not localhost.
OLLAMA_EMBEDDING_BASE_URL="http://127.0.0.1:11434"
OLLAMA_EMBEDDING_MODEL="bge-m3"
# The vector width is fixed by the model AND by the `vector(1024)` column, so
# changing the model is a migration plus a full re-ingest, never a config
# edit. Every response is checked against this width and refused if it
# differs — otherwise Postgres stores the row and retrieval just gets worse.
OLLAMA_EMBEDDING_DIMENSION="1024"
# Bump when the model changes in a way its name does not express (a re-pulled
# tag, a different quantization). Stamped on every chunk beside the model
# name, which is what makes a mixed corpus detectable instead of suspected.
OLLAMA_EMBEDDING_VERSION="1"
OLLAMA_EMBEDDING_TIMEOUT_MS="30000"
OLLAMA_EMBEDDING_BATCH_SIZE="16"
# Opt-in gate for the end-to-end ingestion suite in `pnpm integration:test`
# (PCS-T02), which puts a real markdown file and a real PDF in the bucket and
# asks a question at the other end. It needs S3_INTEGRATION_TEST_BUCKET too,
# and skips unless both are set. A dedicated variable rather than reusing
# OLLAMA_EMBEDDING_BASE_URL above, which has a default: keying off a value
# that is always present would make "no embedding host configured for tests"
# indistinguishable from "the default happens to be right", and the suite
# would fail rather than skip on every machine without a pulled model.
EMBEDDING_INTEGRATION_TEST_BASE_URL=""

# --- Customer-service channel: WhatsApp / Telegram (PCS-T05) ---
#
# Master switch, default off. With it off the webhooks still exist and still
# authenticate — they answer DISABLED and do no work. Registering the routes
# conditionally instead would 404 them, and a 404 tells Telegram the webhook
# is gone, which is a different and much harder thing to diagnose than
# "configured but paused".
CS_CHANNEL_ENABLED="false"
# From @BotFather. Empty is safe: the adapter refuses to send rather than
# failing at boot, because a clinic not running this channel must still be
# able to start its API.
TELEGRAM_BOT_TOKEN=""
# The `secret_token` passed to setWebhook, which Telegram echoes in the
# X-Telegram-Bot-Api-Secret-Token header on every delivery. This is the only
# authentication in front of a public endpoint, so an EMPTY value closes the
# webhook rather than opening it — every request is refused, including one
# carrying an empty header, which would otherwise compare equal and let the
# check pass by accident.
#   Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#   Register with:
#   curl -F "url=https://<host>/api/v1/channels/telegram/webhook" \
#        -F "secret_token=<the value above>" \
#        "https://api.telegram.org/bot<TELEGRAM_BOT_TOKEN>/setWebhook"
TELEGRAM_WEBHOOK_SECRET=""
# The deployment's own public host — the same value the reverse proxy matches
# on, so the API and the proxy cannot disagree about what this deployment is
# called. Set it and the integrations screen can register the webhook itself;
# leave it empty and that button reports "no domain configured" rather than
# guessing.
#
# The API only ever *derives* the webhook URL from this — it is never accepted
# from a request. A URL that came from a form would make the register button a
# way to point the clinic's bot traffic at any host on the internet.
#
# A bare host is expected (`klinik.example.id`); a scheme, trailing slash or
# path is normalised away. https is always used: Telegram will not deliver to
# a plain-http webhook.
#
# **One bot token has exactly one webhook, globally — not one per
# environment.** Staging and production must therefore use different bots from
# @BotFather; sharing a token means whichever registers last silently takes
# the other's traffic. The integrations card surfaces this as "registered to a
# different deployment".
HMS_DOMAIN=""
# --- WhatsApp bridge (PCS-T09, §2.1, §8.1) ---
#
# GOWA is the pragmatic v1, WAHA the tested fallback (PCS-T10), the official
# Cloud API the endgame. Both current values pick a provider binding behind one
# port, so switching is configuration rather than a redesign.
# Only one bridge may hold the clinic's number at a time, and this must agree
# with whichever container is running: it selects both the outbound adapter and
# the shape the inbound webhook body is read as. Switching it is the whole of
# D-CS-01's failover — no business-logic file changes, and conversations
# survive, because both bridges' chat ids canonicalise to one stored form.
WA_GATEWAY_KIND="GOWA"
# The bridge's REST base URL. **This must never be publicly resolvable.**
# Anyone who can reach it can send as the clinic and read its session, so it
# names a container on the API's own private network and its port is not
# published to the host. Empty means no WhatsApp gateway is configured; the
# adapter then refuses to send rather than failing at boot.
WA_GATEWAY_BASE_URL=""
# GOWA's APP_BASIC_AUTH pair, split here because they are two secrets. The
# second lock on the same door as the private network: a misconfigured network
# should not be the only thing between the internet and a live WhatsApp
# session.
WA_GATEWAY_BASIC_AUTH_USERNAME=""
WA_GATEWAY_BASIC_AUTH_PASSWORD=""
# WAHA's X-Api-Key, and its session name. A separate variable from the basic
# auth pair above rather than one credential field serving both bridges: they
# are different secrets, and a shared field would make a failover a
# find-and-replace inside a value. WAHA is multi-session by design where GOWA
# is multi-device; one clinic uses one session.
WA_GATEWAY_API_KEY=""
WA_GATEWAY_SESSION_NAME="default"
# The HMAC-SHA256 key the bridge signs every webhook body with. GOWA echoes it
# in X-Hub-Signature-256 and WAHA in X-Webhook-Hmac; the guard reads either, so
# one secret serves both and a failover does not need a new one. Same rule as
# the Telegram secret: an EMPTY value CLOSES the webhook rather than opening it,
# because an unset secret must never mean "accept anything".
#   Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WA_GATEWAY_WEBHOOK_SECRET=""
# The clinic's own WhatsApp JID, e.g. 628123456789@s.whatsapp.net. GOWA scopes
# its device-management calls by it. Note this is the account doing the
# *sending* — §5.1.1 tier 1 compares the customer's sender JID against the
# patient's registered number, never against this.
WA_GATEWAY_DEVICE_ID=""
# Milliseconds held between consecutive outbound sends (§2.1's ban
# mitigations). Human-like pacing is a named mitigation, and it is a number so
# a clinic warming a brand-new number can slow it further without a code
# change. See docs/ops/whatsapp-number-warmup.md.
WA_GATEWAY_SEND_PACING_MS="1000"
# Conversational layer (PCS-T06). Named in the system prompt only, so a
# generic fallback is used rather than failing to boot over a display name.
CS_CLINIC_NAME=""
# The replay window (§6). Bounded for cost, not quality: a WhatsApp
# conversation has no natural end, so an unbounded replay would make the
# hundredth message cost a hundred messages' worth of tokens to answer.
CS_HISTORY_TURN_LIMIT="20"
# Per-chat inbound limit (§8.3). Over-limit gets a polite template and costs
# no provider call.
CS_RATE_LIMIT_PER_CHAT_HOUR="20"
# §8.3's clinic-wide daily LLM budget, in provider calls (PCS-T11). A second
# cap alongside the per-chat one and not redundant: that limit bounds what one
# customer costs and does nothing about a hundred chats, which on a public
# channel costs nothing to arrange. This is the one that bounds the bill.
#
# Counted in calls, not tokens: tokens are the true unit but are only known
# after a provider answers, so a token budget can only ever stop the call
# *after* the one that broke it. Reaching this should be an incident somebody
# investigates, not a number a busy Tuesday bumps into.
CS_MAX_LLM_CALLS_PER_DAY="2000"
# Booking and verification (PCS-T07, §5.1.1 and §8.3).
#
# A possession challenge holds a booking open while the customer proves they
# hold the number they typed. On Telegram that is a one-tap contact share; the
# code tier below needs a transport to the *registered* number, which Telegram
# is not — PCS-T09 binds the WhatsApp gateway for it. Until then every code
# path falls through to a draft booking, which is a specified outcome and not a
# failure: nobody hits a dead end, and the front desk reconciles at arrival.
CS_OTP_TTL_SECONDS="300"
CS_OTP_MAX_ATTEMPTS="3"
# Repeated challenges against one chat are what enumeration looks like. Hitting
# this stops *challenging*, not booking.
CS_OTP_MAX_CHALLENGES_PER_DAY="3"
# How many *distinct chats* may fail a challenge against one patient record in
# a day before the conversation is flagged for admin review (PCS-T11, §8.3).
# The quota above bounds one conversation; opening a second chat resets it for
# free, so this is the count that makes walking the registry visible.
#
# A flag, not a block: the same shape is produced by a family sharing one
# registered number. Blocking would refuse three legitimate bookings; flagging
# puts a person in front of it, which is what tells the two cases apart.
CS_ENUMERATION_CHAT_THRESHOLD="3"
# How long a proven verification is trusted before the chat is challenged
# again. A verification is evidence about a moment, not a permanent fact:
# numbers get reassigned and phones get sold.
CS_LINK_REVERIFY_DAYS="180"
# Counted across every patient record the number resolves to, drafts included —
# a customer booking under three spellings of their name creates three drafts,
# and a cap that saw one at a time would not be a cap.
CS_MAX_ACTIVE_BOOKINGS_PER_PHONE="3"
# Clinic-wide, not per chat: a per-chat limit costs nothing to evade on a
# channel where opening a second chat is free. Reaching it is logged, because
# it stops everybody's bookings and an operator must see it rather than infer
# it from a quiet afternoon.
CS_MAX_DRAFT_BOOKINGS_PER_DAY="50"

# --- Outbound mail (IMP-23) ---------------------------------------------------
# Provider-neutral SMTP over nodemailer: the same six variables point the API at
# Brevo, Postmark, Mailtrap, SES's SMTP endpoint, or a Gmail app password, so
# choosing a vendor stays a deployment decision instead of a code change.
#
# Leave MAIL_HOST empty and the API selects the *log* transport — invitation
# emails are written to the application log, link included, so a fresh checkout
# can walk the accept flow with no mail account. Setting MAIL_HOST is the same
# act that makes sending possible at all, which is why it is what selects SMTP;
# MAIL_TRANSPORT overrides that inference when you want it explicit.
MAIL_TRANSPORT=""
MAIL_HOST=""
MAIL_PORT="587"
# Implicit TLS on connect (SMTPS, conventionally port 465). Left unset it is
# inferred from MAIL_PORT. On 587 leave it false — the transport still upgrades
# with STARTTLS, which is what every provider on that port expects.
MAIL_SECURE=""
# Set together or not at all. A user with no password authenticates as nobody
# and produces a provider-side rejection that reads like a network fault, so
# the API refuses to boot on a half-filled pair instead.
MAIL_USER=""
MAIL_PASSWORD=""
# The envelope From. Must be an address the provider has authorised for your
# domain, or every message is silently dropped or filed as spam.
MAIL_FROM="Saling Jaga <no-reply@localhost>"
MAIL_CONNECTION_TIMEOUT_MS="10000"

# --- Staff invitations (IMP-23) -----------------------------------------------
# The *web* origin invitation links point at — the link lands on a Next.js page
# that then calls the API, so it cannot be derived from the request that created
# the invitation. A missing scheme or a trailing slash is normalised away.
WEB_APP_BASE_URL="http://localhost:3000"
# How long an invitation link lives. Long enough to survive a weekend and a
# missed inbox, short enough that a link forwarded, archived, or left in a
# mailbox that later changes hands is dead before it is interesting. Capped at
# 336 (14 days); anything larger or unparseable falls back to 72.
USER_INVITATION_TTL_HOURS="72"
