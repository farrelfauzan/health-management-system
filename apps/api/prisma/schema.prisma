generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum PermissionScope {
  ANY
  OWN
}

enum DoctorPatientActivityAction {
  ASSIGNED
  UNASSIGNED
}

enum AuditAction {
  /// Generic data-access verbs (SJ-4). Everything below them names a specific
  /// business event; these five name what was done to patient-identifiable
  /// data, and are what the `@Audited()` interceptor writes. READ is in the
  /// list because the regulatory question is "who looked", not "who changed".
  READ
  CREATE
  UPDATE
  DELETE
  EXPORT
  USER_LOGIN
  USER_LOGIN_FAILED
  TOKEN_REFRESHED
  /// A refresh token was presented after it had already been exchanged, or
  /// after its family was killed (SJ-6). Either the token was stolen or the
  /// legitimate client replayed one — the family dies for both, and this row
  /// is how anyone finds out which it was.
  TOKEN_REUSE
  /// Every session for one user was revoked at once — a password change, an
  /// admin action, or the user signing out everywhere.
  SESSION_REVOKED_ALL
  /// A session died because nobody touched it (SJ-9). Distinct from
  /// `USER_LOGOUT` because the two answer different questions after the fact:
  /// one says somebody left deliberately, the other says a clinic terminal sat
  /// unattended with a session open — which is a workflow problem worth
  /// counting, not just an auth event.
  SESSION_TIMEOUT
  /// Someone handed the workstation over on purpose, ending their session in
  /// one action. Counted separately from an ordinary logout so "are staff
  /// actually locking terminals" is answerable.
  SESSION_LOCK
  USER_LOGOUT
  /// TOTP multi-factor events (SJ-8). Enrolment and reset are the ones an
  /// investigator reads backwards from: `MFA_RESET` is an admin removing
  /// someone else's second factor, which is the single most abusable action in
  /// the feature, and `MFA_RECOVERY_USED` means a code that can never be
  /// presented again just was.
  MFA_ENROLLED
  MFA_CHALLENGE_FAILED
  MFA_RECOVERY_USED
  MFA_RECOVERY_REGENERATED
  MFA_RESET
  USER_CREATED
  USER_UPDATED
  ROLE_ASSIGNED
  ROLE_UNASSIGNED
  /// Role lifecycle (IMP-2). Assignment says who holds a role; these say what
  /// the role *is* — and a permission set that quietly grew is the change an
  /// investigator most needs to find. `metadata` on PERMISSIONS_CHANGED
  /// carries the added and removed keys, not just the final set.
  ROLE_CREATED
  ROLE_UPDATED
  ROLE_DELETED
  ROLE_PERMISSIONS_CHANGED
  /// A per-client feature was switched on or off (IMP-7). Separate from the
  /// role verbs above because it answers a different question: not "who may
  /// do this" but "does this clinic have it at all" — and a disabled feature
  /// overrides every role grant, so the two logs would otherwise disagree
  /// about why a request was refused.
  FEATURE_TOGGLED
  PATIENT_IDENTIFIER_UNMASKED
  DOCTOR_IDENTIFIER_UNMASKED
  PATIENT_MRN_IMPORTED
  INVOICE_VOIDED
  SATUSEHAT_PATIENT_LINKED
  SATUSEHAT_DOCTOR_LINKED
  SATUSEHAT_SUBMISSION_RETRIED
  BPJS_CONFIG_CREATED
  BPJS_CONFIG_UPDATED
  BPJS_CONFIG_DELETED
  BPJS_CONNECTION_TESTED
  BPJS_REFERENCE_SYNCED
  BPJS_MAPPING_UPDATED
  BPJS_ELIGIBILITY_CHECKED
  BPJS_SUBMISSION_RETRIED
  AI_PROVIDER_CONFIG_CREATED
  AI_PROVIDER_CONFIG_UPDATED
  AI_PROVIDER_CONFIG_ACTIVATED
  AI_PROVIDER_CONFIG_DELETED
  AI_PROVIDER_CONNECTION_TESTED
  BPJS_ANTREAN_CONFIG_CREATED
  BPJS_ANTREAN_CONFIG_UPDATED
  BPJS_ANTREAN_CONFIG_DELETED
  BPJS_ANTREAN_CONNECTION_TESTED
  /// Inbound Antrean Online web services (P14-T04). Every call BPJS makes into
  /// the facility lands as one of these, refusals included — the endpoints are
  /// reachable from the public internet, so "nothing happened" has to be
  /// distinguishable from "nobody called".
  BPJS_ANTREAN_INBOUND_TOKEN_ISSUED
  BPJS_ANTREAN_INBOUND_CALL_REJECTED
  BPJS_ANTREAN_INBOUND_QUEUE_READ
  BPJS_ANTREAN_INBOUND_BOOKING_CREATED
  BPJS_ANTREAN_INBOUND_BOOKING_CANCELLED
  BPJS_ANTREAN_INBOUND_PATIENT_REGISTERED
  /// An uploaded object's bytes disagreed with the MIME type its signed
  /// upload declared (SJ-21) — a renamed executable, a polyglot, an encrypted
  /// PDF. The object was deleted at confirm time; this row is how a pattern
  /// of forged uploads by one account is countable afterwards.
  DOCUMENT_UPLOAD_REJECTED
  /// Staff onboarding by email (IMP-23). Three verbs rather than one because
  /// they have three different actors: an administrator sends the invitation,
  /// the invitee — not yet a session — accepts it, and an administrator
  /// withdraws it. `USER_INVITE_ACCEPTED` is the only row in this table whose
  /// actor is the subject, and it is the moment a `User` becomes able to log
  /// in, so it is what "when did this account start existing for real" reads
  /// back to.
  USER_INVITED
  USER_INVITE_ACCEPTED
  USER_INVITE_REVOKED
  /// Organization structure (SJ-1). Five verbs rather than the generic
  /// CREATE/UPDATE/DELETE above because the question asked of this table
  /// afterwards is "who reorganised the clinic", and a move is the one change
  /// that rewrites rows nobody edited — every descendant's `path` shifts. It is
  /// therefore its own verb, with the old and new parent in `metadata`, rather
  /// than an UPDATE that looks identical to a rename.
  ///
  /// ARCHIVED and DELETED are separate for the same reason they are separate
  /// operations: archiving is reversible and routine, hard deletion is refused
  /// while anything still hangs off the unit and is the row an investigator
  /// wants to find.
  ORGANIZATION_UNIT_CREATED
  ORGANIZATION_UNIT_UPDATED
  ORGANIZATION_UNIT_MOVED
  ORGANIZATION_UNIT_ARCHIVED
  ORGANIZATION_UNIT_DELETED
  /// Membership (SJ-89). Separate from the structure verbs above because they
  /// answer to a different permission and a different person: one records who
  /// redrew the chart, these record who was moved between its boxes.
  /// `metadata` on ASSIGNED carries the unit the person came *from*, which on a
  /// reassignment is the half nobody looks at until they need it.
  ORGANIZATION_UNIT_MEMBER_ASSIGNED
  ORGANIZATION_UNIT_MEMBER_UNASSIGNED
}

enum BpjsSubmissionType {
  PENDAFTARAN
  KUNJUNGAN
  PENDAFTARAN_DELETE
  OBAT
  /// Antrean Online publishing (P14-T05). These ride the *same* outbox table,
  /// worker, backoff and monitor as the PCare types — §4.4 of the evaluation
  /// asks for exactly that, and the alternative was a second worker with a
  /// second retry policy to keep in step.
  ///
  /// They are still a different integration: they sign with the Antrean
  /// credentials, not PCare's, and each service has its own circuit breaker,
  /// so a PCare outage cannot stop antrean publishing or the reverse.
  ///
  /// ANTREAN_ADD is enqueued for **walk-ins only**. A Mobile JKN booking is
  /// already BPJS's own row, and re-publishing it would create a duplicate
  /// queue entry for the member; `Appointment.bpjsBookingCode` is what the
  /// enqueue hook checks to tell the two apart.
  ANTREAN_ADD
  ANTREAN_PANGGIL
  ANTREAN_BATAL
}

