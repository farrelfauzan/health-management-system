/// inference of its own — every kind here is an external HTTP endpoint the
/// clinic supplies credentials for. The split is by *wire protocol*, not by
/// brand: everything except ANTHROPIC speaks OpenAI Chat Completions, so one
/// adapter serves them all (P13-T04) and adding a vendor is a new enum value
/// plus a base URL, not a new adapter.
enum AiProviderKind {
  OPENAI
  DEEPSEEK
  ANTHROPIC
  GEMINI
  OLLAMA
  OPENAI_COMPATIBLE
  AZURE_OPENAI
}

/// Which audience a chat session serves. The channel decides the system
/// prompt, the context-enrichment policy, and the safety copy — a patient
/// asking about symptoms and a doctor looking up a guideline are answered
/// under different rules, so the value is fixed at session creation and never
/// changes.
enum ChatChannel {
  PATIENT
  DOCTOR
  ADMIN
}

/// Who produced a chat message. SYSTEM covers prompts and policy notices HMS
/// injects itself; they are persisted alongside user and assistant turns so an
/// auditor can reconstruct exactly what the provider was shown.
enum ChatActor {
  USER
  ASSISTANT
  SYSTEM
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique
  passwordHash String    @map("password_hash")
  isActive     Boolean   @default(true) @map("is_active")
  /// Reserved service account: a row that exists so machine-originated writes
  /// have a real actor to hang off (P14-T04's BPJS Antrean bridge is the first
  /// one). It stays `isActive` because every domain service resolves its
  /// permissions through the ordinary active-user lookup — what makes it a
  /// non-identity is that the login path refuses it outright, so no password,
  /// reset, or token grant can ever turn it into a session.
  isSystem     Boolean   @default(false) @map("is_system")
  /// Which box on the org chart this person sits in (SJ-1). Nullable because
  /// the chart is optional structure a clinic may never fill in, and because a
  /// staff account must keep working while a reorganisation is half done.
  /// Membership lives here rather than in a join table because a person belongs
  /// to one unit — matrix reporting is a second edge type, not a second row.
  organizationUnitId String? @map("organization_unit_id") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  organizationUnit           OrganizationUnit?            @relation("OrganizationUnitMember", fields: [organizationUnitId], references: [id], onDelete: Restrict)
  roles                      UserRole[]
  assignedRoles              UserRole[]                   @relation("RoleAssignedBy")
  unassignedRoles            UserRole[]                   @relation("RoleUnassignedBy")
  patientProfiles            PatientProfile[]
  doctorProfile              DoctorProfile?
  assignedDoctorPatients     DoctorPatient[]              @relation("DoctorPatientAssignedBy")
  unassignedDoctorPatients   DoctorPatient[]              @relation("DoctorPatientUnassignedBy")
  doctorPatientActivities    DoctorPatientActivity[]      @relation("DoctorPatientActivityActor")
  createdAppointments        Appointment[]                @relation("AppointmentCreatedBy")
  createdRegistrations       Registration[]               @relation("RegistrationCreatedBy")
  createdEncounters          Encounter[]                  @relation("EncounterCreatedBy")
  recordedVitalSigns         VitalSigns[]                 @relation("VitalSignsRecordedBy")
  recordedDiagnoses          Diagnosis[]                  @relation("DiagnosisRecordedBy")
  recordedProcedures         Procedure[]                  @relation("ProcedureRecordedBy")
  recordedBpjsReferrals      BpjsReferral[]               @relation("BpjsReferralRecordedBy")
  dispensedByRecords         DispenseRecord[]             @relation("DispensePharmacist")
  medicationStockReceipts    MedicationStockReceipt[]     @relation("MedicationStockReceiptReceivedBy")
  createdInvoices            Invoice[]                    @relation("InvoiceCreatedBy")
  voidedInvoices             Invoice[]                    @relation("InvoiceVoidedBy")
  receivedPayments           Payment[]                    @relation("PaymentCashier")
  refreshTokens              RefreshToken[]
  mfaCredential              MfaCredential?
  mfaRecoveryCodes           MfaRecoveryCode[]
  privacyNoticeRecords       PatientPrivacyNoticeRecord[] @relation("PrivacyNoticeActor")
  chatSessions               ChatSession[]                @relation("ChatSessionOwner")
  chatMessages               ChatMessage[]                @relation("ChatMessageAuthor")
  createdAiProviderConfigs   AiProviderConfig[]           @relation("AiProviderConfigCreatedBy")
  updatedAiProviderConfigs   AiProviderConfig[]           @relation("AiProviderConfigUpdatedBy")
  uploadedDocuments          Document[]                   @relation("DocumentUploadedBy")
  ownedDocuments             Document[]                   @relation("DocumentOwner")
  blockedConversations       Conversation[]               @relation("ConversationBlockedBy")
  conversationMessages       ConversationMessage[]        @relation("ConversationMessageAuthor")
  updatedFeatureEntitlements FeatureEntitlement[]         @relation("FeatureEntitlementUpdatedBy")
  createdAdmissions          Admission[]                  @relation("AdmissionCreatedBy")
  createdBedAssignments      BedAssignment[]              @relation("BedAssignmentCreatedBy")
  notifications              Notification[]               @relation("NotificationRecipient")
  sentInvitations            UserInvitation[]             @relation("UserInvitationInvitedBy")

  @@index([organizationUnitId])
  @@map("users")
}

/// One issued refresh token (SJ-6). The token itself is opaque 256-bit random
/// and is never stored — only `tokenHash`, so a database disclosure yields
/// nothing a caller could present.
///
/// `consumedAt` and `revokedAt` are separate states and the distinction is the
/// whole mechanism. *Consumed* means this token did its job and handed over to
/// a successor; *revoked* means the family was killed. Collapsing them, as this
/// model used to, makes a normal rotation indistinguishable from an attack —
/// so either every multi-tab refresh looks like theft, or no theft is
/// detectable at all.
/// Login attempts, for throttling (SJ-7). One row per try, successes
/// included — a success is what resets an account's failure streak.
///
/// The account is identified by `identifierHash`, a SHA-256 of the lowercased
/// email, never the address itself. Two reasons. This table necessarily
/// records addresses that were *typed*, including typos and addresses that
/// belong to nobody, and a list of those is a liability with no operational
/// value. And hashing costs nothing here: throttling only ever asks "how many
/// recent failures share this identifier", which equality answers.
///
/// Rows are written for unknown accounts too, deliberately. If only real
/// accounts accumulated failures, the throttle itself would answer "does this
/// email exist" — the exact question SJ-7 exists to make unanswerable.
model LoginAttempt {
  id             String   @id @default(uuid()) @db.Uuid
  identifierHash String   @map("identifier_hash")
  ipAddress      String?  @map("ip_address")
  succeeded      Boolean
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([identifierHash, createdAt])
  @@index([ipAddress, createdAt])
  @@index([createdAt])
  @@map("login_attempts")
}

model RefreshToken {
  id         String    @id @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  familyId   String    @map("family_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at")
  /// Set when this token was exchanged for a successor. Within the grace
  /// window a consumed token is still honoured (two tabs refreshing at once is
  /// not an attack); outside it, presenting one is the reuse signal.
  consumedAt DateTime? @map("consumed_at")
  revokedAt  DateTime? @map("revoked_at")
  /// When this session was last known to be in use (SJ-9), carried forward to
  /// each successor so the live token always holds the family's answer.
  ///
  /// Not the same thing as `createdAt`, even though they start equal. A
  /// heartbeat bumps this without rotating, which is what stops someone who is
  /// genuinely reading a screen — interacting, but making no API calls — from
  /// being timed out mid-sentence. Collapsing the two would make "when was
  /// this token minted" and "when was this person last here" the same
  /// question, and they are not.
  lastUsedAt DateTime  @default(now()) @map("last_used_at")
  /// Where the token was issued from. Recorded so a reuse event can be
  /// investigated — "the same family refreshed from two countries" is the
  /// question this column exists to answer.
  ipAddress  String?   @map("ip_address")
  userAgent  String?   @map("user_agent")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
  @@index([revokedAt])
  @@index([lastUsedAt])
  @@map("refresh_tokens")
}

/// One emailed invitation to join the clinic as a staff user (IMP-23),
/// modelled on `RefreshToken` because it is the same problem: a bearer secret
/// that must be presentable exactly once and revocable at any moment.
///
/// Only `tokenHash` is stored, for the same reason and with the same
/// reasoning as refresh tokens — the input is 256 bits of CSPRNG output, so
/// there is no dictionary a slow hash would defend against, and the raw token
/// exists in exactly one place: the link in the email.
///
/// `consumedAt` and `revokedAt` are separate, again deliberately. Accepting an
/// invitation and an administrator withdrawing it are different events with
/// different follow-ups, and the accept route returns a different error code
/// for each — "this invitation was already used" tells the invitee to log in,
/// "this invitation was withdrawn" tells them to ask for another.
///
/// `roleCodes` is a denormalised string array rather than a join table. The
/// grant is not live yet: nothing may be resolved from it until acceptance,
/// and a `UserRole` row before then would be a real permission grant to an
/// account that cannot log in. Codes are re-validated against `Role` at accept
/// time, so a role deleted between invite and accept fails loudly.
model UserInvitation {
  id          String    @id @default(uuid()) @db.Uuid
  email       String
  tokenHash   String    @unique @map("token_hash")
  roleCodes   String[]  @map("role_codes")
  invitedById String    @map("invited_by_id") @db.Uuid
  expiresAt   DateTime  @map("expires_at")
  /// Set when the invitee set a password and the account went live.
  consumedAt  DateTime? @map("consumed_at")
  /// Set when an administrator withdrew the invitation, or when a resend
  /// superseded it — a resend revokes the old row and writes a new one, so the
  /// previous link stops working the moment the replacement is sent.
  revokedAt   DateTime? @map("revoked_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  invitedBy User @relation("UserInvitationInvitedBy", fields: [invitedById], references: [id])

  @@index([email])
  @@index([expiresAt])
  @@index([consumedAt])
  @@index([revokedAt])
  @@index([invitedById])
  @@map("user_invitations")
}

/// One user's TOTP second factor (SJ-8). At most one per user — re-enrolling
/// replaces the row rather than accumulating secrets, so "which of these is
/// live" is never a question.
///
/// The secret is **encrypted, not hashed**, and that asymmetry with
/// `password_hash` is deliberate rather than an oversight. TOTP is a symmetric
/// construction: the server has to recompute the same HMAC the phone does, so
/// it needs the secret back. AES-256-GCM under `MFA_SECRET_ENCRYPTION_KEY`
/// means a database disclosure alone does not yield a working second factor —
/// an attacker needs the application's key as well.
///
/// `verifiedAt` is the enforcement switch. A row exists from the moment
/// enrolment starts, but until the user proves possession by returning a
/// current code it is inert: login is unchanged, and nothing can lock anyone
/// out. Enrolment that is started and abandoned leaves an unverified row that
/// the next attempt overwrites.
///
/// `lastAcceptedTimeStep` is the replay guard. RFC 6238 codes stay valid for a
/// whole 30-second step, so without recording the step that was accepted, a
/// code observed over someone's shoulder — or replayed from a proxy log — works
/// again for the rest of its window. Storing the counter makes every code
/// strictly single-use.
model MfaCredential {
  id                   String    @id @default(uuid()) @db.Uuid
  userId               String    @unique @map("user_id") @db.Uuid
  secretEncrypted      String    @map("secret_encrypted")
  /// Which `MFA_SECRET_ENCRYPTION_KEY` sealed this row, so a key rotation can
  /// find what still needs re-sealing instead of guessing.
  keyVersion           Int       @default(1) @map("key_version")
  verifiedAt           DateTime? @map("verified_at")
  lastAcceptedTimeStep BigInt?   @map("last_accepted_time_step")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([verifiedAt])
  @@map("mfa_credentials")
}

/// A single-use fallback for a lost authenticator (SJ-8).
///
/// Only the SHA-256 is stored, so the plaintext exists exactly once — in the
/// response that issued it. Plain SHA-256 rather than Argon2 is right here:
/// the code is 75 bits of CSPRNG output, so there is no dictionary to slow an
/// attacker down and nothing an offline search can reach. The hash is salted
/// with the owner's id, so one precomputation cannot be reused across users.
///
/// Consumed codes are kept, not deleted. `usedAt` is the audit trail — "this
/// recovery code was spent at 03:14 from that address" is exactly the question
/// asked after an account is suspected compromised, and a deleted row answers
/// nothing.
model MfaRecoveryCode {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  codeHash  String    @unique @map("code_hash")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt])
  @@map("mfa_recovery_codes")
}

/// Sequence source for medical record numbers. Allocation is a single atomic
/// `UPDATE … RETURNING` (never `MAX(mrn) + 1`, which races), run inside the
/// same transaction as the patient insert — so a rolled-back create rolls the
/// counter back with it and the number is handed to the next caller instead of
/// leaving a hole. Committed numbers are never reissued or renumbered: a reused
/// MRN silently merges two patients' histories.
///
/// HMS ships single-facility, so `PatientProfile.mrn` stays globally `@unique`
/// and exactly one counter row exists, keyed by the nil-UUID sentinel. The
/// column is already a UUID PK so a multi-facility deployment adds rows and
/// switches the patient constraint to `@@unique([facilityId, mrn])` without a
/// table rewrite. See docs/post-mvp/patient-identifiers.md §2.3.
model MrnCounter {
  facilityId String   @id @map("facility_id") @db.Uuid
  nextValue  BigInt   @map("next_value")
  updatedAt  DateTime @default(now()) @map("updated_at")

  @@map("mrn_counters")
}

/// Whether one optional product feature is switched on for this deployment
/// (IMP-6). The row is the seam that keeps a clinic which bought registration
/// and pharmacy from seeing BPJS, SATUSEHAT, or the chatbot in its portal —
/// and, once `FeatureGuard` lands (IMP-8), from reaching their endpoints.
///
/// The keys are code-owned: `FEATURE_CATALOG` in `@hms/shared-types` is the
/// list, and the seed converges this table onto it. A row here is therefore a
/// *state* for a known key, never a definition of one — a spelling nobody
/// implements cannot be typed into existence through the admin API.
///
/// `facilityId` is nullable for the same reason it is on `MrnCounter`,
/// `BpjsPcareConfig`, `BpjsAntreanConfig`, and `AiProviderConfig`: the
/// recorded multi-tenancy decision is one database per tenant
/// (`docs/post-mvp/multi-tenancy.md`), so a deployment's rows are already
/// its own and the column is the seam a shared-database tenant would need,
/// not a discriminator anything filters on today. `featureKey` is unique
/// outright rather than unique per facility for exactly that reason —
/// narrowing it later is a migration, and widening a compound key that never
/// had a second value in it is not.
model FeatureEntitlement {
  id          String   @id @default(uuid()) @db.Uuid
  facilityId  String?  @map("facility_id") @db.Uuid
  /// A `FEATURE_CATALOG` key, e.g. `ai-chatbot`. Kebab-case, code-owned.
  featureKey  String   @unique @map("feature_key")
  isEnabled   Boolean  @default(true) @map("is_enabled")
  /// Free text for whoever toggled it — "not in the Rp X package", "paused
  /// pending BPJS credentials". Read by humans only.
  notes       String?
  updatedById String?  @map("updated_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  updatedBy User? @relation("FeatureEntitlementUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([facilityId])
  @@map("feature_entitlements")
}

/// How a patient record came into existence, and therefore how much of it can
/// be trusted to be there (`PCS-T07`).
///
/// `CHANNEL_BOOKING` is the draft a WhatsApp/Telegram customer creates by
/// booking in chat (strategy §5.1). It carries a name and a phone number and
/// nothing else, because §5.3 forbids collecting anything else over an
/// unauthenticated channel — the admin completes it at the counter when the
/// person arrives (§5.2). It exists as a column rather than as an inference
/// from missing fields because "we never asked" and "someone left it blank"
/// are different facts, and only the first one has a worklist.
enum PatientRecordSource {
  FRONT_DESK
  CHANNEL_BOOKING

  @@map("patient_record_source")
}

model PatientProfile {
  id           String              @id @default(uuid()) @db.Uuid
  mrn          String              @unique
  source       PatientRecordSource @default(FRONT_DESK)
  fullName     String              @map("full_name")
  /// Required again since `P17-T05`.
  ///
  /// It was nullable for one release cycle, for `PCS-T07`: the chat booking
  /// flow created patient records without a birth date, because §5.3 forbids
  /// asking for one over an unauthenticated channel and a placeholder date in
  /// a record PMK 24/2022 keeps for 25 years is worse than a null.
  ///
  /// `P17-T03` removed that flow — a chat booking now opens a
  /// `ProspectivePatient`, which costs no MRN and holds no clinical field — so
  /// nothing creates a record without this column any more and the schema
  /// stops advertising a state the product cannot produce.
  dateOfBirth  DateTime            @map("date_of_birth") @db.Date
  placeOfBirth String?             @map("place_of_birth")
  sex          PatientSex
  status       PatientStatus       @default(OUT_PATIENT)
  phoneNumber  String              @map("phone_number")
  /// Required again since `P17-T05`, for the same reason as {@link dateOfBirth}.
  address      String
  ownerUserId  String?             @map("owner_user_id") @db.Uuid
  isActive     Boolean             @default(true) @map("is_active")
  createdAt    DateTime            @default(now()) @map("created_at")
  updatedAt    DateTime            @updatedAt @map("updated_at")
  deletedAt    DateTime?           @map("deleted_at")
  lastVisitAt  DateTime?           @map("last_visit_at")

  // Demographic and clinical-safety identity fields required by PMK 24/2022
  // and expected on Indonesian registration forms. All optional so existing
  // MVP records stay valid; required-ness tightens in the EMR phase.
  email                 String?        @map("email")
  bloodType             BloodType?     @map("blood_type")
  rhesusFactor          RhesusFactor?  @map("rhesus_factor")
  maritalStatus         MaritalStatus? @map("marital_status")
  occupation            String?
  religion              Religion?
  emergencyContactName  String?        @map("emergency_contact_name")
  emergencyContactPhone String?        @map("emergency_contact_phone")
  // Penanggung jawab — required in practice for minors.
  guardianName          String?        @map("guardian_name")
  guardianRelation      String?        @map("guardian_relation")

  // National and payer identifiers are never stored in plaintext. Each
  // searchable identifier lives across three columns: AES-256-GCM ciphertext
  // for retrieval, an HMAC-SHA256 blind index for lookup and uniqueness, and
  // the last four digits for masked display. See
  // docs/post-mvp/patient-identifiers.md.
  // Key version is per identifier, not per row: identifiers are written
  // independently, so one row-level version could not describe two values
  // encrypted under different keys during an incremental rotation.
  nikCiphertext                String? @map("nik_ciphertext")
  nikIndex                     String? @unique @map("nik_index")
  nikLast4                     String? @map("nik_last4")
  nikKeyVersion                Int?    @map("nik_key_version") @db.SmallInt
  bpjsNumberCiphertext         String? @map("bpjs_number_ciphertext")
  bpjsNumberIndex              String? @unique @map("bpjs_number_index")
  bpjsNumberLast4              String? @map("bpjs_number_last4")
  bpjsNumberKeyVersion         Int?    @map("bpjs_number_key_version") @db.SmallInt
  satusehatPatientIdCiphertext String? @map("satusehat_patient_id_ciphertext")
  satusehatPatientIdKeyVersion Int?    @map("satusehat_patient_id_key_version") @db.SmallInt

  ownerUser             User?                        @relation(fields: [ownerUserId], references: [id], onDelete: SetNull)
  doctors               DoctorPatient[]
  appointments          Appointment[]
  registrations         Registration[]
  prescriptions         Prescription[]
  allergies             PatientAllergy[]
  encounters            Encounter[]
  invoices              Invoice[]
  bpjsEligibilityChecks BpjsEligibilityCheck[]
  privacyNoticeRecords  PatientPrivacyNoticeRecord[]
  channelLinks          ChannelPatientLink[]
  prospectiveRecords    ProspectivePatient[]
  admissions            Admission[]

  @@index([deletedAt])
  @@index([ownerUserId])
  @@index([isActive])
  @@index([fullName])
  @@index([status])
  @@index([lastVisitAt])
  /// The arrival worklist (§5.2) asks exactly this question: which records did
  /// the chat channel create that a human has not completed yet.
  ///
  /// There is deliberately **no index on `phoneNumber`**. The channel's
  /// phone match (§5.1) compares digits after normalisation — `0812…` and
  /// `+62812…` are the same number written two ways — so a plain b-tree on the
  /// stored text could never serve it, and carrying one would be an index that
  /// costs every write and answers no query anyone asks.
  @@index([source])
  @@map("patient_profiles")
}

/// Published privacy notices are immutable legal evidence. A correction is a
/// new version, never an update to a version patients have already received.
model PrivacyNoticeVersion {
  id              String   @id @default(uuid()) @db.Uuid
  version         String   @unique
  effectiveAt     DateTime @unique @map("effective_at")
  contentId       String   @map("content_id")
  contentEn       String   @map("content_en")
  contentHashId   String   @map("content_hash_id")
  contentHashEn   String   @map("content_hash_en")
  counselApproved Boolean  @default(false) @map("counsel_approved")
  createdAt       DateTime @default(now()) @map("created_at")

  records PatientPrivacyNoticeRecord[]

  @@map("privacy_notice_versions")
}

/// Append-only proof that a specific notice was provided. This is privacy
/// notice evidence, not treatment consent or permission to process all data.
model PatientPrivacyNoticeRecord {
  id                     String                   @id @default(uuid()) @db.Uuid
  patientId              String                   @map("patient_id") @db.Uuid
  privacyNoticeVersionId String                   @map("privacy_notice_version_id") @db.Uuid
  outcome                PrivacyNoticeOutcome
  locale                 PrivacyNoticeLocale
  contentHash            String                   @map("content_hash")
  subjectType            PrivacyNoticeSubjectType @map("subject_type")
  representativeName     String?                  @map("representative_name")
  representativeRelation String?                  @map("representative_relation")
  actorUserId            String                   @map("actor_user_id") @db.Uuid
  provenance             PrivacyNoticeProvenance
  recordedAt             DateTime                 @default(now()) @map("recorded_at")

  patient PatientProfile       @relation(fields: [patientId], references: [id], onDelete: Restrict)
  version PrivacyNoticeVersion @relation(fields: [privacyNoticeVersionId], references: [id], onDelete: Restrict)
  actor   User                 @relation("PrivacyNoticeActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([patientId, recordedAt])
  @@index([patientId, privacyNoticeVersionId, outcome])
  @@index([actorUserId, recordedAt])
  @@map("patient_privacy_notice_records")
}

/// Free-text substance plus a severity grade. Deliberately uncoded for now —
/// allergen and reaction move to coded terminology in the EMR phase.
model PatientAllergy {
  id        String          @id @default(uuid()) @db.Uuid
  patientId String          @map("patient_id") @db.Uuid
  substance String
  reaction  String?
  severity  AllergySeverity
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")
  deletedAt DateTime?       @map("deleted_at")

  patient PatientProfile @relation(fields: [patientId], references: [id], onDelete: Restrict)

  @@index([patientId])
  @@index([deletedAt])
  @@map("patient_allergies")
}

model Specialty {
  id           String    @id @default(uuid()) @db.Uuid
  name         String    @unique
  description  String?
  /// BPJS PCare kdPoli this specialty registers under (P11-T03). The clinic
  /// has no standalone poli entity — Specialty is the closest structural
  /// equivalent (a registration reaches BPJS via its doctor's specialty), so
  /// the poli mapping lives here rather than on a new join table. Nullable —
  /// an unmapped specialty fails a BPJS submission fast with a readable
  /// message.
  bpjsPoliCode String?   @map("bpjs_poli_code")
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  doctors           DoctorProfile[]
  registrations     Registration[]
  poliQueueCounters PoliQueueCounter[]

  @@index([deletedAt])
  @@index([isActive])
  @@map("specialties")
}

model DoctorProfile {
  id            String    @id @default(uuid()) @db.Uuid
  licenseNumber String    @unique @map("license_number")
  fullName      String    @map("full_name")
  specialtyId   String    @map("specialty_id") @db.Uuid
  phoneNumber   String?   @map("phone_number")
  ownerUserId   String?   @unique @map("owner_user_id") @db.Uuid
  isActive      Boolean   @default(true) @map("is_active")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  // National identity and SATUSEHAT linkage required by PMK 24/2022.
  //
  // A practitioner NIK is the same citizen identifier as a patient NIK and
  // carries the same UU PDP obligations, so it is stored exactly like one:
  // AES-256-GCM ciphertext for retrieval, an HMAC-SHA256 blind index for
  // lookup and uniqueness (SATUSEHAT resolves practitioners by NIK), and the
  // last four digits for masked display. See
  // docs/post-mvp/patient-identifiers.md — only STR/SIP numbers are
  // registry-public and stay plaintext, on DoctorLicense.
  nikCiphertext           String? @map("nik_ciphertext")
  nikIndex                String? @unique @map("nik_index")
  nikLast4                String? @map("nik_last4")
  nikKeyVersion           Int?    @map("nik_key_version") @db.SmallInt
  // IHS practitioner number, filled after the first successful SATUSEHAT
  // practitioner lookup. Plaintext: it is a pseudonymous Kemenkes-issued
  // identifier, read on every outbound FHIR call and never searched by value.
  satusehatPractitionerId String? @map("satusehat_practitioner_id")
  // BPJS PCare kdDokter, set by an admin from the synced DOKTER reference
  // catalog (P11-T03). Plaintext for the same reason as the IHS number: a
  // pseudonymous facility-scoped code read on every pendaftaran/kunjungan
  // submission. Nullable — an unmapped doctor fails a BPJS submission fast
  // with a readable message instead of sending garbage.
  bpjsDoctorCode          String? @map("bpjs_doctor_code")

  // Listing/profile fields clinics expect on doctor directories (P7-T04).
  // Specialty remains the existing Specialty reference table; title/degrees
  // cover honorifics and academic credentials (e.g. "dr.", "Sp.PD").
  //
  // There is deliberately no `email` here: it lives on the linked `User`
  // account and is read through `ownerUser`. Two copies of one address drift
  // the moment a doctor changes it in one place, and the account address is
  // the one that has to be correct — it is what they sign in with.
  title   String?
  degrees String?

  specialty           Specialty            @relation(fields: [specialtyId], references: [id])
  ownerUser           User?                @relation(fields: [ownerUserId], references: [id], onDelete: SetNull)
  patients            DoctorPatient[]
  schedules           DoctorSchedule[]
  appointments        Appointment[]
  appointmentSessions AppointmentSession[]
  prescriptions       Prescription[]
  licenses            DoctorLicense[]
  educations          DoctorEducation[]
  encounters          Encounter[]
  admissions          Admission[]

  @@index([deletedAt])
  @@index([isActive])
  @@index([fullName])
  @@index([specialtyId])
  @@map("doctor_profiles")
}

/// Academic qualifications mapped later to SATUSEHAT Practitioner.qualification
/// together with licensing records. Soft-deleted so history survives edits.
model DoctorEducation {
  id             String    @id @default(uuid()) @db.Uuid
  doctorId       String    @map("doctor_id") @db.Uuid
  institution    String
  degree         String
  fieldOfStudy   String?   @map("field_of_study")
  graduationYear Int?      @map("graduation_year")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  doctor DoctorProfile @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@index([doctorId])
  @@index([deletedAt])
  @@map("doctor_educations")
}

/// Practitioner credentials modelled as a child table rather than flat
/// columns: a doctor holds one lifetime STR but may hold several SIPs (one per
/// practice location), and clinics must track SIP expiry for licensing audits.
model DoctorLicense {
  id            String            @id @default(uuid()) @db.Uuid
  doctorId      String            @map("doctor_id") @db.Uuid
  type          DoctorLicenseType
  licenseNumber String            @map("license_number")
  issuedAt      DateTime?         @map("issued_at") @db.Date
  expiresAt     DateTime?         @map("expires_at") @db.Date
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")
  deletedAt     DateTime?         @map("deleted_at")

  doctor DoctorProfile @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@index([doctorId])
  @@index([deletedAt])
  @@index([expiresAt])
  @@map("doctor_licenses")
}

model DoctorSchedule {
  id          String   @id @default(uuid()) @db.Uuid
  doctorId    String   @map("doctor_id") @db.Uuid
  dayOfWeek   Int      @map("day_of_week")
  startTime   String   @map("start_time")
  endTime     String   @map("end_time")
  isAvailable Boolean  @default(true) @map("is_available")
  maxPatients Int?     @map("max_patients")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  doctor   DoctorProfile        @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  sessions AppointmentSession[]

  @@index([doctorId, dayOfWeek])
  @@map("doctor_schedules")
}

model AppointmentSession {
  id          String                   @id @default(uuid()) @db.Uuid
  doctorId    String                   @map("doctor_id") @db.Uuid
  scheduleId  String?                  @map("schedule_id") @db.Uuid
  sessionDate DateTime                 @map("session_date") @db.Date
  startTime   String                   @map("start_time")
  endTime     String                   @map("end_time")
  maxPatients Int?                     @map("max_patients")
  status      AppointmentSessionStatus @default(OPEN)
  createdAt   DateTime                 @default(now()) @map("created_at")
  updatedAt   DateTime                 @updatedAt @map("updated_at")

  doctor       DoctorProfile   @relation(fields: [doctorId], references: [id], onDelete: Restrict)
  schedule     DoctorSchedule? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  appointments Appointment[]

  @@unique([doctorId, sessionDate, startTime])
  @@index([doctorId, sessionDate])
  @@map("appointment_sessions")
}

model DoctorPatient {
  id             String    @id @default(uuid()) @db.Uuid
  doctorId       String    @map("doctor_id") @db.Uuid
  patientId      String    @map("patient_id") @db.Uuid
  assignedById   String?   @map("assigned_by_id") @db.Uuid
  assignedAt     DateTime  @default(now()) @map("assigned_at")
  unassignedById String?   @map("unassigned_by_id") @db.Uuid
  unassignedAt   DateTime? @map("unassigned_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  doctor       DoctorProfile           @relation(fields: [doctorId], references: [id], onDelete: Restrict)
  patient      PatientProfile          @relation(fields: [patientId], references: [id], onDelete: Restrict)
  assignedBy   User?                   @relation("DoctorPatientAssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)
  unassignedBy User?                   @relation("DoctorPatientUnassignedBy", fields: [unassignedById], references: [id], onDelete: SetNull)
  activities   DoctorPatientActivity[]

  @@index([doctorId, unassignedAt])
  @@index([patientId, unassignedAt])
  @@index([assignedById])
  @@index([unassignedById])
  @@index([assignedAt])
  @@index([unassignedAt])
  @@map("doctor_patients")
}

model DoctorPatientActivity {
  id           String                      @id @default(uuid()) @db.Uuid
  assignmentId String                      @map("assignment_id") @db.Uuid
  action       DoctorPatientActivityAction
  actorUserId  String                      @map("actor_user_id") @db.Uuid
  occurredAt   DateTime                    @default(now()) @map("occurred_at")

  assignment DoctorPatient @relation(fields: [assignmentId], references: [id], onDelete: Restrict)
  actor      User          @relation("DoctorPatientActivityActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([assignmentId, occurredAt])
  @@index([actorUserId, occurredAt])
  @@index([action, occurredAt])
  @@index([occurredAt])
  @@map("doctor_patient_activities")
}

model Appointment {
  id                   String            @id @default(uuid()) @db.Uuid
  /// Exactly one of `patientId` and `prospectivePatientId` is set, enforced by
  /// a CHECK in the migration -- the same shape `Invoice.encounterId` /
  /// `admissionId` uses. A booking either names a patient the clinic has, or a
  /// person who has asked to become one, and never both (`P17-T02`).
  patientId            String?           @map("patient_id") @db.Uuid
  /// Set for a chat booking taken before the person has ever attended
  /// (`P17-T01`). Conversion at the counter repoints the appointment to the
  /// real `patientId` in the same transaction that allocates the MRN, so this
  /// column is how a booking survives the wait without a medical record
  /// existing for someone who may never arrive.
  prospectivePatientId String?           @map("prospective_patient_id") @db.Uuid
  doctorId             String            @map("doctor_id") @db.Uuid
  type                 AppointmentType   @default(SESSION)
  sessionId            String?           @map("session_id") @db.Uuid
  queueNumber          Int?              @map("queue_number")
  /// BPJS's own identifier for a Mobile JKN booking (`kodebooking`), set only
  /// by the inbound Antrean bridge (P14-T04) and null for every appointment a
  /// human made. This column *is* the provenance marker the phase needs, and
  /// it is not optional for two reasons: it is how `sisa antrean` and `batal
  /// antrean` address a booking BPJS made, and it is what stops P14-T05's
  /// outbox re-publishing that booking back to BPJS with `antrean/add` as
  /// though it were a walk-in — it is already BPJS's row.
  ///
  /// Unique, because `kodebooking` is BPJS's primary key for the booking: a
  /// retried `ambil antrean` must collide rather than create a second
  /// appointment for the same member. Whether `kodebooking` is genuinely the
  /// identifier BPJS carries is spike question Q10.
  bpjsBookingCode      String?           @unique @map("bpjs_booking_code")
  /// Which messaging channel booked this appointment, null for every booking
  /// a human made at the counter or in the portal (`PCS-T07`, strategy §5.1).
  ///
  /// Analytics and the arrival worklist both need it, and neither can be
  /// derived from the patient record: a *verified* customer's booking attaches
  /// to a long-standing front-desk patient, so `PatientProfile.source` would
  /// call it a walk-in. The provenance belongs to the booking, not the person.
  bookingSource        ChannelKind?      @map("booking_source")
  /// The short code quoted back to the customer in the confirmation reply
  /// (§4.2 output allowlist). Unique because it is what an admin types to find
  /// the booking, and two bookings answering to one code would be worse than
  /// no code at all.
  bookingReferenceCode String?           @unique @map("booking_reference_code")
  scheduledAt          DateTime          @map("scheduled_at")
  status               AppointmentStatus @default(SCHEDULED)
  reason               String?
  notes                String?
  createdById          String?           @map("created_by_id") @db.Uuid
  createdAt            DateTime          @default(now()) @map("created_at")
  updatedAt            DateTime          @updatedAt @map("updated_at")
  deletedAt            DateTime?         @map("deleted_at")

  patient            PatientProfile?     @relation(fields: [patientId], references: [id], onDelete: Restrict)
  prospectivePatient ProspectivePatient? @relation(fields: [prospectivePatientId], references: [id], onDelete: Restrict)
  doctor       DoctorProfile       @relation(fields: [doctorId], references: [id], onDelete: Restrict)
  session      AppointmentSession? @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  createdBy    User?               @relation("AppointmentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  registration Registration?

  @@unique([sessionId, queueNumber])
  @@index([bookingSource, scheduledAt])
  @@index([doctorId, scheduledAt])
  @@index([patientId, scheduledAt])
  @@index([prospectivePatientId, scheduledAt])
  @@index([status, scheduledAt])
  @@index([sessionId])
  @@index([deletedAt])
  @@map("appointments")
}

/// Allocates the daily antrian sequence, one row per clinic-local calendar
/// day, consumed with a single atomic upsert (`INSERT … ON CONFLICT … UPDATE
/// … RETURNING`) inside the registration-create transaction — the same
/// reasoning as `MrnCounter`: concurrent front-desk and self-service
/// registrations race, and `MAX(queue_number) + 1` hands two patients the
/// same ticket. The queue is clinic-wide: it is the physical ticket roll at
/// the door, and it stays clinic-wide even in a multi-poli clinic because
/// that is what the roll dispenses. The per-poli sequence is a second,
/// independent number — see `PoliQueueCounter`.
model QueueCounter {
  queueDate DateTime @id @map("queue_date") @db.Date
  nextValue Int      @map("next_value")
  updatedAt DateTime @default(now()) @map("updated_at")

  @@map("queue_counters")
}

/// Allocates the daily per-poli antrian sequence — the same atomic upsert as
/// `QueueCounter`, keyed on `(queueDate, specialtyId)` instead of the day
/// alone (P14-T01).
///
/// This is deliberately a *second* number rather than a replacement. The
/// clinic-wide roll is floor management: one ticket dispenser at the door,
/// one number per patient, and it must keep working for a walk-in whose poli
/// is not yet known. The per-poli number is what a poli's own display calls
/// and what BPJS Antrean Online treats as *the* queue number, which is
/// per-poli by contract (ADR D-023) — so a patient legitimately carries two
/// numbers, and collapsing them would break one of the two consumers.
///
/// `Specialty` is the clinic's poli entity (see `Specialty.bpjsPoliCode`);
/// there is no standalone poli table, so the counter keys on it directly.
model PoliQueueCounter {
  queueDate   DateTime @map("queue_date") @db.Date
  specialtyId String   @map("specialty_id") @db.Uuid
  nextValue   Int      @map("next_value")
  updatedAt   DateTime @default(now()) @map("updated_at")

  specialty Specialty @relation(fields: [specialtyId], references: [id], onDelete: Restrict)

  @@id([queueDate, specialtyId])
  @@index([specialtyId])
  @@map("poli_queue_counters")
}

model Registration {
  id              String             @id @default(uuid()) @db.Uuid
  patientId       String             @map("patient_id") @db.Uuid
  appointmentId   String?            @unique @map("appointment_id") @db.Uuid
  status          RegistrationStatus @default(PENDING)
  /// Daily antrian ticket, allocated from `QueueCounter` when the
  /// registration is created. Nullable only because rows predate the queue;
  /// never renumbered and never reissued — a cancellation leaves a gap, which
  /// is what a paper ticket roll does too.
  queueNumber     Int?               @map("queue_number")
  /// The clinic-local (`CLINIC_TIMEZONE`) calendar day the ticket belongs to.
  /// Stored explicitly rather than derived from `registeredAt` so the board
  /// query never re-does timezone arithmetic over UTC timestamps.
  queueDate       DateTime?          @map("queue_date") @db.Date
  /// The poli (`Specialty`) this visit is booked into, resolved from the
  /// linked appointment's doctor when the ticket is issued. Null for a
  /// walk-in registered without an appointment: the poli is genuinely not
  /// known yet, and guessing one would allocate a number in a queue the
  /// patient may never join.
  ///
  /// Denormalised onto the registration rather than read back through
  /// `appointment.doctor.specialtyId` because it is the anchor of the
  /// allocated number: a doctor who later moves specialty must not
  /// retroactively move yesterday's tickets into another poli's sequence.
  specialtyId     String?            @map("specialty_id") @db.Uuid
  /// The poli's own daily ticket, allocated from `PoliQueueCounter`
  /// alongside `queueNumber` (P14-T01). Set exactly when `specialtyId` is,
  /// and governed by the same never-renumbered, never-reissued rule.
  poliQueueNumber Int?               @map("poli_queue_number")
  registeredAt    DateTime           @default(now()) @map("registered_at")
  checkedInAt     DateTime?          @map("checked_in_at")
  completedAt     DateTime?          @map("completed_at")
  createdById     String?            @map("created_by_id") @db.Uuid
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")
  deletedAt       DateTime?          @map("deleted_at")

  patient         PatientProfile   @relation(fields: [patientId], references: [id], onDelete: Restrict)
  appointment     Appointment?     @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  specialty       Specialty?       @relation(fields: [specialtyId], references: [id], onDelete: Restrict)
  createdBy       User?            @relation("RegistrationCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  encounter       Encounter?
  bpjsSubmissions BpjsSubmission[]

  @@unique([queueDate, queueNumber])
  @@unique([queueDate, specialtyId, poliQueueNumber])
  @@index([patientId, status])
  @@index([status, registeredAt])
  @@index([queueDate, specialtyId])
  @@index([deletedAt])
  @@map("registrations")
}

/// The clinical record of one visit, mandated by PMK 24/2022. Opened from a
/// CHECKED_IN registration and closed when the doctor finishes; vitals,
/// diagnoses, SOAP notes, and procedures hang off it in later tasks.
///
/// `registrationId` is unique — one encounter per registration. A second visit
/// on the same day is a second registration, which is also what the queue and
/// the payer expect.
///
/// `doctorId` is stored on the encounter rather than read through the
/// appointment: walk-in registrations have no appointment at all, and the
/// doctor who actually attended may differ from the one booked. The medical
/// record must name the practitioner who signed it.
model Encounter {
  id             String          @id @default(uuid()) @db.Uuid
  registrationId String          @unique @map("registration_id") @db.Uuid
  patientId      String          @map("patient_id") @db.Uuid
  doctorId       String          @map("doctor_id") @db.Uuid
  status         EncounterStatus @default(IN_PROGRESS)
  startedAt      DateTime        @default(now()) @map("started_at")
  endedAt        DateTime?       @map("ended_at")
  createdById    String?         @map("created_by_id") @db.Uuid
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  deletedAt      DateTime?       @map("deleted_at")

  // SOAP note — the narrative half of the PMK 24/2022 minimum record, which
  // requires anamnesis, examination findings, diagnosis, and treatment plan.
  // Free text on purpose: the coded parts of the record live in `diagnoses`
  // (ICD-10) and `procedures` (ICD-9-CM), and forcing narrative reasoning into
  // codes loses the clinical detail a later reader needs.
  /// Anamnesis — what the patient reports.
  subjective String?
  /// Examination findings. Measured vitals stay in `vital_signs`; this is the
  /// qualitative reading of them.
  objective  String?
  /// Clinical reasoning. The coded conclusion is a `Diagnosis` row.
  assessment String?
  /// Treatment plan. Prescribed items stay in `prescriptions`.
  plan       String?

  registration        Registration         @relation(fields: [registrationId], references: [id], onDelete: Restrict)
  patient             PatientProfile       @relation(fields: [patientId], references: [id], onDelete: Restrict)
  doctor              DoctorProfile        @relation(fields: [doctorId], references: [id], onDelete: Restrict)
  createdBy           User?                @relation("EncounterCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  vitalSigns          VitalSigns[]
  diagnoses           Diagnosis[]
  procedures          Procedure[]
  prescriptions       Prescription[]
  invoices            Invoice[]
  satusehatSubmission SatusehatSubmission?
  bpjsReferral        BpjsReferral?
  admissions          Admission[]

  @@index([patientId, startedAt])
  @@index([doctorId, startedAt])
  @@index([status, startedAt])
  @@index([deletedAt])
  @@map("encounters")
}

/// One set of vital signs measured during an encounter — the "hasil
/// pemeriksaan fisik" half of the PMK 24/2022 minimum record.
///
/// Many rows per encounter, not one: re-measuring after an abnormal reading
/// (a blood-pressure recheck, a post-antipyretic temperature) is routine, and
/// overwriting the first reading would erase the finding that prompted the
/// second. Each row is an independent measurement stamped with `recordedAt`,
/// which is also exactly how it maps to a SATUSEHAT `Observation` in P10-T03.
/// "The" vitals for a submission or a summary view are the newest row.
///
/// Every measurement is nullable — front desks record weight and blood
/// pressure while a full set only appears when clinically indicated. Units are
/// fixed by the column (cm, kg, °C, mmHg, beats/min, breaths/min, %) so no
/// unit column is needed; LOINC codes live in the SATUSEHAT adapter, never
/// here. BMI is derived from height and weight on read and is deliberately not
/// stored — a stored copy goes stale the moment either input is corrected.
///
/// The CHECK constraints reject physiologically impossible values (a decimal
/// typo turning 36.8 °C into 368), not clinically abnormal ones: a genuinely
/// critical reading must still be recordable.
model VitalSigns {
  id                     String    @id @default(uuid()) @db.Uuid
  encounterId            String    @map("encounter_id") @db.Uuid
  heightCm               Decimal?  @map("height_cm") @db.Decimal(5, 2)
  weightKg               Decimal?  @map("weight_kg") @db.Decimal(5, 2)
  systolicBloodPressure  Int?      @map("systolic_blood_pressure")
  diastolicBloodPressure Int?      @map("diastolic_blood_pressure")
  pulseRate              Int?      @map("pulse_rate")
  respiratoryRate        Int?      @map("respiratory_rate")
  temperatureCelsius     Decimal?  @map("temperature_celsius") @db.Decimal(4, 1)
  oxygenSaturation       Int?      @map("oxygen_saturation")
  notes                  String?
  recordedAt             DateTime  @default(now()) @map("recorded_at")
  recordedById           String?   @map("recorded_by_id") @db.Uuid
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")
  deletedAt              DateTime? @map("deleted_at")

  encounter  Encounter @relation(fields: [encounterId], references: [id], onDelete: Restrict)
  recordedBy User?     @relation("VitalSignsRecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)

  @@index([encounterId, recordedAt])
  @@index([deletedAt])
  @@map("vital_signs")
}

/// ICD-10 catalog used to code diagnoses. Reference data, not clinical data:
/// rows are maintained by an administrator or replaced wholesale by the
/// official Kemenkes list, and nothing here belongs to a patient.
///
/// Retired codes are deactivated (`isActive = false`), never deleted — historic
/// encounters must keep resolving the code they were coded with.
///
/// `displayIndonesian` holds the Kemenkes Bahasa Indonesia title where one
/// exists. Clinicians search in Indonesian, so it is matched alongside the WHO
/// English title rather than being display-only.
model Icd10Code {
  id                String    @id @default(uuid()) @db.Uuid
  code              String    @unique
  display           String
  displayIndonesian String?   @map("display_indonesian")
  /// Three-character parent code (`J06` for `J06.9`), for grouping and for
  /// falling back to the category when a payer rejects a subdivision.
  category          String?
  /// ICD-10 chapter in Roman numerals, e.g. `X` for respiratory diseases.
  chapter           String?
  isActive          Boolean   @default(true) @map("is_active")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  deletedAt         DateTime? @map("deleted_at")

  diagnoses Diagnosis[]

  @@index([category])
  @@index([isActive])
  @@index([deletedAt])
  @@map("icd10_codes")
}

/// A coded diagnosis recorded on an encounter — the "diagnosis" line PMK
/// 24/2022 requires, and the input to both BPJS claims and SATUSEHAT
/// `Condition` resources.
///
/// `code` and `display` are stored as a snapshot of what the clinician
/// actually recorded, alongside the optional `icd10CodeId` link. A medical
/// record must not change retroactively: if the catalog row is later renamed,
/// re-categorised, or retired, the signed record keeps the wording it was
/// signed with. The FK is `SetNull` for the same reason — losing the catalog
/// row must never take the diagnosis with it.
model Diagnosis {
  id           String        @id @default(uuid()) @db.Uuid
  encounterId  String        @map("encounter_id") @db.Uuid
  icd10CodeId  String?       @map("icd10_code_id") @db.Uuid
  code         String
  display      String
  type         DiagnosisType @default(SECONDARY)
  notes        String?
  recordedAt   DateTime      @default(now()) @map("recorded_at")
  recordedById String?       @map("recorded_by_id") @db.Uuid
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  deletedAt    DateTime?     @map("deleted_at")

  encounter  Encounter  @relation(fields: [encounterId], references: [id], onDelete: Restrict)
  icd10Code  Icd10Code? @relation(fields: [icd10CodeId], references: [id], onDelete: SetNull)
  recordedBy User?      @relation("DiagnosisRecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)

  @@index([encounterId, type])
  @@index([code])
  @@index([deletedAt])
  @@map("diagnoses")
}

/// ICD-9-CM procedure catalog — the counterpart to `Icd10Code` for actions
/// rather than conditions. BPJS claims price a visit from the procedures
/// recorded against it, so an uncoded action is an unbillable one.
///
/// Same rules as the diagnosis catalog: reference data, retired codes are
/// deactivated rather than deleted, and the official list is loaded by
/// `pnpm --filter @hms/api icd9cm:import`. There is no chapter column —
/// ICD-9-CM procedure chapters do not follow a clean lexicographic range the
/// way ICD-10 chapters do, so only the two-digit `category` is derived.
model Icd9cmCode {
  id                String    @id @default(uuid()) @db.Uuid
  code              String    @unique
  display           String
  displayIndonesian String?   @map("display_indonesian")
  /// Two-digit parent code (`93` for `93.94`).
  category          String?
  isActive          Boolean   @default(true) @map("is_active")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  deletedAt         DateTime? @map("deleted_at")

  procedures Procedure[]

  @@index([category])
  @@index([isActive])
  @@index([deletedAt])
  @@map("icd9cm_codes")
}

/// A coded action performed during an encounter — injection, wound suture,
/// nebulisation. Feeds BPJS claim lines and, later, SATUSEHAT `Procedure`
/// resources.
///
/// `code` and `display` are a snapshot of what was signed, exactly as on
/// `Diagnosis`: a catalog rename must never rewrite a signed record. Unlike
/// diagnoses there is no primary/secondary split — every procedure on a visit
/// counts equally toward the claim.
model Procedure {
  id           String    @id @default(uuid()) @db.Uuid
  encounterId  String    @map("encounter_id") @db.Uuid
  icd9cmCodeId String?   @map("icd9cm_code_id") @db.Uuid
  code         String
  display      String
  notes        String?
  /// When the action was performed, which can precede the moment it was
  /// written down.
  performedAt  DateTime  @default(now()) @map("performed_at")
  recordedById String?   @map("recorded_by_id") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  encounter  Encounter   @relation(fields: [encounterId], references: [id], onDelete: Restrict)
  icd9cmCode Icd9cmCode? @relation(fields: [icd9cmCodeId], references: [id], onDelete: SetNull)
  recordedBy User?       @relation("ProcedureRecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)

  @@index([encounterId, performedAt])
  @@index([code])
  @@index([deletedAt])
  @@map("procedures")
}

model Medication {
  id           String              @id @default(uuid()) @db.Uuid
  code         String              @unique
  kfaCode      String?             @unique @map("kfa_code")
  /// BPJS DPHO kdObat (P11-T03), linked by an admin from the search-and-cache
  /// DPHO catalog. Sits alongside kfaCode — two national code systems, one
  /// medication row. Unique for the same reason kfaCode is: one catalog
  /// identity maps to at most one local row.
  dphoCode     String?             @unique @map("dpho_code")
  name         String
  form         String?
  strength     String?
  unit         MedicationUnit?
  category     MedicationCategory?
  reorderLevel Int                 @default(0) @map("reorder_level")
  /// Selling price per `unit`, in rupiah. Nullable because the MVP catalog
  /// predates billing; invoice generation treats an unpriced dispensed
  /// medication as a gap to surface, not a free item.
  unitPrice    Decimal?            @map("unit_price") @db.Decimal(12, 2)
  createdAt    DateTime            @default(now()) @map("created_at")
  updatedAt    DateTime            @updatedAt @map("updated_at")
  deletedAt    DateTime?           @map("deleted_at")

  prescriptionItems PrescriptionMedication[]
  dispenseItems     DispenseItem[]
  stockReceipts     MedicationStockReceipt[]
  invoiceItems      InvoiceItem[]

  @@index([name])
  @@index([category])
  @@index([reorderLevel])
  @@index([deletedAt])
  @@map("medications")
}

model Prescription {
  id          String             @id @default(uuid()) @db.Uuid
  patientId   String             @map("patient_id") @db.Uuid
  doctorId    String             @map("doctor_id") @db.Uuid
  /// The visit this prescription was written during. Nullable, and deliberately
  /// so: repeat prescriptions are issued between visits, and every MVP row
  /// predates the encounter record. Once set it is never moved — a prescription
  /// belongs to the visit that produced it.
  encounterId String?            @map("encounter_id") @db.Uuid
  status      PrescriptionStatus @default(DRAFT)
  issuedAt    DateTime?          @map("issued_at")
  notes       String?
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")
  deletedAt   DateTime?          @map("deleted_at")

  patient         PatientProfile           @relation(fields: [patientId], references: [id], onDelete: Restrict)
  doctor          DoctorProfile            @relation(fields: [doctorId], references: [id], onDelete: Restrict)
  encounter       Encounter?               @relation(fields: [encounterId], references: [id], onDelete: Restrict)
  items           PrescriptionMedication[]
  dispenseRecords DispenseRecord[]

  @@index([patientId, status])
  @@index([doctorId, status])
  @@index([encounterId])
  @@index([deletedAt])
  @@map("prescriptions")
}

model PrescriptionMedication {
  id             String   @id @default(uuid()) @db.Uuid
  prescriptionId String   @map("prescription_id") @db.Uuid
  medicationId   String   @map("medication_id") @db.Uuid
  dosage         String
  frequency      String
  durationDays   Int?     @map("duration_days")
  quantity       Int
  instructions   String?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  prescription Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  medication   Medication   @relation(fields: [medicationId], references: [id], onDelete: Restrict)

  @@unique([prescriptionId, medicationId])
  @@index([prescriptionId])
  @@index([medicationId])
  @@map("prescription_medications")
}

model DispenseRecord {
  id             String         @id @default(uuid()) @db.Uuid
  prescriptionId String         @map("prescription_id") @db.Uuid
  pharmacistId   String         @map("pharmacist_id") @db.Uuid
  dispensedAt    DateTime       @default(now()) @map("dispensed_at")
  status         DispenseStatus @default(DISPENSED)
  notes          String?
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  prescription Prescription   @relation(fields: [prescriptionId], references: [id], onDelete: Restrict)
  pharmacist   User           @relation("DispensePharmacist", fields: [pharmacistId], references: [id], onDelete: Restrict)
  items        DispenseItem[]

  @@index([prescriptionId])
  @@index([pharmacistId])
  @@index([status, dispensedAt])
  @@map("dispense_records")
}

model DispenseItem {
  id               String   @id @default(uuid()) @db.Uuid
  dispenseRecordId String   @map("dispense_record_id") @db.Uuid
  medicationId     String   @map("medication_id") @db.Uuid
  quantity         Int
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  dispenseRecord   DispenseRecord                @relation(fields: [dispenseRecordId], references: [id], onDelete: Cascade)
  medication       Medication                    @relation(fields: [medicationId], references: [id], onDelete: Restrict)
  stockAllocations DispenseItemStockAllocation[]

  @@unique([dispenseRecordId, medicationId])
  @@index([medicationId])
  @@map("dispense_items")
}

model MedicationStockReceipt {
  id                String    @id @default(uuid()) @db.Uuid
  medicationId      String    @map("medication_id") @db.Uuid
  batchNumber       String    @map("batch_number")
  expiryDate        DateTime? @map("expiry_date") @db.Date
  quantity          Int
  remainingQuantity Int       @map("remaining_quantity")
  receivedAt        DateTime  @default(now()) @map("received_at")
  receivedById      String?   @map("received_by_id") @db.Uuid
  notes             String?
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  medication  Medication                    @relation(fields: [medicationId], references: [id], onDelete: Restrict)
  receivedBy  User?                         @relation("MedicationStockReceiptReceivedBy", fields: [receivedById], references: [id], onDelete: SetNull)
  allocations DispenseItemStockAllocation[]

  @@index([medicationId, expiryDate, receivedAt])
  @@index([medicationId, remainingQuantity, expiryDate])
  @@index([expiryDate])
  @@index([receivedById])
  @@map("medication_stock_receipts")
}

model DispenseItemStockAllocation {
  id             String   @id @default(uuid()) @db.Uuid
  dispenseItemId String   @map("dispense_item_id") @db.Uuid
  stockReceiptId String   @map("stock_receipt_id") @db.Uuid
  quantity       Int
  createdAt      DateTime @default(now()) @map("created_at")

  dispenseItem DispenseItem           @relation(fields: [dispenseItemId], references: [id], onDelete: Cascade)
  stockReceipt MedicationStockReceipt @relation(fields: [stockReceiptId], references: [id], onDelete: Restrict)

  @@unique([dispenseItemId, stockReceiptId])
  @@index([stockReceiptId])
  @@map("dispense_item_stock_allocations")
}

/// The clinic's own identity (P16-T02) — the source of every `clinic.*`
/// variable an invoice or clinical document renders. Until this row exists,
/// clinic identity lives only in `CS_CLINIC_NAME`, an env var the
/// customer-service prompt reads, which is not something a document can cite.
///
/// Every field except the name is nullable because a clinic configures this
/// once, incrementally, and a half-filled profile must still render: an
/// invoice missing a tax ID is an invoice missing a line, while a profile the
/// admin cannot save until they have found the licence number is a feature
/// nobody turns on.
///
/// `logoStorageKey` is a storage key and never a URL (D-018). URLs into the
/// bucket are signed, short-lived, and minted per request; one persisted in a
/// column would be a stale link at best and a bearer token with no expiry
/// written into the database at worst.
///
/// `facilityId` is null on the single-tenant deployment — Postgres unique
/// indexes treat NULLs as distinct, so a hand-written partial unique index in
/// the migration is what actually keeps that row a singleton, exactly as it
/// does for the two BPJS config tables.
model ClinicProfile {
  id             String    @id @default(uuid()) @db.Uuid
  facilityId     String?   @unique @map("facility_id") @db.Uuid
  name           String
  legalName      String?   @map("legal_name")
  address        String?
  phoneNumber    String?   @map("phone_number")
  email          String?
  /// Izin operasional klinik — the operating licence a receipt is expected to
  /// carry in Indonesia.
  licenseNumber  String?   @map("license_number")
  /// NPWP. Stored as written; HMS neither validates nor formats it, because a
  /// receipt reproduces what the clinic was issued.
  taxId          String?   @map("tax_id")
  /// Server-minted object key for the re-encoded logo, or null. The bytes
  /// behind it are always this service's own re-encode, never what the
  /// browser uploaded (docs/security/file-uploads.md §1).
  logoStorageKey String?   @map("logo_storage_key")
  /// What the stored object actually is, so the signed download pins
  /// `ResponseContentType` to a validated value rather than to a constant
  /// that a future re-encode target would silently make wrong.
  logoMimeType   String?   @map("logo_mime_type")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@map("clinic_profiles")
}

/// Price-list row for services the clinic charges — consultation fees and
/// clinical actions (tindakan). Reference data like the terminology catalogs:
/// rows are deactivated, never deleted, because invoice items snapshot the
/// price they were billed at and only need the row for provenance.
///
/// `icd9cmCode` optionally maps a coded `Procedure` to its tariff so invoice
/// generation can auto-collect procedure charges; actions the clinic bills
/// without coding stay reachable by tariff `code` alone.
model ServiceTariff {
  id          String                @id @default(uuid()) @db.Uuid
  code        String                @unique
  name        String
  category    ServiceTariffCategory
  /// ICD-9-CM procedure code this tariff prices, when the action is coded.
  /// Unique so auto-collection resolves at most one tariff per procedure.
  icd9cmCode  String?               @unique @map("icd9cm_code")
  /// The ward class this row prices, for ACCOMMODATION tariffs (IMP-15).
  /// A CHECK in the migration makes it required for that category and
  /// forbidden for every other, and a partial unique index allows one live
  /// tariff per class — a bed cannot have two prices at once.
  roomClassId String?               @map("room_class_id") @db.Uuid
  /// Rupiah. CHECK in the migration rejects negative prices.
  price       Decimal               @db.Decimal(12, 2)
  isActive    Boolean               @default(true) @map("is_active")
  createdAt   DateTime              @default(now()) @map("created_at")
  updatedAt   DateTime              @updatedAt @map("updated_at")
  deletedAt   DateTime?             @map("deleted_at")

  roomClass    RoomClass?    @relation(fields: [roomClassId], references: [id], onDelete: Restrict)
  invoiceItems InvoiceItem[]

  @@index([category])
  @@index([isActive])
  @@index([roomClassId])
  @@index([deletedAt])
  @@map("service_tariffs")
}

/// Sequence source for per-day invoice numbers — the `QueueCounter` reasoning
/// applied to the cashier: allocation is one atomic
/// `INSERT … ON CONFLICT … RETURNING` inside the invoice-create transaction,
/// never `MAX + 1`, which races. A rolled-back create returns its number; a
/// committed one is never reissued, so a voided invoice leaves a gap exactly
/// like a torn paper receipt.
model InvoiceCounter {
  invoiceDate DateTime @id @map("invoice_date") @db.Date
  nextValue   Int      @map("next_value")
  updatedAt   DateTime @default(now()) @map("updated_at")

  @@map("invoice_counters")
}

/// The cashier's bill for one visit, auto-collected from the finished
/// encounter (consultation fee, procedures, dispensed medications) in P9-T03.
///
/// `encounterId` is deliberately NOT `@unique`: a wrongly issued invoice is
/// corrected by voiding it (with reason and audit) and issuing a replacement
/// for the same encounter. A hand-written partial unique index
/// (`WHERE status <> 'VOID' AND deleted_at IS NULL`) enforces at most one
/// live invoice per encounter while letting voided ones accumulate.
///
/// `totalAmount` is stored, unlike derived clinical values: an invoice is a
/// financial document, and the total is part of what was issued — it must not
/// silently change if a tariff or item row is touched later. The service
/// recomputes it from items on every write while the invoice is DRAFT.
model Invoice {
  id            String        @id @default(uuid()) @db.Uuid
  invoiceNumber String        @unique @map("invoice_number")
  /// Null for an inpatient bill. Exactly one of `encounterId` and
  /// `admissionId` is set, enforced by a CHECK in the migration — an invoice
  /// always says which episode of care it bills, and never two.
  encounterId   String?       @map("encounter_id") @db.Uuid
  /// The stay this bill is for (IMP-15). Nullable and not `@unique` for the
  /// same reason as `encounterId`: a wrongly issued invoice is voided and
  /// replaced, and a partial unique index keeps at most one live invoice per
  /// admission while letting voided ones accumulate.
  admissionId   String?       @map("admission_id") @db.Uuid
  patientId     String        @map("patient_id") @db.Uuid
  status        InvoiceStatus @default(DRAFT)
  totalAmount   Decimal       @default(0) @map("total_amount") @db.Decimal(12, 2)
  issuedAt      DateTime?     @map("issued_at")
  voidedAt      DateTime?     @map("voided_at")
  voidReason    String?       @map("void_reason")
  voidedById    String?       @map("voided_by_id") @db.Uuid
  createdById   String?       @map("created_by_id") @db.Uuid
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")
  deletedAt     DateTime?     @map("deleted_at")

  encounter Encounter?     @relation(fields: [encounterId], references: [id], onDelete: Restrict)
  admission Admission?     @relation(fields: [admissionId], references: [id], onDelete: Restrict)
  patient   PatientProfile @relation(fields: [patientId], references: [id], onDelete: Restrict)
  voidedBy  User?          @relation("InvoiceVoidedBy", fields: [voidedById], references: [id], onDelete: SetNull)
  createdBy User?          @relation("InvoiceCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  items     InvoiceItem[]
  payment   Payment?

  @@index([encounterId])
  @@index([admissionId])
  @@index([patientId, createdAt])
  @@index([status, issuedAt])
  @@index([deletedAt])
  @@map("invoices")
}

/// One line on an invoice. `description`, `unitPrice`, and `amount` are a
/// snapshot of what was billed — the `Diagnosis` snapshot rule applied to
/// money: repricing a tariff or renaming a medication must never rewrite an
/// issued invoice. `serviceTariffId` / `medicationId` are provenance only,
/// `SetNull` so losing a catalog row never takes the billed line with it.
///
/// Items live and die with their invoice (`Cascade`): a DRAFT regenerate
/// replaces them wholesale, and a voided invoice keeps its lines because the
/// invoice row itself is never deleted.
model InvoiceItem {
  id              String          @id @default(uuid()) @db.Uuid
  invoiceId       String          @map("invoice_id") @db.Uuid
  itemType        InvoiceItemType @map("item_type")
  serviceTariffId String?         @map("service_tariff_id") @db.Uuid
  medicationId    String?         @map("medication_id") @db.Uuid
  description     String
  quantity        Int
  unitPrice       Decimal         @map("unit_price") @db.Decimal(12, 2)
  /// Always `quantity * unitPrice`, enforced by a CHECK in the migration —
  /// stored anyway because the row is a financial snapshot, not a view.
  amount          Decimal         @db.Decimal(12, 2)
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  invoice       Invoice        @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  serviceTariff ServiceTariff? @relation(fields: [serviceTariffId], references: [id], onDelete: SetNull)
  medication    Medication?    @relation(fields: [medicationId], references: [id], onDelete: SetNull)

  @@index([invoiceId])
  @@index([serviceTariffId])
  @@index([medicationId])
  @@map("invoice_items")
}

/// Settlement of one invoice. `invoiceId` is `@unique` on purpose: one full
/// payment per invoice is the v1 scope (partial payments are out), and the
/// constraint is that scope stated in the schema — relaxing it later is a
/// dropped index, not a rewrite. A payment recorded in error is corrected the
/// same way a wrong invoice is: void the invoice (P9-T03) and reissue, which
/// produces a fresh invoice for a fresh payment.
///
/// No `deletedAt`: a payment is money that changed hands, like a
/// `DispenseRecord` is stock that left the shelf — the row is permanent.
/// `cashierId` is `Restrict` for the same accountability reason as the
/// dispensing pharmacist: the person who took the money must stay resolvable.
model Payment {
  id              String        @id @default(uuid()) @db.Uuid
  invoiceId       String        @unique @map("invoice_id") @db.Uuid
  method          PaymentMethod
  /// Rupiah. Must equal the invoice's `totalAmount` — enforced in the service
  /// (cross-table), while the migration CHECK only rejects negatives.
  amount          Decimal       @db.Decimal(12, 2)
  /// External trace for non-cash methods: transfer slip, QRIS transaction id,
  /// or insurance approval number.
  referenceNumber String?       @map("reference_number")
  notes           String?
  paidAt          DateTime      @default(now()) @map("paid_at")
  cashierId       String        @map("cashier_id") @db.Uuid
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  cashier User    @relation("PaymentCashier", fields: [cashierId], references: [id], onDelete: Restrict)

  @@index([paidAt])
  @@index([cashierId])
  @@index([method, paidAt])
  @@map("payments")
}

model Role {
  id          String    @id @default(uuid()) @db.Uuid
  code        String    @unique
  name        String
  description String?
  isSystem    Boolean   @default(false) @map("is_system")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id            String          @id @default(uuid()) @db.Uuid
  permissionKey String          @unique @map("permission_key")
  resource      String
  action        String
  scope         PermissionScope
  description   String?
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  roles RolePermission[]

  @@index([resource, action, scope])
  @@map("permissions")
}

model RolePermission {
  id           String   @id @default(uuid()) @db.Uuid
  roleId       String   @map("role_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
}

model UserRole {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  roleId         String    @map("role_id") @db.Uuid
  assignedById   String?   @map("assigned_by_id") @db.Uuid
  assignedAt     DateTime  @default(now()) @map("assigned_at")
  unassignedById String?   @map("unassigned_by_id") @db.Uuid
  unassignedAt   DateTime? @map("unassigned_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  user         User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  role         Role  @relation(fields: [roleId], references: [id], onDelete: Restrict)
  assignedBy   User? @relation("RoleAssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)
  unassignedBy User? @relation("RoleUnassignedBy", fields: [unassignedById], references: [id], onDelete: SetNull)

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
  @@index([deletedAt])
  @@map("user_roles")
}

/// Outbox row for one encounter's SATUSEHAT bundle submission (P10-T04).
/// Created in the same transaction that closes the encounter, so a closed
/// visit can never silently miss the reporting queue, and clinical flows
/// never wait on Kemenkes availability.
///
/// The row carries scheduling state only — no payload snapshot. The bundle is
/// rebuilt from the clinical record at send time, so a diagnosis retracted
/// between close and submission is reported as corrected, not as signed.
/// One row per encounter: attempts increment in place, and the terminal
/// FAILED state is re-opened only by the admin retry surface (P10-T06).
model SatusehatSubmission {
  id                   String                    @id @default(uuid()) @db.Uuid
  encounterId          String                    @unique @map("encounter_id") @db.Uuid
  status               SatusehatSubmissionStatus @default(PENDING)
  attempts             Int                       @default(0)
  lastError            String?                   @map("last_error")
  /// Earliest instant the worker may (re)try; pushed forward exponentially on
  /// transient failures.
  nextAttemptAt        DateTime                  @default(now()) @map("next_attempt_at")
  lastAttemptAt        DateTime?                 @map("last_attempt_at")
  submittedAt          DateTime?                 @map("submitted_at")
  /// IHS Encounter id returned by the platform on success — the provenance
  /// link between the local record and the national one.
  satusehatEncounterId String?                   @map("satusehat_encounter_id")
  createdAt            DateTime                  @default(now()) @map("created_at")
  updatedAt            DateTime                  @updatedAt @map("updated_at")

  encounter Encounter @relation(fields: [encounterId], references: [id], onDelete: Restrict)

  @@index([status, nextAttemptAt])
  @@map("satusehat_submissions")
}

/// Append-only record of who touched patient-identifiable data (SJ-4). Rows
/// carry no `updatedAt` and no `deletedAt` because they are never modified: a
/// trigger installed by the migration rejects UPDATE/DELETE/TRUNCATE outright,
/// and SJ-11 additionally revokes those grants from the runtime role.
///
/// `actorUserId` deliberately has **no foreign key**. A relation would let a
/// hard `DELETE` on `users` rewrite history — `ON DELETE SET NULL` is an UPDATE
/// on this table — which is precisely what an immutable log must not permit,
/// and which the append-only trigger would turn into a failed user deletion.
/// `actorRole` is denormalised for the same reason: the answer to "what could
/// this person see at the time" must not change when their roles change later.
///
/// `patientId` is likewise denormalised rather than joined. It is the primary
/// query pattern — "who read this patient's chart, when" — and it is populated
/// even for resources that merely *reference* a patient (an encounter, a
/// prescription), so one index answers the question without a union across
/// every clinical table.
model AuditLog {
  id          String      @id @default(uuid()) @db.Uuid
  actorUserId String?     @map("actor_user_id") @db.Uuid
  actorRole   String?     @map("actor_role")
  action      AuditAction
  resource    String
  resourceId  String?     @map("resource_id")
  patientId   String?     @map("patient_id") @db.Uuid
  ipAddress   String?     @map("ip_address")
  metadata    Json?
  requestId   String?     @map("request_id")
  occurredAt  DateTime    @default(now()) @map("occurred_at")

  @@index([actorUserId, occurredAt])
  @@index([patientId, occurredAt])
  @@index([action, occurredAt])
  @@index([resource, resourceId])
  @@index([requestId])
  @@index([occurredAt])
  @@map("audit_logs")
}

/// BPJS PCare bridging credentials for one facility (P11-T02). Non-secret
/// identifiers are plaintext; the three secrets are sealed with AES-256-GCM
/// under BPJS_CREDENTIAL_ENCRYPTION_KEY and surface only as last-4 display
/// columns. `facilityId` is null on the single-tenant deployment — Postgres
/// unique indexes treat NULLs as distinct, so a hand-written partial unique
/// index in the migration is what actually keeps that row a singleton.
model BpjsPcareConfig {
  id                      String               @id @default(uuid()) @db.Uuid
  facilityId              String?              @unique @map("facility_id") @db.Uuid
  environment             BpjsPcareEnvironment
  consId                  String               @map("cons_id")
  kdProviderPpk           String               @map("kd_provider_ppk")
  pcareUsername           String               @map("pcare_username")
  secretKeyCiphertext     String               @map("secret_key_ciphertext")
  secretKeyLast4          String               @map("secret_key_last4")
  userKeyCiphertext       String               @map("user_key_ciphertext")
  userKeyLast4            String               @map("user_key_last4")
  pcarePasswordCiphertext String               @map("pcare_password_ciphertext")
  credentialKeyVersion    Int                  @default(1) @map("credential_key_version")
  isActive                Boolean              @default(true) @map("is_active")
  lastTestedAt            DateTime?            @map("last_tested_at")
  lastTestResult          String?              @map("last_test_result")
  createdAt               DateTime             @default(now()) @map("created_at")
  updatedAt               DateTime             @updatedAt @map("updated_at")

  @@map("bpjs_pcare_configs")
}

/// BPJS Antrean Online (Mobile JKN) bridging credentials for one facility
/// (P14-T03). A separate row from BpjsPcareConfig, not a column on it: BPJS
/// issues the Antrean service its own consumer ID, secret key, and user key
/// through a separate branch-office request, and revokes them separately —
/// losing one credential set must not disable the other (ADR D-023).
///
/// The outbound half (`consId`/`secretKey`/`userKey`) is what HMS signs its
/// calls to BPJS with. The inbound half (`inboundUsername`/
/// `inboundPasswordHash`) is the credential pair BPJS presents to the
/// facility's own token endpoint; it is nullable because it is agreed at UAT,
/// long after outbound credentials are first stored, and the endpoint that
/// consumes it is P14-T04. The password is hashed, never sealed — HMS only
/// ever verifies it, and must not be able to read it back.
///
/// Secrets are sealed with the same BpjsCredentialCryptoService under
/// BPJS_CREDENTIAL_ENCRYPTION_KEY as the PCare row, so one rotation runbook
/// covers both. `facilityId` is null on the single-tenant deployment — Postgres
/// unique indexes treat NULLs as distinct, so a hand-written partial unique
/// index in the migration is what actually keeps that row a singleton.
model BpjsAntreanConfig {
  id                   String                 @id @default(uuid()) @db.Uuid
  facilityId           String?                @unique @map("facility_id") @db.Uuid
  environment          BpjsAntreanEnvironment
  consId               String                 @map("cons_id")
  kdProviderPpk        String                 @map("kd_provider_ppk")
  secretKeyCiphertext  String                 @map("secret_key_ciphertext")
  secretKeyLast4       String                 @map("secret_key_last4")
  userKeyCiphertext    String                 @map("user_key_ciphertext")
  userKeyLast4         String                 @map("user_key_last4")
  inboundUsername      String?                @map("inbound_username")
  inboundPasswordHash  String?                @map("inbound_password_hash")
  credentialKeyVersion Int                    @default(1) @map("credential_key_version")
  isActive             Boolean                @default(true) @map("is_active")
  lastTestedAt         DateTime?              @map("last_tested_at")
  lastTestResult       String?                @map("last_test_result")
  createdAt            DateTime               @default(now()) @map("created_at")
  updatedAt            DateTime               @updatedAt @map("updated_at")

  @@map("bpjs_antrean_configs")
}

/// One row of a BPJS PCare reference catalog (P11-T03). The design doc lists
/// eight tables, but every catalog carries the identical shape (BPJS code,
/// display name, syncedAt), so they land as one enum-keyed table — the sync,
/// search, and mapping-validation surfaces stay generic instead of being
/// stamped out eight times. Rows are replaced wholesale per catalog on each
/// admin-triggered sync (POLI/DOKTER/KESADARAN/TINDAKAN/SPESIALIS/SARANA) or
/// upserted incrementally by keyword search-and-cache (DIAGNOSA/DPHO, whose
/// PCare endpoints are keyword lookups and cannot be enumerated). Dropdowns
/// and mapping screens read only this table — never live BPJS calls.
model BpjsReferenceItem {
  id        String               @id @default(uuid()) @db.Uuid
  catalog   BpjsReferenceCatalog
  code      String
  display   String
  /// Catalog-specific qualifier: for TINDAKAN rows the kdTkp bucket the row
  /// was fetched under ('10' rawat jalan, '20' rawat inap, '50' promotif);
  /// null for every other catalog.
  groupCode String?              @map("group_code")
  syncedAt  DateTime             @map("synced_at")
  createdAt DateTime             @default(now()) @map("created_at")
  updatedAt DateTime             @updatedAt @map("updated_at")

  @@unique([catalog, code])
  @@index([catalog, display])
  @@map("bpjs_reference_items")
}

/// One BPJS eligibility (peserta) check outcome per patient per clinic-local
/// day (P11-T04). The front desk needs the answer synchronously, so the day
/// cache keeps repeat check-ins from hammering PCare; a transient "BPJS
/// unreachable" state is never persisted — only definitive outcomes land
/// here. Member fields mirror what the eligibility card renders (name,
/// class, member type, registered FKTP, Prolanis/PRB flags) and carry no
/// card number: the BPJS number stays sealed on the patient profile.
model BpjsEligibilityCheck {
  id               String                        @id @default(uuid()) @db.Uuid
  patientId        String                        @map("patient_id") @db.Uuid
  checkedDate      DateTime                      @map("checked_date") @db.Date
  outcome          BpjsEligibilityOutcome
  checkedVia       BpjsEligibilityIdentifierType @map("checked_via")
  memberName       String?                       @map("member_name")
  memberType       String?                       @map("member_type")
  memberClass      String?                       @map("member_class")
  providerCode     String?                       @map("provider_code")
  providerName     String?                       @map("provider_name")
  isRegisteredHere Boolean?                      @map("is_registered_here")
  isProlanis       Boolean                       @default(false) @map("is_prolanis")
  isPrb            Boolean                       @default(false) @map("is_prb")
  /// BPJS's own readable reason (ketAktif for inactive members, the upstream
  /// rejection message for NOT_FOUND) — shown verbatim on the card.
  statusReason     String?                       @map("status_reason")
  checkedAt        DateTime                      @map("checked_at")
  createdAt        DateTime                      @default(now()) @map("created_at")
  updatedAt        DateTime                      @updatedAt @map("updated_at")

  patient PatientProfile @relation(fields: [patientId], references: [id], onDelete: Restrict)

  @@unique([patientId, checkedDate])
  @@index([checkedDate])
  @@map("bpjs_eligibility_checks")
}

/// BPJS PCare submission outbox (P11-T05), mirroring SatusehatSubmission:
/// rows are enqueued transactionally with the visit event they report
/// (PENDAFTARAN on check-in, KUNJUNGAN on encounter close,
/// PENDAFTARAN_DELETE when an already-submitted registration is cancelled)
/// and drained by a polling worker. All three types key on the registration
/// — the kunjungan reaches its encounter through the registration's 1:1
/// relation — so unique (registrationId, type) is the idempotency guarantee.
/// No payload snapshot is stored: builders re-read the clinical record at
/// send time. `bpjsReferenceNo` holds PCare's returned noUrut/noKunjungan;
/// `submittedKdPoli` pins the poli code the pendaftaran actually went out
/// with, because the DELETE path must name that code even if the admin
/// remaps the specialty in between.
model BpjsSubmission {
  id              String               @id @default(uuid()) @db.Uuid
  registrationId  String               @map("registration_id") @db.Uuid
  type            BpjsSubmissionType
  status          BpjsSubmissionStatus @default(PENDING)
  attempts        Int                  @default(0)
  lastError       String?              @map("last_error")
  nextAttemptAt   DateTime             @default(now()) @map("next_attempt_at")
  lastAttemptAt   DateTime?            @map("last_attempt_at")
  submittedAt     DateTime?            @map("submitted_at")
  bpjsReferenceNo String?              @map("bpjs_reference_no")
  submittedKdPoli String?              @map("submitted_kd_poli")
  createdAt       DateTime             @default(now()) @map("created_at")
  updatedAt       DateTime             @updatedAt @map("updated_at")

  registration Registration @relation(fields: [registrationId], references: [id], onDelete: Restrict)

  @@unique([registrationId, type])
  @@index([status, nextAttemptAt])
  @@map("bpjs_submissions")
}

/// A BPJS PCare referral (rujukan) recorded by the attending doctor before
/// the encounter closes (P11-T06). PCare has no standalone rujukan create —
/// it rides the kunjungan payload (ADR D-022) — so this row only captures
/// what the doctor decided; the submission service folds it into the
/// kunjungan when the outbox row is sent, flipping the discharge status to
/// rujuk lanjut. One of subSpecialtyCode (subspesialis referral) or
/// khususCode (TACC/khusus referral) must be present; codes are sent as
/// recorded — PCare is the validator of record for referral codes, since
/// the subspesialis catalog is per-specialty and not fully synced locally.
/// Soft-deleted like the other clinical rows so history survives edits.
model BpjsReferral {
  id                      String    @id @default(uuid()) @db.Uuid
  encounterId             String    @unique @map("encounter_id") @db.Uuid
  /// Destination FKRTL provider code (kdppk).
  destinationProviderCode String    @map("destination_provider_code")
  subSpecialtyCode        String?   @map("sub_specialty_code")
  saranaCode              String?   @map("sarana_code")
  khususCode              String?   @map("khusus_code")
  /// tglEstRujuk — the planned referral date shown on the PCare letter.
  estimatedReferralDate   DateTime  @map("estimated_referral_date") @db.Date
  notes                   String?
  recordedById            String?   @map("recorded_by_id") @db.Uuid
  createdAt               DateTime  @default(now()) @map("created_at")
  updatedAt               DateTime  @updatedAt @map("updated_at")
  deletedAt               DateTime? @map("deleted_at")

  encounter  Encounter @relation(fields: [encounterId], references: [id], onDelete: Cascade)
  recordedBy User?     @relation("BpjsReferralRecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)

  @@index([deletedAt])
  @@map("bpjs_referrals")
}

/// A clinic's upstream AI credentials and model defaults (P13-T01). HMS ships
/// no vendor of its own: the admin picks a kind, supplies a key, and every
/// chat turn is routed to that endpoint. Several configs may coexist so an
/// admin can stage a replacement and test it before cutting over, but exactly
/// one is live — enforced by a hand-written partial unique index on
/// (facilityId, isActive) in the migration, since Prisma cannot express one.
///
/// `facilityId` is nullable for the same reason as BpjsPcareConfig: HMS ships
/// single-facility, so the live deployment holds one facility-less row, and a
/// multi-facility build fills the column in without a table rewrite. The
/// partial index coalesces NULL to the nil-UUID sentinel (same convention as
/// MrnCounter) so the facility-less case is covered by the same guarantee
/// rather than slipping through Postgres's NULLs-are-distinct rule.
///
/// The API key exists here only as ciphertext (AES-256-GCM, per-row IV,
/// `credentialKeyVersion` naming which master key sealed it — mirrors
/// BpjsPcareConfig so one rotation runbook covers both). `apiKeyHint` holds
/// the last four plaintext characters purely so the admin UI can tell two keys
/// apart; it is never enough to reconstruct one. Nothing decrypted is ever
/// returned by an endpoint or written to a log.
model AiProviderConfig {
  id                   String         @id @default(uuid()) @db.Uuid
  facilityId           String?        @map("facility_id") @db.Uuid
  providerKind         AiProviderKind @map("provider_kind")
  /// Admin-facing label, e.g. "Clinic GPT-4o" — free text, not an identifier.
  displayName          String         @map("display_name")
  apiKeyCiphertext     String         @map("api_key_ciphertext")
  apiKeyHint           String         @map("api_key_hint")
  credentialKeyVersion Int            @default(1) @map("credential_key_version")
  /// Endpoint override. Required for OPENAI_COMPATIBLE and AZURE_OPENAI (no
  /// sensible default exists); optional elsewhere, where the adapter falls
  /// back to the vendor's published base URL. Validated in the service layer,
  /// not the database, because the rule is per-kind.
  baseUrl              String?        @map("base_url")
  defaultModel         String         @map("default_model")
  /// Whether this is the config chat traffic actually routes to.
  isActive             Boolean        @default(false) @map("is_active")
  /// Master switch. When false the chat endpoints answer AI_NOT_CONFIGURED
  /// instead of calling the upstream — how a clinic pauses AI without losing
  /// its credentials.
  isEnabled            Boolean        @default(true) @map("is_enabled")
  maxTokens            Int            @default(2048) @map("max_tokens")
  timeoutMs            Int            @default(30000) @map("timeout_ms")
  lastTestedAt         DateTime?      @map("last_tested_at")
  lastTestResult       String?        @map("last_test_result")
  createdById          String?        @map("created_by_id") @db.Uuid
  updatedById          String?        @map("updated_by_id") @db.Uuid
  createdAt            DateTime       @default(now()) @map("created_at")
  updatedAt            DateTime       @updatedAt @map("updated_at")
  deletedAt            DateTime?      @map("deleted_at")

  createdBy User? @relation("AiProviderConfigCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy User? @relation("AiProviderConfigUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([facilityId, isActive])
  @@index([deletedAt])
  @@map("ai_provider_configs")
}

/// One chatbot conversation, owned by the user who started it (P13-T01).
/// `ownerUserId` is the anchor every `:own` RBAC scope filters on, and it is
/// `onDelete: Restrict` because a session is an audit record of what a patient
/// was told — deleting the account must not erase it.
///
/// `providerKey` records which credential set answered this conversation. It
/// is a plain string rather than a foreign key on purpose: a config can be
/// soft-deleted or rotated away while the transcript lives on, and the
/// deployment-level env fallback (single-tenant dev) has no config row at all,
/// so an FK would either block those cases or force the column nullable and
/// lose the audit trail. `providerKind` is denormalized next to it so
/// analytics and support filtering never need the config row to still exist.
model ChatSession {
  id                String         @id @default(uuid()) @db.Uuid
  ownerUserId       String         @map("owner_user_id") @db.Uuid
  channel           ChatChannel    @default(PATIENT)
  providerKey       String         @map("provider_key")
  providerKind      AiProviderKind @map("provider_kind")
  providerSessionId String?        @map("provider_session_id")
  providerMetadata  Json?          @map("provider_metadata")
  /// Auto-generated from the first user message; optional so a session exists
  /// before anything has been said.
  title             String?
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")
  deletedAt         DateTime?      @map("deleted_at")

  ownerUser User          @relation("ChatSessionOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  messages  ChatMessage[]

  @@index([ownerUserId])
  @@index([providerKey])
  @@index([channel])
  @@map("chat_sessions")
}

/// One turn in a conversation — append-only. Messages carry no `updatedAt` or
/// `deletedAt` because an edited or vanishing assistant turn would defeat the
/// point of keeping them: PMK 24/2022 retention and the UU PDP audit trail
/// both need the exact text the patient saw. Sessions soft-delete; their
/// messages cascade only when the session row itself is hard-deleted by a
/// retention job.
///
/// The provider columns are the audit trail for an external call HMS cannot
/// replay: which vendor and model answered, the upstream request id to quote
/// in a support ticket, and how long it took. `disclaimerShown` is persisted
/// rather than inferred so the safety guarantee is provable per message, and
/// `safetyTags` records what the guards caught (e.g. `["diagnosis_attempt"]`).
model ChatMessage {
  id                 String          @id @default(uuid()) @db.Uuid
  sessionId          String          @map("session_id") @db.Uuid
  /// Null for ASSISTANT and SYSTEM turns, which have no human author.
  authorUserId       String?         @map("author_user_id") @db.Uuid
  actor              ChatActor
  content            String          @db.Text
  providerKind       AiProviderKind? @map("provider_kind")
  providerRequestId  String?         @map("provider_request_id")
  providerMessageId  String?         @map("provider_message_id")
  providerModel      String?         @map("provider_model")
  providerStatusCode Int?            @map("provider_status_code")
  providerLatencyMs  Int?            @map("provider_latency_ms")
  providerMetadata   Json?           @map("provider_metadata")
  disclaimerShown    Boolean         @default(false) @map("disclaimer_shown")
  safetyTags         Json?           @map("safety_tags")
  createdAt          DateTime        @default(now()) @map("created_at")

  session    ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  authorUser User?       @relation("ChatMessageAuthor", fields: [authorUserId], references: [id], onDelete: SetNull)

  @@index([sessionId, createdAt])
  @@index([authorUserId])
  @@index([providerRequestId])
  @@index([providerMessageId])
  @@map("chat_messages")
}

/// Who a document belongs to (ai-chatbot-tools.md §5.5, customer-service
/// strategy §4.3). `CLINIC` is the admin-managed corpus every channel may
/// see; `DOCTOR` and `ADMIN` are personal knowledge bases private to their
/// owner. `PATIENT` exists for the future patient-document feature and is
/// deliberately never retrievable — a patient has no knowledge base in this
/// phase, and the value being present now is what keeps that a policy
/// addition rather than a migration.
enum DocumentOwnerType {
  CLINIC
  PATIENT
  DOCTOR
  ADMIN
}

/// What a document is for. Only the two knowledge-base purposes are ingested
/// into chunks; `GENERAL` is stored and served but never embedded, which is
/// how the future document features share this table without joining the
/// retrieval corpus by accident.
enum DocumentPurpose {
  FAQ_KNOWLEDGE_BASE
  PERSONAL_KNOWLEDGE_BASE
  GENERAL
}

/// Where a document is in the extract → chunk → embed pipeline.
/// `NOT_APPLICABLE` is the resting state of a `GENERAL` document, and is
/// distinct from `PENDING` on purpose: "nothing will ever ingest this" and
/// "ingestion has not run yet" are different facts, and only one of them is a
/// reason to look at a queue.
enum DocumentIngestStatus {
  PENDING
  PROCESSING
  READY
  FAILED
  NOT_APPLICABLE
}

/// Which chat channel may retrieve a clinic-corpus chunk. A staff-only SOP
/// must never surface in a patient answer, and this column is the
/// enforcement. It carries no meaning for a personal knowledge base, where
/// owner scoping already decides everything.
enum DocumentVisibility {
  PATIENT
  DOCTOR
  BOTH
}

/// The language a document is written in. Retrieval is deliberately **not**
/// filtered by it — cross-lingual matching is the entire reason for vectors
/// (§5.2) — but it drives citation display, so a reader knows a translation
/// happened, and it makes evaluation coverage measurable per language.
enum DocumentLanguage {
  ID
  EN
}

/// One stored file in the shared document store. This table serves the clinic
/// FAQ corpus, the Phase 15 retrieval corpora, personal knowledge bases, and
/// the future patient/doctor document features — one ingestion pipeline, one
/// embedding space, one S3 layout (customer-service strategy D-CS-06).
///
/// Only `storageKey` is persisted, never a URL: every download is a
/// short-lived signed URL minted per response (D-018). Soft delete follows
/// repo convention; chunks cascade on the hard delete a retention job
/// performs, and are removed explicitly on soft delete so a deleted document
/// leaves the retrieval candidate set immediately.
model Document {
  id           String               @id @default(uuid()) @db.Uuid
  ownerType    DocumentOwnerType    @map("owner_type")
  /// Null for the clinic corpus; the owning user for a personal knowledge
  /// base. The retrieval query filters on this column rather than trusting
  /// ranking — another doctor's document is not in the candidate set at all.
  ownerId      String?              @map("owner_id") @db.Uuid
  purpose      DocumentPurpose
  title        String
  storageKey   String               @map("storage_key")
  mimeType     String               @map("mime_type")
  sizeBytes    Int                  @map("size_bytes")
  visibility   DocumentVisibility   @default(BOTH)
  language     DocumentLanguage     @default(ID)
  ingestStatus DocumentIngestStatus @default(NOT_APPLICABLE) @map("ingest_status")
  /// Why the last ingestion failed, for the admin screen. Never carries file
  /// content — an extraction error must not become a way to read a document
  /// the reader could not otherwise open.
  ingestError  String?              @map("ingest_error")
  ingestedAt   DateTime?            @map("ingested_at")
  uploadedById String               @map("uploaded_by_id") @db.Uuid
  createdAt    DateTime             @default(now()) @map("created_at")
  updatedAt    DateTime             @updatedAt @map("updated_at")
  deletedAt    DateTime?            @map("deleted_at")

  uploadedBy User            @relation("DocumentUploadedBy", fields: [uploadedById], references: [id], onDelete: Restrict)
  owner      User?           @relation("DocumentOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  chunks     DocumentChunk[]

  /// One row per stored object. Confirming an upload is the only way a row
  /// is created, and a client that retries the confirm — or replays it —
  /// would otherwise attach a second document to the same file, so deleting
  /// "the" document would leave the other one still serving it. Keys are
  /// server-minted UUIDs and never reused, so this constrains nothing an
  /// honest flow does.
  @@unique([storageKey])
  @@index([ownerType, ownerId])
  @@index([purpose, ingestStatus])
  @@index([uploadedById])
  @@map("documents")
}

/// One embedded passage of a document — the unit retrieval actually returns.
///
/// `visibility` and `language` are copied from the parent at ingest rather
/// than joined at query time: the retrieval query filters and ranks in one
/// pass over this table, and a join to `documents` for every candidate is
/// what turns an index scan into a plan nobody wants to tune. The parent
/// remains the source of truth, and re-ingesting is what republishes them.
///
/// `embeddingModel` and `embeddingVersion` are not bookkeeping. Without them
/// a model swap silently mixes incompatible vector spaces and retrieval just
/// gets worse with no error at all — the worst available failure mode,
/// because it reads as the feature degrading rather than breaking
/// (ai-chatbot-tools.md §5.4).
///
/// `embedding` and `searchVector` are managed in raw SQL: Prisma can express
/// neither `vector(1024)` nor `tsvector`, so both are declared `Unsupported`
/// here — the schema stays honest about which columns exist — and are written
/// through raw queries in the repository, in the same statement that writes
/// `content`. A `GENERATED ALWAYS AS` column would keep the two in step
/// without that discipline, but Prisma models a generated column as a plain
/// default and CI's `migrate diff --exit-code` drift gate then fails on every
/// run. Chunks are insert-only — re-ingesting replaces the whole set — so
/// writing both columns in one statement is sufficient.
model DocumentChunk {
  id               String                       @id @default(uuid()) @db.Uuid
  documentId       String                       @map("document_id") @db.Uuid
  chunkIndex       Int                          @map("chunk_index")
  content          String
  embedding        Unsupported("vector(1024)")?
  searchVector     Unsupported("tsvector")?     @map("search_vector")
  embeddingModel   String                       @map("embedding_model")
  embeddingVersion String                       @map("embedding_version")
  visibility       DocumentVisibility           @default(BOTH)
  language         DocumentLanguage             @default(ID)
  createdAt        DateTime                     @default(now()) @map("created_at")

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, chunkIndex])
  @@index([documentId])
  @@index([searchVector], type: Gin)
  @@map("document_chunks")
}

/// Which messaging channel a customer-service conversation runs on
/// (customer-service strategy §4.1). Telegram ships first as the pilot
/// (D-CS-05); WhatsApp joins at `PCS-T09`.
enum ChannelKind {
  WHATSAPP
  TELEGRAM

  @@map("channel_kind")
}

/// Proof that one inbound gateway message has already been taken in.
///
/// **Dedup is mandatory and it lives at the edge** (strategy §4.1): every
/// gateway here retries a webhook it did not get a 2xx for, and a retried
/// booking message that reached the tool loop twice books twice. The row is
/// written before any business logic runs, so the second delivery is refused
/// by the database rather than by a check somebody has to remember to write.
///
/// The unique key is over **three** columns, not the two §4.1 sketched.
/// Telegram's `message_id` counts up per chat rather than per bot, so two
/// customers hold the same id within minutes of each other, and
/// `(channel, externalMessageId)` would drop the second customer's message as
/// a duplicate of the first's. Including the chat is what makes the constraint
/// mean "this message, from this conversation" — see the amendment note in
/// §4.1.
///
/// Rows are insert-only and carry **no message body**: this table answers "did
/// we already handle this?" and nothing else, so a retention sweep can drop it
/// on a much shorter clock than the transcript without losing anything.
model ChannelInboundReceipt {
  id                String      @id @default(uuid()) @db.Uuid
  channel           ChannelKind
  externalChatId    String      @map("external_chat_id")
  externalMessageId String      @map("external_message_id")
  /// The channel's own timestamp, not arrival time — a gateway that buffers
  /// during an outage delivers old messages, and ordering by arrival would
  /// reorder a conversation.
  sentAt            DateTime    @map("sent_at")
  createdAt         DateTime    @default(now()) @map("created_at")

  @@unique([channel, externalChatId, externalMessageId])
  @@index([createdAt])
  @@map("channel_inbound_receipts")
}

/// Where a customer-service conversation is in its lifecycle
/// (customer-service strategy §4.2).
///
/// The states exist to answer one question on every inbound message: **may
/// the LLM see this?** Only `BOT_ACTIVE` says yes. While a conversation waits
/// for a human, or waits for an OTP, messages are still persisted — the
/// transcript stays complete — but they are never sent to a provider, which
/// is what makes "prompt injection cannot talk its way past a handoff" true
/// by construction rather than by prompt.
enum ConversationState {
  BOT_ACTIVE
  NEEDS_HUMAN
  HUMAN_ACTIVE
  AWAITING_OTP
  ARCHIVED

  @@map("conversation_state")
}

/// Who produced one transcript turn. `SYSTEM` covers the deterministic
/// templates this codebase authored — emergency, medical referral, redaction
/// notice — which are deliberately distinguished from `BOT`: a reply that
/// never reached a provider is a different fact for an auditor than one the
/// model composed.
enum ConversationMessageRole {
  CUSTOMER
  BOT
  ADMIN
  SYSTEM

  @@map("conversation_message_role")
}

/// One customer's conversation on one channel.
///
/// Keyed by `(channel, externalChatId)` because that pair *is* the customer
/// as far as this channel knows — principle 1: a WhatsApp number identifies a
/// conversation, not a verified person. There is no user id here and there
/// must not be one until §5.1.1 verification supplies it.
model Conversation {
  id                String            @id @default(uuid()) @db.Uuid
  channel           ChannelKind
  externalChatId    String            @map("external_chat_id")
  /// Whatever the channel offered as a name, never trusted as identity — it
  /// exists so an admin reading the handoff queue sees something other than
  /// a number.
  senderDisplayName String?           @map("sender_display_name")
  state             ConversationState @default(BOT_ACTIVE)
  /// Whether the one-time automated-assistant notice (§8.2) has been sent.
  /// A column rather than a scan of the transcript: the check runs on every
  /// inbound message, and "has this conversation ever seen the notice" must
  /// not get slower as the conversation grows.
  hasSentNotice     Boolean           @default(false) @map("has_sent_notice")
  /// When an admin blocked this chat (`PCS-T08`, §8.3). Non-null means every
  /// further inbound message is dropped before persistence and before any
  /// provider call.
  ///
  /// A nullable column rather than a sixth `ConversationState`, because a
  /// block is a policy overlay and a state is a position in a lifecycle: an
  /// admin who blocks a `HUMAN_ACTIVE` chat must not lose the fact that a
  /// colleague was mid-conversation, and unblocking must return the chat to
  /// where it was rather than to a guess. The pair also answers "who decided
  /// this", which a state transition on an append-only-free table cannot.
  blockedAt         DateTime?         @map("blocked_at")
  blockedById       String?           @map("blocked_by_id") @db.Uuid
  lastMessageAt     DateTime          @map("last_message_at")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  messages      ConversationMessage[]
  otpChallenges ChannelOtpChallenge[]
  blockedBy     User?                 @relation("ConversationBlockedBy", fields: [blockedById], references: [id], onDelete: SetNull)

  @@unique([channel, externalChatId])
  @@index([state, lastMessageAt])
  /// The inbox's default ordering, and the only query the list screen runs
  /// when no state filter is applied.
  @@index([lastMessageAt])
  @@map("conversations")
}

/// One turn of a conversation transcript.
///
/// **Append-only, with the same discipline as `ChatMessage`** (§8.2): no
/// update and no delete on message rows, because a transcript that can be
/// edited is not evidence of what was said. Retention is handled by dropping
/// whole conversations on the §8.5 clock, not by rewriting turns.
///
/// `content` is stored **post-redaction**. If a customer volunteers a NIK,
/// the digits never reach this table — redaction happens before persistence
/// and before the provider, so the transcript cannot become the copy of the
/// identifier that outlives the message (§5.3).
model ConversationMessage {
  id             String                  @id @default(uuid()) @db.Uuid
  conversationId String                  @map("conversation_id") @db.Uuid
  role           ConversationMessageRole
  content        String
  /// Which staff member wrote an `ADMIN` turn (`PCS-T08`). Null on every
  /// other role, because nobody wrote them.
  ///
  /// `SetNull` rather than `Restrict`: the transcript must survive a leaver,
  /// and a turn whose author left is still an accurate record of what the
  /// customer was told. The name is resolved at read time from the user row
  /// rather than copied here, so an admin who is renamed is not shown under
  /// two names across one conversation.
  authorUserId   String?                 @map("author_user_id") @db.Uuid
  /// Which guards fired on this turn, so the §8.4 review can count what was
  /// actually caught in production rather than trusting it was never needed.
  safetyTags     String[]                @default([]) @map("safety_tags")
  createdAt      DateTime                @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  author       User?        @relation("ConversationMessageAuthor", fields: [authorUserId], references: [id], onDelete: SetNull)

  @@index([conversationId, createdAt])
  @@map("conversation_messages")
}

/// How firmly a chat is tied to the patient record it claims (strategy
/// §5.1.1, D-CS-08).
///
/// A phone-number match is a *claim*, not proof: anyone who knows a patient's
/// number could otherwise book against — and later probe — their record. The
/// three values are the three tiers of possession proof, cheapest first.
enum ChannelVerificationStatus {
  /// The customer gave a number; nothing has proved they hold it. A booking
  /// under this status never attaches to an existing patient.
  UNVERIFIED
  /// The channel identity *is* the number: a WhatsApp JID that equals the
  /// registered number, proved by WhatsApp itself. Lands with `PCS-T09`.
  CHANNEL_VERIFIED
  /// Proved by typing back a code sent to the registered number, or by
  /// sharing a Telegram-verified contact card.
  OTP_VERIFIED

  @@map("channel_verification_status")
}

/// What one chat has told us about who it belongs to (strategy §5.1).
///
/// The name and phone number here are **customer-typed**, never registry data.
/// `patientId` is null until §5.1.1 verification succeeds, and that is the
/// whole point of the table: the link between a chat and a real record is a
/// thing that has to be *earned*, and having a row to hold the unearned state
/// is what keeps the earned one from being assumed.
///
/// **Verification unlocks linkage only, not data access.** A verified
/// customer's bookings attach to their real record; the chat still cannot read
/// anything from it, because the tool surface (§4.2) has no tool that reads a
/// patient.
model ChannelPatientLink {
  id                 String                    @id @default(uuid()) @db.Uuid
  channel            ChannelKind
  externalChatId     String                    @map("external_chat_id")
  /// Normalized to E.164-ish digits before storage, because a match against
  /// the registry is an exact string comparison and `0812…` / `+62812…` are
  /// the same number written two ways.
  phoneNumber        String                    @map("phone_number")
  fullName           String                    @map("full_name")
  patientId          String?                   @map("patient_id") @db.Uuid
  verificationStatus ChannelVerificationStatus @default(UNVERIFIED) @map("verification_status")
  verifiedAt         DateTime?                 @map("verified_at")
  createdAt          DateTime                  @default(now()) @map("created_at")
  updatedAt          DateTime                  @updatedAt @map("updated_at")

  patient PatientProfile? @relation(fields: [patientId], references: [id], onDelete: SetNull)

  /// One row per (chat, claimed number): the same customer may legitimately
  /// book for themselves and for a family member from one chat, and those are
  /// two different claims about two different people.
  @@unique([channel, externalChatId, phoneNumber])
  @@index([patientId])
  @@map("channel_patient_links")
}

/// Where a prospective patient's booking ended up (`P17-T01`).
enum ProspectivePatientStatus {
  AWAITING_ARRIVAL
  /// Became a new `PatientProfile` at the counter, which is where the MRN was
  /// finally allocated.
  CONVERTED
  /// Matched to a `PatientProfile` that already existed -- the merge case
  /// `PCS-T08` already implements.
  LINKED
  /// Never arrived. No MRN was ever spent and no medical record was created,
  /// which is the whole point of the table.
  EXPIRED

  @@map("prospective_patient_status")
}

/// Someone who asked for an appointment through a messaging channel and has
/// not yet arrived (`P17-T01`).
///
/// Deliberately **not** a `PatientProfile`, and the three reasons are the
/// argument for the whole table. A chat booking used to create one, so an MRN
/// was issued to anyone who typed a name and a phone number into WhatsApp and
/// the sequence never reused it; a medical record existed -- kept twenty-five
/// years under PMK 24/2022 -- for somebody who may have been a wrong number;
/// and `dateOfBirth`, `sex` and `address` are nullable on a clinical record
/// *only* so that row could exist.
///
/// The chatbot may collect a name and a phone number and nothing else
/// (`PCS-T07`, strategy 5.1), and that is exactly what this table requires.
/// Everything a clinical record needs is collected at the counter, where a
/// human is looking at an ID document, and the MRN is allocated there.
///
/// `P17-T02` landed the appointment side: `Appointment.prospectivePatientId`
/// and the CHECK that exactly one of the two patient keys is set. Nothing
/// *writes* a prospective booking until `P17-T03` repoints the chat path at
/// it, so every appointment in the database still names a real patient today.
model ProspectivePatient {
  id             String                   @id @default(uuid()) @db.Uuid
  fullName       String                   @map("full_name")
  /// Normalised by `normalizePhoneNumber` before storage, the same way
  /// `ChannelPatientLink.phoneNumber` is, so the arrival match against the
  /// registry stays an exact comparison rather than four spellings of one
  /// number.
  phoneNumber    String                   @map("phone_number")
  channel        ChannelKind
  externalChatId String?                  @map("external_chat_id")
  status         ProspectivePatientStatus @default(AWAITING_ARRIVAL)
  /// Set when the record becomes, or is matched to, a real patient. The row is
  /// kept rather than deleted: it is how a second booking from the same number
  /// resolves to the same person next time, and it is the provenance of that
  /// patient's first contact with the clinic.
  patientId      String?                  @map("patient_id") @db.Uuid
  convertedAt    DateTime?                @map("converted_at")
  /// The front-desk user who resolved it. A plain id rather than a relation,
  /// as every other actor column in this schema is.
  convertedById  String?                  @map("converted_by_id") @db.Uuid
  /// When an unresolved record stops being kept.
  ///
  /// A booking enquiry is **not** clinical data, so the 25-year RME floor does
  /// not apply to it and must not be applied. What governs it is UU PDP
  /// 27/2022, and the answer that shape takes is
  /// `CS_PROSPECTIVE_PATIENT_RETENTION_DAYS` -- 90 days by default, long
  /// enough for a booking made well ahead and two reschedules, short enough
  /// that the clinic is not holding a list of strangers' phone numbers
  /// indefinitely. A `LINKED` or `CONVERTED` row is past this date and stays.
  expiresAt      DateTime                 @map("expires_at")
  createdAt      DateTime                 @default(now()) @map("created_at")
  updatedAt      DateTime                 @updatedAt @map("updated_at")

  patient      PatientProfile? @relation(fields: [patientId], references: [id], onDelete: SetNull)
  appointments Appointment[]

  /// The expiry sweep's only question: which unresolved rows are past their
  /// date. Leading with `status` keeps the scan off the `CONVERTED` and
  /// `LINKED` rows, which accumulate forever and are never its answer.
  @@index([status, expiresAt])
  @@index([phoneNumber])
  @@index([patientId])
  @@map("prospective_patients")
}

/// One outstanding possession challenge and the booking it is holding open
/// (strategy §5.1.1, §8.3).
///
/// **The code is never stored in the clear** — only a salted hash — for the
/// same reason a password is not: this row is readable by anything that can
/// read the database, and a live code is a working credential against someone
/// else's patient record for the next five minutes.
///
/// The pending booking rides on the challenge as explicit columns rather than
/// a JSON blob. The customer must not have to retype their choice after
/// verifying, and the fields are exactly the ones `book_appointment` accepts,
/// so a typed column per field is what stops a schema change to the tool from
/// silently leaving a stale shape in this table.
/// Which of §5.1.1's proofs a challenge is waiting for.
///
/// Both pause the conversation in `AWAITING_OTP` and both are resolved by a
/// comparison rather than by a model, which is why they share a state and a
/// table: the state's meaning is "waiting for possession proof", and the tier
/// only decides what arriving evidence looks like.
enum ChannelVerificationMethod {
  /// Telegram's `request_contact` card — one tap, no code, no delivery
  /// dependency. The only tier that works on the Telegram pilot.
  CONTACT_SHARE
  /// A code sent to the registered number. Needs a delivery transport, which
  /// `PCS-T09` binds.
  OTP

  @@map("channel_verification_method")
}

model ChannelOtpChallenge {
  id             String                    @id @default(uuid()) @db.Uuid
  conversationId String                    @map("conversation_id") @db.Uuid
  method         ChannelVerificationMethod @default(OTP)
  /// The record the challenge is trying to prove possession of. Never told to
  /// the customer, and never revealed by a reply (§5.1.1 — no registry
  /// oracle).
  patientId      String                    @map("patient_id") @db.Uuid
  /// Null for `CONTACT_SHARE`, where there is no code to hash — the evidence
  /// is a card Telegram signed, not a secret this clinic minted.
  codeHash       String?                   @map("code_hash")
  attemptsUsed   Int                       @default(0) @map("attempts_used")
  expiresAt      DateTime                  @map("expires_at")
  /// Set when the challenge is spent — verified, exhausted, or abandoned — so
  /// a conversation has at most one live challenge and a spent code can never
  /// be replayed.
  consumedAt     DateTime?                 @map("consumed_at")
  createdAt      DateTime                  @default(now()) @map("created_at")

  // The booking held open while the customer proves possession.
  patientFullName String   @map("patient_full_name")
  phoneNumber     String   @map("phone_number")
  doctorId        String   @map("doctor_id") @db.Uuid
  scheduleId      String   @map("schedule_id") @db.Uuid
  sessionDate     DateTime @map("session_date") @db.Date
  note            String?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  /// Answers both live-challenge lookup and §8.3's "max 3 challenges per chat
  /// per day" count from one index.
  @@index([conversationId, createdAt])
  @@map("channel_otp_challenges")
}

/// Whether a bed can take a patient. MAINTENANCE is deliberately distinct from
/// a soft-deleted bed: a bed being cleaned or repaired is still inventory the
/// occupancy board must show, while a deleted one has left the ward.
enum BedStatus {
  AVAILABLE
  OCCUPIED
  MAINTENANCE

  @@map("bed_status")
}

/// CANCELLED when the admission was opened in error. Like `EncounterStatus`,
/// a settled admission is never re-opened — a correction is a new admission,
/// so the original stays auditable.
enum AdmissionStatus {
  ADMITTED
  DISCHARGED
  CANCELLED

  @@map("admission_status")
}

/// Room class (kelas perawatan) — the axis Indonesian clinics price
/// accommodation on, as **master data the clinic owns** rather than an enum
/// the vendor ships.
///
/// It started as an enum of the four classes BPJS recognises. That was wrong
/// for the same reason `Specialty` is a table and not an enum: a clinic with a
/// "Suite" or a "Kelas 3B" would need a migration, a redeploy, and a new
/// `ServiceTariffCategory` value to sell a bed it already has. What the four
/// standard classes get instead is a seeded baseline — present on every fresh
/// database, editable and extendable from the admin screen.
///
/// `code` is the stable handle the seed converges on and the tariff table
/// points at; `name` is what staff read and what a clinic may rename freely.
/// Unique among live rows only, so a retired class frees its code — the same
/// partial-index technique as {@link Ward.code}.
model RoomClass {
  id          String    @id @default(uuid()) @db.Uuid
  code        String
  name        String
  description String?
  /// How many beds the clinic plans to run in this class, clinic-wide. Null
  /// means uncapped, which is why it is nullable rather than defaulted: a
  /// clinic that has not thought about a ceiling must not be given one, and
  /// zero would mean "no beds allowed" rather than "no limit". When it is set,
  /// bed creation refuses to exceed it — a quota nothing checks is decoration.
  quota       Int?
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  rooms          Room[]
  serviceTariffs ServiceTariff[]

  @@index([isActive])
  @@index([deletedAt])
  @@map("room_classes")
}

/// Inpatient ward (bangsal) — the root of the room inventory tree
/// Ward → Room → Bed (IMP-11).
///
/// Master data, so soft-deleted rather than deleted: a discharged admission
/// keeps pointing at the bed it used, and a ward that closes must not take its
/// own history with it. `code` is what staff say out loud ("Melati"), and it is
/// unique among live rows only — a hand-written partial unique index
/// (`WHERE deleted_at IS NULL`) in the migration, so a closed ward's code can
/// be reused by its replacement.
model Ward {
  id          String    @id @default(uuid()) @db.Uuid
  code        String
  name        String
  description String?
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  rooms Room[]

  @@index([isActive])
  @@index([deletedAt])
  @@map("wards")
}

/// One room in a ward. Its class prices it (IMP-15) and is a property of the
/// room rather than of the bed: a transfer between classes is a transfer
/// between rooms, which is exactly what the bill has to reflect.
///
/// `code` is unique per ward among live rows, hand-written as a partial unique
/// index in the migration for the same reuse reason as {@link Ward.code}.
model Room {
  id          String    @id @default(uuid()) @db.Uuid
  wardId      String    @map("ward_id") @db.Uuid
  roomClassId String    @map("room_class_id") @db.Uuid
  code        String
  name        String
  description String?
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  ward      Ward      @relation(fields: [wardId], references: [id], onDelete: Restrict)
  roomClass RoomClass @relation(fields: [roomClassId], references: [id], onDelete: Restrict)
  beds      Bed[]

  @@index([wardId])
  @@index([roomClassId])
  @@index([isActive])
  @@index([deletedAt])
  @@map("rooms")
}

/// One bed — the unit an admission actually occupies.
///
/// `status` is a cached projection of the live `BedAssignment` set, kept in the
/// same transaction that opens or closes an assignment. It is stored anyway
/// because the occupancy board reads it on every render and because
/// MAINTENANCE is a state no assignment can express.
///
/// The authority on double-booking is **not** this column: a partial unique
/// index on `bed_assignments (bed_id) WHERE ended_at IS NULL` is, so two
/// concurrent admits race to the same constraint and one of them loses.
model Bed {
  id        String    @id @default(uuid()) @db.Uuid
  roomId    String    @map("room_id") @db.Uuid
  code      String
  status    BedStatus @default(AVAILABLE)
  notes     String?
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  room        Room            @relation(fields: [roomId], references: [id], onDelete: Restrict)
  assignments BedAssignment[]

  @@index([roomId])
  @@index([status])
  @@index([deletedAt])
  @@map("beds")
}

/// One inpatient stay — a **parallel aggregate to `Encounter`, not a child of
/// it**.
///
/// The outpatient chain cannot carry an admission and must not be bent to:
/// `Encounter.registrationId` is `@unique` (one encounter per registration by
/// design) and `EncounterStatus` is terminal once closed, so a stay spanning
/// days of care — with its own doctor, its own bed history, and its own
/// discharge — has nowhere to live on that row.
///
/// `sourceEncounterId` records the outpatient consultation that referred the
/// patient in, when there was one. Nullable and not unique: a direct admission
/// has no source encounter, and a patient readmitted after the same
/// consultation is two admissions, not a contradiction.
///
/// At most one ADMITTED admission per patient at a time, enforced by a
/// hand-written partial unique index in the migration
/// (`WHERE status = 'ADMITTED' AND deleted_at IS NULL`) — the same technique
/// `invoices_encounter_id_live_key` uses.
model Admission {
  id                String          @id @default(uuid()) @db.Uuid
  patientId         String          @map("patient_id") @db.Uuid
  admittingDoctorId String          @map("admitting_doctor_id") @db.Uuid
  sourceEncounterId String?         @map("source_encounter_id") @db.Uuid
  status            AdmissionStatus @default(ADMITTED)
  /// Why the patient was admitted, in the admitting doctor's words. The coded
  /// conclusion stays on the encounter's `Diagnosis` rows.
  reason            String?
  admittedAt        DateTime        @default(now()) @map("admitted_at")
  dischargedAt      DateTime?       @map("discharged_at")
  dischargeSummary  String?         @map("discharge_summary")
  cancelledAt       DateTime?       @map("cancelled_at")
  cancelReason      String?         @map("cancel_reason")
  createdById       String?         @map("created_by_id") @db.Uuid
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")
  deletedAt         DateTime?       @map("deleted_at")

  patient         PatientProfile  @relation(fields: [patientId], references: [id], onDelete: Restrict)
  admittingDoctor DoctorProfile   @relation(fields: [admittingDoctorId], references: [id], onDelete: Restrict)
  sourceEncounter Encounter?      @relation(fields: [sourceEncounterId], references: [id], onDelete: SetNull)
  createdBy       User?           @relation("AdmissionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  bedAssignments  BedAssignment[]
  invoices        Invoice[]

  @@index([patientId, admittedAt])
  @@index([admittingDoctorId, admittedAt])
  @@index([status, admittedAt])
  @@index([sourceEncounterId])
  @@index([deletedAt])
  @@map("admissions")
}

/// Which bed an admission held, and when. A transfer closes one row and opens
/// the next, so the table is the stay's full bed history rather than a current
/// pointer — which is what IMP-15 prices, night by night, at the class the
/// patient was actually in.
///
/// No `deletedAt`: an assignment is a fact about where a patient slept, like a
/// `Payment` is money that changed hands. Rows are closed, never removed.
model BedAssignment {
  id          String    @id @default(uuid()) @db.Uuid
  admissionId String    @map("admission_id") @db.Uuid
  bedId       String    @map("bed_id") @db.Uuid
  startedAt   DateTime  @default(now()) @map("started_at")
  /// Null while the patient is in this bed. The partial unique index on
  /// `(bed_id) WHERE ended_at IS NULL` makes that the double-booking guard.
  endedAt     DateTime? @map("ended_at")
  createdById String?   @map("created_by_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  admission Admission @relation(fields: [admissionId], references: [id], onDelete: Restrict)
  bed       Bed       @relation(fields: [bedId], references: [id], onDelete: Restrict)
  createdBy User?     @relation("BedAssignmentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([admissionId, startedAt])
  @@index([bedId, startedAt])
  @@index([endedAt])
  @@map("bed_assignments")
}

/// The domain events that currently produce a notification. Kinds are
/// distinct because each carries its own i18n copy and deep link, not because
/// the feed treats them differently.
enum NotificationType {
  APPOINTMENT_APPROVED
  APPOINTMENT_REJECTED
  CONVERSATION_HANDOFF

  @@map("notification_type")
}

/// One row of a user's in-app bell feed. `title_key`/`body_key` are i18n
/// message keys with `params` as the ICU values — the API stores no rendered
/// copy, so translations stay a frontend concern. `read_at` doubles as the
/// unread flag; delivery is polling, so there is no dispatch state here.
model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  type      NotificationType
  titleKey  String           @map("title_key")
  bodyKey   String           @map("body_key")
  params    Json             @default("{}")
  href      String?
  readAt    DateTime?        @map("read_at")
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")
  deletedAt DateTime?        @map("deleted_at")

  recipient User @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([userId, createdAt])
  @@index([deletedAt])
  @@map("notifications")
}

/// What a unit *is* on the org chart (SJ-1). A label rather than a structural
/// rule: nothing here constrains what may nest inside what, because real
/// clinics put a team under a branch as readily as under a department, and a
/// hierarchy that enforced one ordering would be wrong for the next clinic.
/// Depth is capped instead — see `OrganizationUnit`.
enum OrganizationUnitKind {
  DIVISION
  DEPARTMENT
  TEAM
  BRANCH

  @@map("organization_unit_kind")
}

/// One node of the organization chart (SJ-1).
///
/// Single-parent adjacency list — `parentId` — with `path` materialised
/// alongside it. The two are redundant by construction and that is the point:
/// `parentId` is the truth an edit writes, `path` is the denormalisation that
/// makes "everything under this unit" one indexed prefix scan instead of a
/// recursive query per read. `path` is the slash-delimited chain of ancestor
/// ids **including this row**, with both ends slashed (`/root/child/`), so a
/// subtree is `path LIKE '/root/%'` and a unit's depth is its segment count.
/// Every move recomputes it for the whole subtree inside one transaction;
/// nothing else may write it.
///
/// There is no `depth` column. It is derivable from `path` in a line of code,
/// and a second materialised copy of the same fact is a second thing that can
/// drift out of agreement with `parentId`.
///
/// People are never rows here. Staff reference a unit through `User.organizationUnitId`,
/// so a reorganisation moves boxes on a chart and never touches an employment
/// record — which is also why both foreign keys are `Restrict`: the service
/// refuses a hard delete while children or members remain, and the database
/// refuses it again if that check is ever bypassed.
model OrganizationUnit {
  id        String               @id @default(uuid()) @db.Uuid
  parentId  String?              @map("parent_id") @db.Uuid
  name      String
  kind      OrganizationUnitKind
  /// Ancestor-id chain including self, e.g. `/a1b2.../c3d4.../`. Maintained by
  /// the service; never accepted from a request.
  path      String
  /// Ordering among siblings. Ties break on `name` so a tree with an unset or
  /// duplicated order still renders deterministically.
  sortOrder Int                  @default(0) @map("sort_order")
  createdAt DateTime             @default(now()) @map("created_at")
  updatedAt DateTime             @updatedAt @map("updated_at")
  deletedAt DateTime?            @map("deleted_at")

  parent   OrganizationUnit?  @relation("OrganizationUnitParent", fields: [parentId], references: [id], onDelete: Restrict)
  children OrganizationUnit[] @relation("OrganizationUnitParent")
  members  User[]             @relation("OrganizationUnitMember")

  @@index([parentId, sortOrder])
  @@index([path])
  @@index([deletedAt])
  @@map("organization_units")
}
