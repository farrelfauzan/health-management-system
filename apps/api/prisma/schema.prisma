generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum PermissionScope {
  ANY
  OWN
}

enum DoctorPatientActivityAction {
  ASSIGNED
  UNASSIGNED
}

enum AuditAction {
  USER_LOGIN
  USER_LOGIN_FAILED
  TOKEN_REFRESHED
  USER_LOGOUT
  USER_CREATED
  USER_UPDATED
  ROLE_ASSIGNED
  ROLE_UNASSIGNED
  PATIENT_IDENTIFIER_UNMASKED
  DOCTOR_IDENTIFIER_UNMASKED
  PATIENT_MRN_IMPORTED
  INVOICE_VOIDED
  SATUSEHAT_PATIENT_LINKED
  SATUSEHAT_DOCTOR_LINKED
  SATUSEHAT_SUBMISSION_RETRIED
  BPJS_CONFIG_CREATED
  BPJS_CONFIG_UPDATED
  BPJS_CONFIG_DELETED
  BPJS_CONNECTION_TESTED
  BPJS_REFERENCE_SYNCED
  BPJS_MAPPING_UPDATED
}

enum BpjsReferenceCatalog {
  POLI
  DOKTER
  KESADARAN
  TINDAKAN
  DIAGNOSA
  DPHO
  SPESIALIS
  SARANA
}

enum BpjsPcareEnvironment {
  DEVELOPMENT
  PRODUCTION
}

enum PatientStatus {
  IN_PATIENT
  OUT_PATIENT
  DISCHARGED
}

enum PatientSex {
  MALE
  FEMALE
}

enum BloodType {
  A
  B
  AB
  O
}

enum RhesusFactor {
  POSITIVE
  NEGATIVE
}

enum MaritalStatus {
  SINGLE
  MARRIED
  DIVORCED
  WIDOWED
}

// The six religions recognised on Indonesian civil registration documents,
// plus an escape hatch for records that do not fit them.
enum Religion {
  ISLAM
  PROTESTANTISM
  CATHOLICISM
  HINDUISM
  BUDDHISM
  CONFUCIANISM
  OTHER
}

enum AllergySeverity {
  MILD
  MODERATE
  SEVERE
}

// Indonesian practitioner credentials: STR (Surat Tanda Registrasi — lifetime
// under UU Kesehatan No. 17/2023) and SIP (Surat Izin Praktik — issued per
// practice location and time-limited).
enum DoctorLicenseType {
  STR
  SIP
}

enum AppointmentStatus {
  REQUESTED
  SCHEDULED
  CONFIRMED
  COMPLETED
  CANCELLED
  REJECTED
  NO_SHOW
}

enum AppointmentType {
  SESSION
  SPECIAL_REQUEST
}

enum AppointmentSessionStatus {
  OPEN
  CLOSED
  CANCELLED
}

enum RegistrationStatus {
  PENDING
  CHECKED_IN
  COMPLETED
  CANCELLED
}

/// Lifecycle of a clinical encounter (the PMK 24/2022 medical record for one
/// visit). An encounter opens when the doctor starts seeing a checked-in
/// patient and is terminal once closed: FINISHED when the visit was delivered,
/// CANCELLED when it was opened in error. Records are never re-opened — a
/// correction is a new encounter, so the original stays auditable.
enum EncounterStatus {
  IN_PROGRESS
  FINISHED
  CANCELLED
}

/// Lifecycle of one SATUSEHAT outbox row. PENDING rows are due (or waiting
/// for their next backoff slot); SUBMITTED and FAILED are settled — FAILED is
/// re-opened only by an explicit admin retry (P10-T06), never by the worker.
enum SatusehatSubmissionStatus {
  PENDING
  SUBMITTED
  FAILED
}

/// Role of a diagnosis within one encounter. Exactly one PRIMARY is expected —
/// it is the diagnosis that justifies the visit, and both BPJS claims and
/// SATUSEHAT `Condition` submissions single it out.
enum DiagnosisType {
  PRIMARY
  SECONDARY
}

enum PrescriptionStatus {
  DRAFT
  ISSUED
  PARTIALLY_DISPENSED
  DISPENSED
  CANCELLED
}

enum DispenseStatus {
  DISPENSED
  CANCELLED
}

/// Dispensing and dose units accepted by the medication catalog. Mirrors the
/// "satuan" values used by KFA (Kamus Farmasi dan Alat Kesehatan) so SATUSEHAT
/// medication resources can be mapped without free-text normalisation.
enum MedicationUnit {
  TABLET
  KAPSUL
  KAPLET
  SACHET
  AMPUL
  VIAL
  BOTOL
  TUBE
  STRIP
  BOX
  PCS
  ML
  MG
  GRAM
  MCG
  IU
  TETES
  SUPOSITORIA
}

/// Indonesian legal medication classification (golongan obat) per BPOM. Drives
/// dispensing rules and reporting duties for psychotropics and narcotics.
enum MedicationCategory {
  OBAT_BEBAS
  OBAT_BEBAS_TERBATAS
  OBAT_KERAS
  PSIKOTROPIKA
  NARKOTIKA
  OBAT_HERBAL
  SUPLEMEN
  ALAT_KESEHATAN
}

/// What a tariff row prices: the consultation fee, a clinical action
/// (tindakan), or an ad-hoc charge that is neither.
enum ServiceTariffCategory {
  CONSULTATION
  PROCEDURE
  OTHER
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  VOID
}

enum InvoiceItemType {
  CONSULTATION
  PROCEDURE
  MEDICATION
  OTHER
}

/// How an invoice was settled. INSURANCE covers private payers recorded
/// manually for now — BPJS claims are not payments and arrive with Phase 11.
enum PaymentMethod {
  CASH
  TRANSFER
  QRIS
  INSURANCE
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique
  passwordHash String    @map("password_hash")
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  roles                    UserRole[]
  assignedRoles            UserRole[]              @relation("RoleAssignedBy")
  unassignedRoles          UserRole[]              @relation("RoleUnassignedBy")
  patientProfiles          PatientProfile[]
  doctorProfile            DoctorProfile?
  assignedDoctorPatients   DoctorPatient[]         @relation("DoctorPatientAssignedBy")
  unassignedDoctorPatients DoctorPatient[]         @relation("DoctorPatientUnassignedBy")
  doctorPatientActivities  DoctorPatientActivity[] @relation("DoctorPatientActivityActor")
  createdAppointments      Appointment[]           @relation("AppointmentCreatedBy")
  createdRegistrations     Registration[]          @relation("RegistrationCreatedBy")
  createdEncounters        Encounter[]             @relation("EncounterCreatedBy")
  recordedVitalSigns       VitalSigns[]            @relation("VitalSignsRecordedBy")
  recordedDiagnoses        Diagnosis[]             @relation("DiagnosisRecordedBy")
  recordedProcedures       Procedure[]             @relation("ProcedureRecordedBy")
  dispensedByRecords       DispenseRecord[]        @relation("DispensePharmacist")
  createdInvoices          Invoice[]               @relation("InvoiceCreatedBy")
  voidedInvoices           Invoice[]               @relation("InvoiceVoidedBy")
  receivedPayments         Payment[]               @relation("PaymentCashier")
  refreshTokens            RefreshToken[]
  auditLogs                AuditLog[]              @relation("AuditLogActor")

  @@map("users")
}

model RefreshToken {
  id        String    @id @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  familyId  String    @map("family_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
  @@index([revokedAt])
  @@map("refresh_tokens")
}

/// Sequence source for medical record numbers. Allocation is a single atomic
/// `UPDATE … RETURNING` (never `MAX(mrn) + 1`, which races), run inside the
/// same transaction as the patient insert — so a rolled-back create rolls the
/// counter back with it and the number is handed to the next caller instead of
/// leaving a hole. Committed numbers are never reissued or renumbered: a reused
/// MRN silently merges two patients' histories.
///
/// HMS ships single-facility, so `PatientProfile.mrn` stays globally `@unique`
/// and exactly one counter row exists, keyed by the nil-UUID sentinel. The
/// column is already a UUID PK so a multi-facility deployment adds rows and
/// switches the patient constraint to `@@unique([facilityId, mrn])` without a
/// table rewrite. See docs/post-mvp/patient-identifiers.md §2.3.
model MrnCounter {
  facilityId String   @id @map("facility_id") @db.Uuid
  nextValue  BigInt   @map("next_value")
  updatedAt  DateTime @default(now()) @map("updated_at")

  @@map("mrn_counters")
}

model PatientProfile {
  id           String        @id @default(uuid()) @db.Uuid
  mrn          String        @unique
  fullName     String        @map("full_name")
  dateOfBirth  DateTime      @map("date_of_birth") @db.Date
  placeOfBirth String?       @map("place_of_birth")
  sex          PatientSex?
  status       PatientStatus @default(OUT_PATIENT)
  phoneNumber  String        @map("phone_number")
  address      String
  ownerUserId  String?       @map("owner_user_id") @db.Uuid
  isActive     Boolean       @default(true) @map("is_active")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  deletedAt    DateTime?     @map("deleted_at")

  // Demographic and clinical-safety identity fields required by PMK 24/2022
  // and expected on Indonesian registration forms. All optional so existing
  // MVP records stay valid; required-ness tightens in the EMR phase.
  email                 String?        @map("email")
  bloodType             BloodType?     @map("blood_type")
  rhesusFactor          RhesusFactor?  @map("rhesus_factor")
  maritalStatus         MaritalStatus? @map("marital_status")
  occupation            String?
  religion              Religion?
  emergencyContactName  String?        @map("emergency_contact_name")
  emergencyContactPhone String?        @map("emergency_contact_phone")
  // Penanggung jawab — required in practice for minors.
  guardianName          String?        @map("guardian_name")
  guardianRelation      String?        @map("guardian_relation")

  // National and payer identifiers are never stored in plaintext. Each
  // searchable identifier lives across three columns: AES-256-GCM ciphertext
  // for retrieval, an HMAC-SHA256 blind index for lookup and uniqueness, and
  // the last four digits for masked display. See
  // docs/post-mvp/patient-identifiers.md.
  // Key version is per identifier, not per row: identifiers are written
  // independently, so one row-level version could not describe two values
  // encrypted under different keys during an incremental rotation.
  nikCiphertext                String? @map("nik_ciphertext")
  nikIndex                     String? @unique @map("nik_index")
  nikLast4                     String? @map("nik_last4")
  nikKeyVersion                Int?    @map("nik_key_version") @db.SmallInt
  bpjsNumberCiphertext         String? @map("bpjs_number_ciphertext")
  bpjsNumberIndex              String? @unique @map("bpjs_number_index")
  bpjsNumberLast4              String? @map("bpjs_number_last4")
  bpjsNumberKeyVersion         Int?    @map("bpjs_number_key_version") @db.SmallInt
  satusehatPatientIdCiphertext String? @map("satusehat_patient_id_ciphertext")
  satusehatPatientIdKeyVersion Int?    @map("satusehat_patient_id_key_version") @db.SmallInt

  ownerUser     User?            @relation(fields: [ownerUserId], references: [id], onDelete: SetNull)
  doctors       DoctorPatient[]
  appointments  Appointment[]
  registrations Registration[]
  prescriptions Prescription[]
  allergies     PatientAllergy[]
  encounters    Encounter[]
  invoices      Invoice[]

  @@index([deletedAt])
  @@index([ownerUserId])
  @@index([isActive])
  @@index([fullName])
  @@index([status])
  @@map("patient_profiles")
}

/// Free-text substance plus a severity grade. Deliberately uncoded for now —
/// allergen and reaction move to coded terminology in the EMR phase.
model PatientAllergy {
  id        String          @id @default(uuid()) @db.Uuid
  patientId String          @map("patient_id") @db.Uuid
  substance String
  reaction  String?
  severity  AllergySeverity
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")
  deletedAt DateTime?       @map("deleted_at")

  patient PatientProfile @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@index([deletedAt])
  @@map("patient_allergies")
}

model Specialty {
  id          String    @id @default(uuid()) @db.Uuid
  name        String    @unique
  description String?
  /// BPJS PCare kdPoli this specialty registers under (P11-T03). The clinic
  /// has no standalone poli entity — Specialty is the closest structural
  /// equivalent (a registration reaches BPJS via its doctor's specialty), so
  /// the poli mapping lives here rather than on a new join table. Nullable —
  /// an unmapped specialty fails a BPJS submission fast with a readable
  /// message.
  bpjsPoliCode String?  @map("bpjs_poli_code")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  doctors DoctorProfile[]

  @@index([deletedAt])
  @@index([isActive])
  @@map("specialties")
}

model DoctorProfile {
  id            String    @id @default(uuid()) @db.Uuid
  licenseNumber String    @unique @map("license_number")
  fullName      String    @map("full_name")
  specialtyId   String    @map("specialty_id") @db.Uuid
  phoneNumber   String?   @map("phone_number")
  ownerUserId   String?   @unique @map("owner_user_id") @db.Uuid
  isActive      Boolean   @default(true) @map("is_active")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  // National identity and SATUSEHAT linkage required by PMK 24/2022.
  //
  // A practitioner NIK is the same citizen identifier as a patient NIK and
  // carries the same UU PDP obligations, so it is stored exactly like one:
  // AES-256-GCM ciphertext for retrieval, an HMAC-SHA256 blind index for
  // lookup and uniqueness (SATUSEHAT resolves practitioners by NIK), and the
  // last four digits for masked display. See
  // docs/post-mvp/patient-identifiers.md — only STR/SIP numbers are
  // registry-public and stay plaintext, on DoctorLicense.
  nikCiphertext           String? @map("nik_ciphertext")
  nikIndex                String? @unique @map("nik_index")
  nikLast4                String? @map("nik_last4")
  nikKeyVersion           Int?    @map("nik_key_version") @db.SmallInt
  // IHS practitioner number, filled after the first successful SATUSEHAT
  // practitioner lookup. Plaintext: it is a pseudonymous Kemenkes-issued
  // identifier, read on every outbound FHIR call and never searched by value.
  satusehatPractitionerId String? @map("satusehat_practitioner_id")
  // BPJS PCare kdDokter, set by an admin from the synced DOKTER reference
  // catalog (P11-T03). Plaintext for the same reason as the IHS number: a
  // pseudonymous facility-scoped code read on every pendaftaran/kunjungan
  // submission. Nullable — an unmapped doctor fails a BPJS submission fast
  // with a readable message instead of sending garbage.
  bpjsDoctorCode String? @map("bpjs_doctor_code")

  // Listing/profile fields clinics expect on doctor directories (P7-T04).
  // Specialty remains the existing Specialty reference table; title/degrees
  // cover honorifics and academic credentials (e.g. "dr.", "Sp.PD").
  // phoneNumber already existed; email is required by SATUSEHAT Practitioner
  // ContactPoint alongside phone.
  title   String?
  degrees String?
  email   String?

  specialty           Specialty            @relation(fields: [specialtyId], references: [id])
  ownerUser           User?                @relation(fields: [ownerUserId], references: [id], onDelete: SetNull)
  patients            DoctorPatient[]
  schedules           DoctorSchedule[]
  appointments        Appointment[]
  appointmentSessions AppointmentSession[]
  prescriptions       Prescription[]
  licenses            DoctorLicense[]
  educations          DoctorEducation[]
  encounters          Encounter[]

  @@index([deletedAt])
  @@index([isActive])
  @@index([fullName])
  @@index([specialtyId])
  @@map("doctor_profiles")
}

/// Academic qualifications mapped later to SATUSEHAT Practitioner.qualification
/// together with licensing records. Soft-deleted so history survives edits.
model DoctorEducation {
  id             String    @id @default(uuid()) @db.Uuid
  doctorId       String    @map("doctor_id") @db.Uuid
  institution    String
  degree         String
  fieldOfStudy   String?   @map("field_of_study")
  graduationYear Int?      @map("graduation_year")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  doctor DoctorProfile @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@index([doctorId])
  @@index([deletedAt])
  @@map("doctor_educations")
}

/// Practitioner credentials modelled as a child table rather than flat
/// columns: a doctor holds one lifetime STR but may hold several SIPs (one per
/// practice location), and clinics must track SIP expiry for licensing audits.
model DoctorLicense {
  id            String            @id @default(uuid()) @db.Uuid
  doctorId      String            @map("doctor_id") @db.Uuid
  type          DoctorLicenseType
  licenseNumber String            @map("license_number")
  issuedAt      DateTime?         @map("issued_at") @db.Date
  expiresAt     DateTime?         @map("expires_at") @db.Date
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")
  deletedAt     DateTime?         @map("deleted_at")

  doctor DoctorProfile @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@index([doctorId])
  @@index([deletedAt])
  @@index([expiresAt])
  @@map("doctor_licenses")
}

model DoctorSchedule {
  id          String   @id @default(uuid()) @db.Uuid
  doctorId    String   @map("doctor_id") @db.Uuid
  dayOfWeek   Int      @map("day_of_week")
  startTime   String   @map("start_time")
  endTime     String   @map("end_time")
  isAvailable Boolean  @default(true) @map("is_available")
  maxPatients Int?     @map("max_patients")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  doctor   DoctorProfile        @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  sessions AppointmentSession[]

  @@index([doctorId, dayOfWeek])
  @@map("doctor_schedules")
}

model AppointmentSession {
  id          String                   @id @default(uuid()) @db.Uuid
  doctorId    String                   @map("doctor_id") @db.Uuid
  scheduleId  String?                  @map("schedule_id") @db.Uuid
  sessionDate DateTime                 @map("session_date") @db.Date
  startTime   String                   @map("start_time")
  endTime     String                   @map("end_time")
  maxPatients Int?                     @map("max_patients")
  status      AppointmentSessionStatus @default(OPEN)
  createdAt   DateTime                 @default(now()) @map("created_at")
  updatedAt   DateTime                 @updatedAt @map("updated_at")

  doctor       DoctorProfile   @relation(fields: [doctorId], references: [id], onDelete: Restrict)
  schedule     DoctorSchedule? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  appointments Appointment[]

  @@unique([doctorId, sessionDate, startTime])
  @@index([doctorId, sessionDate])
  @@map("appointment_sessions")
}

model DoctorPatient {
  id             String    @id @default(uuid()) @db.Uuid
  doctorId       String    @map("doctor_id") @db.Uuid
  patientId      String    @map("patient_id") @db.Uuid
  assignedById   String?   @map("assigned_by_id") @db.Uuid
  assignedAt     DateTime  @default(now()) @map("assigned_at")
  unassignedById String?   @map("unassigned_by_id") @db.Uuid
  unassignedAt   DateTime? @map("unassigned_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  doctor       DoctorProfile           @relation(fields: [doctorId], references: [id], onDelete: Restrict)
  patient      PatientProfile          @relation(fields: [patientId], references: [id], onDelete: Restrict)
  assignedBy   User?                   @relation("DoctorPatientAssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)
  unassignedBy User?                   @relation("DoctorPatientUnassignedBy", fields: [unassignedById], references: [id], onDelete: SetNull)
  activities   DoctorPatientActivity[]

  @@index([doctorId, unassignedAt])
  @@index([patientId, unassignedAt])
  @@index([assignedById])
  @@index([unassignedById])
  @@index([assignedAt])
  @@index([unassignedAt])
  @@map("doctor_patients")
}

model DoctorPatientActivity {
  id           String                      @id @default(uuid()) @db.Uuid
  assignmentId String                      @map("assignment_id") @db.Uuid
  action       DoctorPatientActivityAction
  actorUserId  String                      @map("actor_user_id") @db.Uuid
  occurredAt   DateTime                    @default(now()) @map("occurred_at")

  assignment DoctorPatient @relation(fields: [assignmentId], references: [id], onDelete: Restrict)
  actor      User          @relation("DoctorPatientActivityActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([assignmentId, occurredAt])
  @@index([actorUserId, occurredAt])
  @@index([action, occurredAt])
  @@index([occurredAt])
  @@map("doctor_patient_activities")
}

model Appointment {
  id          String            @id @default(uuid()) @db.Uuid
  patientId   String            @map("patient_id") @db.Uuid
  doctorId    String            @map("doctor_id") @db.Uuid
  type        AppointmentType   @default(SESSION)
  sessionId   String?           @map("session_id") @db.Uuid
  queueNumber Int?              @map("queue_number")
  scheduledAt DateTime          @map("scheduled_at")
  status      AppointmentStatus @default(SCHEDULED)
  reason      String?
  notes       String?
  createdById String?           @map("created_by_id") @db.Uuid
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")
  deletedAt   DateTime?         @map("deleted_at")

  patient      PatientProfile      @relation(fields: [patientId], references: [id], onDelete: Restrict)
  doctor       DoctorProfile       @relation(fields: [doctorId], references: [id], onDelete: Restrict)
  session      AppointmentSession? @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  createdBy    User?               @relation("AppointmentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  registration Registration?

  @@unique([sessionId, queueNumber])
  @@index([doctorId, scheduledAt])
  @@index([patientId, scheduledAt])
  @@index([status, scheduledAt])
  @@index([sessionId])
  @@index([deletedAt])
  @@map("appointments")
}

/// Allocates the daily antrian sequence, one row per clinic-local calendar
/// day, consumed with a single atomic upsert (`INSERT … ON CONFLICT … UPDATE
/// … RETURNING`) inside the registration-create transaction — the same
/// reasoning as `MrnCounter`: concurrent front-desk and self-service
/// registrations race, and `MAX(queue_number) + 1` hands two patients the
/// same ticket. The queue is clinic-wide, mirroring the single-facility MRN
/// decision; a per-poli split arrives with the BPJS poli mapping (P11-T03).
model QueueCounter {
  queueDate DateTime @id @map("queue_date") @db.Date
  nextValue Int      @map("next_value")
  updatedAt DateTime @default(now()) @map("updated_at")

  @@map("queue_counters")
}

model Registration {
  id            String             @id @default(uuid()) @db.Uuid
  patientId     String             @map("patient_id") @db.Uuid
  appointmentId String?            @unique @map("appointment_id") @db.Uuid
  status        RegistrationStatus @default(PENDING)
  /// Daily antrian ticket, allocated from `QueueCounter` when the
  /// registration is created. Nullable only because rows predate the queue;
  /// never renumbered and never reissued — a cancellation leaves a gap, which
  /// is what a paper ticket roll does too.
  queueNumber   Int?               @map("queue_number")
  /// The clinic-local (`CLINIC_TIMEZONE`) calendar day the ticket belongs to.
  /// Stored explicitly rather than derived from `registeredAt` so the board
  /// query never re-does timezone arithmetic over UTC timestamps.
  queueDate     DateTime?          @map("queue_date") @db.Date
  registeredAt  DateTime           @default(now()) @map("registered_at")
  checkedInAt   DateTime?          @map("checked_in_at")
  completedAt   DateTime?          @map("completed_at")
  createdById   String?            @map("created_by_id") @db.Uuid
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @updatedAt @map("updated_at")
  deletedAt     DateTime?          @map("deleted_at")

  patient     PatientProfile @relation(fields: [patientId], references: [id], onDelete: Restrict)
  appointment Appointment?   @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  createdBy   User?          @relation("RegistrationCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  encounter   Encounter?

  @@unique([queueDate, queueNumber])
  @@index([patientId, status])
  @@index([status, registeredAt])
  @@index([deletedAt])
  @@map("registrations")
}

/// The clinical record of one visit, mandated by PMK 24/2022. Opened from a
/// CHECKED_IN registration and closed when the doctor finishes; vitals,
/// diagnoses, SOAP notes, and procedures hang off it in later tasks.
///
/// `registrationId` is unique — one encounter per registration. A second visit
/// on the same day is a second registration, which is also what the queue and
/// the payer expect.
///
/// `doctorId` is stored on the encounter rather than read through the
/// appointment: walk-in registrations have no appointment at all, and the
/// doctor who actually attended may differ from the one booked. The medical
/// record must name the practitioner who signed it.
model Encounter {
  id             String          @id @default(uuid()) @db.Uuid
  registrationId String          @unique @map("registration_id") @db.Uuid
  patientId      String          @map("patient_id") @db.Uuid
  doctorId       String          @map("doctor_id") @db.Uuid
  status         EncounterStatus @default(IN_PROGRESS)
  startedAt      DateTime        @default(now()) @map("started_at")
  endedAt        DateTime?       @map("ended_at")
  createdById    String?         @map("created_by_id") @db.Uuid
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  deletedAt      DateTime?       @map("deleted_at")

  // SOAP note — the narrative half of the PMK 24/2022 minimum record, which
  // requires anamnesis, examination findings, diagnosis, and treatment plan.
  // Free text on purpose: the coded parts of the record live in `diagnoses`
  // (ICD-10) and `procedures` (ICD-9-CM), and forcing narrative reasoning into
  // codes loses the clinical detail a later reader needs.
  /// Anamnesis — what the patient reports.
  subjective String?
  /// Examination findings. Measured vitals stay in `vital_signs`; this is the
  /// qualitative reading of them.
  objective  String?
  /// Clinical reasoning. The coded conclusion is a `Diagnosis` row.
  assessment String?
  /// Treatment plan. Prescribed items stay in `prescriptions`.
  plan       String?

  registration  Registration   @relation(fields: [registrationId], references: [id], onDelete: Restrict)
  patient       PatientProfile @relation(fields: [patientId], references: [id], onDelete: Restrict)
  doctor        DoctorProfile  @relation(fields: [doctorId], references: [id], onDelete: Restrict)
  createdBy     User?          @relation("EncounterCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  vitalSigns          VitalSigns[]
  diagnoses           Diagnosis[]
  procedures          Procedure[]
  prescriptions       Prescription[]
  invoices            Invoice[]
  satusehatSubmission SatusehatSubmission?

  @@index([patientId, startedAt])
  @@index([doctorId, startedAt])
  @@index([status, startedAt])
  @@index([deletedAt])
  @@map("encounters")
}

/// One set of vital signs measured during an encounter — the "hasil
/// pemeriksaan fisik" half of the PMK 24/2022 minimum record.
///
/// Many rows per encounter, not one: re-measuring after an abnormal reading
/// (a blood-pressure recheck, a post-antipyretic temperature) is routine, and
/// overwriting the first reading would erase the finding that prompted the
/// second. Each row is an independent measurement stamped with `recordedAt`,
/// which is also exactly how it maps to a SATUSEHAT `Observation` in P10-T03.
/// "The" vitals for a submission or a summary view are the newest row.
///
/// Every measurement is nullable — front desks record weight and blood
/// pressure while a full set only appears when clinically indicated. Units are
/// fixed by the column (cm, kg, °C, mmHg, beats/min, breaths/min, %) so no
/// unit column is needed; LOINC codes live in the SATUSEHAT adapter, never
/// here. BMI is derived from height and weight on read and is deliberately not
/// stored — a stored copy goes stale the moment either input is corrected.
///
/// The CHECK constraints reject physiologically impossible values (a decimal
/// typo turning 36.8 °C into 368), not clinically abnormal ones: a genuinely
/// critical reading must still be recordable.
model VitalSigns {
  id                     String    @id @default(uuid()) @db.Uuid
  encounterId            String    @map("encounter_id") @db.Uuid
  heightCm               Decimal?  @map("height_cm") @db.Decimal(5, 2)
  weightKg               Decimal?  @map("weight_kg") @db.Decimal(5, 2)
  systolicBloodPressure  Int?      @map("systolic_blood_pressure")
  diastolicBloodPressure Int?      @map("diastolic_blood_pressure")
  pulseRate              Int?      @map("pulse_rate")
  respiratoryRate        Int?      @map("respiratory_rate")
  temperatureCelsius     Decimal?  @map("temperature_celsius") @db.Decimal(4, 1)
  oxygenSaturation       Int?      @map("oxygen_saturation")
  notes                  String?
  recordedAt             DateTime  @default(now()) @map("recorded_at")
  recordedById           String?   @map("recorded_by_id") @db.Uuid
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")
  deletedAt              DateTime? @map("deleted_at")

  encounter  Encounter @relation(fields: [encounterId], references: [id], onDelete: Restrict)
  recordedBy User?     @relation("VitalSignsRecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)

  @@index([encounterId, recordedAt])
  @@index([deletedAt])
  @@map("vital_signs")
}

/// ICD-10 catalog used to code diagnoses. Reference data, not clinical data:
/// rows are maintained by an administrator or replaced wholesale by the
/// official Kemenkes list, and nothing here belongs to a patient.
///
/// Retired codes are deactivated (`isActive = false`), never deleted — historic
/// encounters must keep resolving the code they were coded with.
///
/// `displayIndonesian` holds the Kemenkes Bahasa Indonesia title where one
/// exists. Clinicians search in Indonesian, so it is matched alongside the WHO
/// English title rather than being display-only.
model Icd10Code {
  id                String    @id @default(uuid()) @db.Uuid
  code              String    @unique
  display           String
  displayIndonesian String?   @map("display_indonesian")
  /// Three-character parent code (`J06` for `J06.9`), for grouping and for
  /// falling back to the category when a payer rejects a subdivision.
  category          String?
  /// ICD-10 chapter in Roman numerals, e.g. `X` for respiratory diseases.
  chapter           String?
  isActive          Boolean   @default(true) @map("is_active")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  deletedAt         DateTime? @map("deleted_at")

  diagnoses Diagnosis[]

  @@index([category])
  @@index([isActive])
  @@index([deletedAt])
  @@map("icd10_codes")
}

/// A coded diagnosis recorded on an encounter — the "diagnosis" line PMK
/// 24/2022 requires, and the input to both BPJS claims and SATUSEHAT
/// `Condition` resources.
///
/// `code` and `display` are stored as a snapshot of what the clinician
/// actually recorded, alongside the optional `icd10CodeId` link. A medical
/// record must not change retroactively: if the catalog row is later renamed,
/// re-categorised, or retired, the signed record keeps the wording it was
/// signed with. The FK is `SetNull` for the same reason — losing the catalog
/// row must never take the diagnosis with it.
model Diagnosis {
  id           String        @id @default(uuid()) @db.Uuid
  encounterId  String        @map("encounter_id") @db.Uuid
  icd10CodeId  String?       @map("icd10_code_id") @db.Uuid
  code         String
  display      String
  type         DiagnosisType @default(SECONDARY)
  notes        String?
  recordedAt   DateTime      @default(now()) @map("recorded_at")
  recordedById String?       @map("recorded_by_id") @db.Uuid
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  deletedAt    DateTime?     @map("deleted_at")

  encounter  Encounter  @relation(fields: [encounterId], references: [id], onDelete: Restrict)
  icd10Code  Icd10Code? @relation(fields: [icd10CodeId], references: [id], onDelete: SetNull)
  recordedBy User?      @relation("DiagnosisRecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)

  @@index([encounterId, type])
  @@index([code])
  @@index([deletedAt])
  @@map("diagnoses")
}

/// ICD-9-CM procedure catalog — the counterpart to `Icd10Code` for actions
/// rather than conditions. BPJS claims price a visit from the procedures
/// recorded against it, so an uncoded action is an unbillable one.
///
/// Same rules as the diagnosis catalog: reference data, retired codes are
/// deactivated rather than deleted, and the official list is loaded by
/// `pnpm --filter @hms/api icd9cm:import`. There is no chapter column —
/// ICD-9-CM procedure chapters do not follow a clean lexicographic range the
/// way ICD-10 chapters do, so only the two-digit `category` is derived.
model Icd9cmCode {
  id                String    @id @default(uuid()) @db.Uuid
  code              String    @unique
  display           String
  displayIndonesian String?   @map("display_indonesian")
  /// Two-digit parent code (`93` for `93.94`).
  category          String?
  isActive          Boolean   @default(true) @map("is_active")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  deletedAt         DateTime? @map("deleted_at")

  procedures Procedure[]

  @@index([category])
  @@index([isActive])
  @@index([deletedAt])
  @@map("icd9cm_codes")
}

/// A coded action performed during an encounter — injection, wound suture,
/// nebulisation. Feeds BPJS claim lines and, later, SATUSEHAT `Procedure`
/// resources.
///
/// `code` and `display` are a snapshot of what was signed, exactly as on
/// `Diagnosis`: a catalog rename must never rewrite a signed record. Unlike
/// diagnoses there is no primary/secondary split — every procedure on a visit
/// counts equally toward the claim.
model Procedure {
  id           String    @id @default(uuid()) @db.Uuid
  encounterId  String    @map("encounter_id") @db.Uuid
  icd9cmCodeId String?   @map("icd9cm_code_id") @db.Uuid
  code         String
  display      String
  notes        String?
  /// When the action was performed, which can precede the moment it was
  /// written down.
  performedAt  DateTime  @default(now()) @map("performed_at")
  recordedById String?   @map("recorded_by_id") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  encounter  Encounter   @relation(fields: [encounterId], references: [id], onDelete: Restrict)
  icd9cmCode Icd9cmCode? @relation(fields: [icd9cmCodeId], references: [id], onDelete: SetNull)
  recordedBy User?       @relation("ProcedureRecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)

  @@index([encounterId, performedAt])
  @@index([code])
  @@index([deletedAt])
  @@map("procedures")
}

model Medication {
  id        String              @id @default(uuid()) @db.Uuid
  code      String              @unique
  kfaCode   String?             @unique @map("kfa_code")
  /// BPJS DPHO kdObat (P11-T03), linked by an admin from the search-and-cache
  /// DPHO catalog. Sits alongside kfaCode — two national code systems, one
  /// medication row. Unique for the same reason kfaCode is: one catalog
  /// identity maps to at most one local row.
  dphoCode  String?             @unique @map("dpho_code")
  name      String
  form      String?
  strength  String?
  unit      MedicationUnit?
  category  MedicationCategory?
  stockQty  Int                 @default(0) @map("stock_qty")
  /// Selling price per `unit`, in rupiah. Nullable because the MVP catalog
  /// predates billing; invoice generation treats an unpriced dispensed
  /// medication as a gap to surface, not a free item.
  unitPrice Decimal?            @map("unit_price") @db.Decimal(12, 2)
  createdAt DateTime            @default(now()) @map("created_at")
  updatedAt DateTime            @updatedAt @map("updated_at")
  deletedAt DateTime?           @map("deleted_at")

  prescriptionItems PrescriptionMedication[]
  dispenseItems     DispenseItem[]
  invoiceItems      InvoiceItem[]

  @@index([name])
  @@index([category])
  @@index([deletedAt])
  @@map("medications")
}

model Prescription {
  id          String             @id @default(uuid()) @db.Uuid
  patientId   String             @map("patient_id") @db.Uuid
  doctorId    String             @map("doctor_id") @db.Uuid
  /// The visit this prescription was written during. Nullable, and deliberately
  /// so: repeat prescriptions are issued between visits, and every MVP row
  /// predates the encounter record. Once set it is never moved — a prescription
  /// belongs to the visit that produced it.
  encounterId String?            @map("encounter_id") @db.Uuid
  status      PrescriptionStatus @default(DRAFT)
  issuedAt    DateTime?          @map("issued_at")
  notes       String?
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")
  deletedAt   DateTime?          @map("deleted_at")

  patient         PatientProfile           @relation(fields: [patientId], references: [id], onDelete: Restrict)
  doctor          DoctorProfile            @relation(fields: [doctorId], references: [id], onDelete: Restrict)
  encounter       Encounter?               @relation(fields: [encounterId], references: [id], onDelete: Restrict)
  items           PrescriptionMedication[]
  dispenseRecords DispenseRecord[]

  @@index([patientId, status])
  @@index([doctorId, status])
  @@index([encounterId])
  @@index([deletedAt])
  @@map("prescriptions")
}

model PrescriptionMedication {
  id             String   @id @default(uuid()) @db.Uuid
  prescriptionId String   @map("prescription_id") @db.Uuid
  medicationId   String   @map("medication_id") @db.Uuid
  dosage         String
  frequency      String
  durationDays   Int?     @map("duration_days")
  quantity       Int
  instructions   String?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  prescription Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  medication   Medication   @relation(fields: [medicationId], references: [id], onDelete: Restrict)

  @@unique([prescriptionId, medicationId])
  @@index([prescriptionId])
  @@index([medicationId])
  @@map("prescription_medications")
}

model DispenseRecord {
  id             String         @id @default(uuid()) @db.Uuid
  prescriptionId String         @map("prescription_id") @db.Uuid
  pharmacistId   String         @map("pharmacist_id") @db.Uuid
  dispensedAt    DateTime       @default(now()) @map("dispensed_at")
  status         DispenseStatus @default(DISPENSED)
  notes          String?
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  prescription Prescription   @relation(fields: [prescriptionId], references: [id], onDelete: Restrict)
  pharmacist   User           @relation("DispensePharmacist", fields: [pharmacistId], references: [id], onDelete: Restrict)
  items        DispenseItem[]

  @@index([prescriptionId])
  @@index([pharmacistId])
  @@index([status, dispensedAt])
  @@map("dispense_records")
}

model DispenseItem {
  id               String   @id @default(uuid()) @db.Uuid
  dispenseRecordId String   @map("dispense_record_id") @db.Uuid
  medicationId     String   @map("medication_id") @db.Uuid
  quantity         Int
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  dispenseRecord DispenseRecord @relation(fields: [dispenseRecordId], references: [id], onDelete: Cascade)
  medication     Medication     @relation(fields: [medicationId], references: [id], onDelete: Restrict)

  @@unique([dispenseRecordId, medicationId])
  @@index([medicationId])
  @@map("dispense_items")
}

/// Price-list row for services the clinic charges — consultation fees and
/// clinical actions (tindakan). Reference data like the terminology catalogs:
/// rows are deactivated, never deleted, because invoice items snapshot the
/// price they were billed at and only need the row for provenance.
///
/// `icd9cmCode` optionally maps a coded `Procedure` to its tariff so invoice
/// generation can auto-collect procedure charges; actions the clinic bills
/// without coding stay reachable by tariff `code` alone.
model ServiceTariff {
  id         String                @id @default(uuid()) @db.Uuid
  code       String                @unique
  name       String
  category   ServiceTariffCategory
  /// ICD-9-CM procedure code this tariff prices, when the action is coded.
  /// Unique so auto-collection resolves at most one tariff per procedure.
  icd9cmCode String?               @unique @map("icd9cm_code")
  /// Rupiah. CHECK in the migration rejects negative prices.
  price      Decimal               @db.Decimal(12, 2)
  isActive   Boolean               @default(true) @map("is_active")
  createdAt  DateTime              @default(now()) @map("created_at")
  updatedAt  DateTime              @updatedAt @map("updated_at")
  deletedAt  DateTime?             @map("deleted_at")

  invoiceItems InvoiceItem[]

  @@index([category])
  @@index([isActive])
  @@index([deletedAt])
  @@map("service_tariffs")
}

/// Sequence source for per-day invoice numbers — the `QueueCounter` reasoning
/// applied to the cashier: allocation is one atomic
/// `INSERT … ON CONFLICT … RETURNING` inside the invoice-create transaction,
/// never `MAX + 1`, which races. A rolled-back create returns its number; a
/// committed one is never reissued, so a voided invoice leaves a gap exactly
/// like a torn paper receipt.
model InvoiceCounter {
  invoiceDate DateTime @id @map("invoice_date") @db.Date
  nextValue   Int      @map("next_value")
  updatedAt   DateTime @default(now()) @map("updated_at")

  @@map("invoice_counters")
}

/// The cashier's bill for one visit, auto-collected from the finished
/// encounter (consultation fee, procedures, dispensed medications) in P9-T03.
///
/// `encounterId` is deliberately NOT `@unique`: a wrongly issued invoice is
/// corrected by voiding it (with reason and audit) and issuing a replacement
/// for the same encounter. A hand-written partial unique index
/// (`WHERE status <> 'VOID' AND deleted_at IS NULL`) enforces at most one
/// live invoice per encounter while letting voided ones accumulate.
///
/// `totalAmount` is stored, unlike derived clinical values: an invoice is a
/// financial document, and the total is part of what was issued — it must not
/// silently change if a tariff or item row is touched later. The service
/// recomputes it from items on every write while the invoice is DRAFT.
model Invoice {
  id            String        @id @default(uuid()) @db.Uuid
  invoiceNumber String        @unique @map("invoice_number")
  encounterId   String        @map("encounter_id") @db.Uuid
  patientId     String        @map("patient_id") @db.Uuid
  status        InvoiceStatus @default(DRAFT)
  totalAmount   Decimal       @default(0) @map("total_amount") @db.Decimal(12, 2)
  issuedAt      DateTime?     @map("issued_at")
  voidedAt      DateTime?     @map("voided_at")
  voidReason    String?       @map("void_reason")
  voidedById    String?       @map("voided_by_id") @db.Uuid
  createdById   String?       @map("created_by_id") @db.Uuid
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")
  deletedAt     DateTime?     @map("deleted_at")

  encounter Encounter      @relation(fields: [encounterId], references: [id], onDelete: Restrict)
  patient   PatientProfile @relation(fields: [patientId], references: [id], onDelete: Restrict)
  voidedBy  User?          @relation("InvoiceVoidedBy", fields: [voidedById], references: [id], onDelete: SetNull)
  createdBy User?          @relation("InvoiceCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  items     InvoiceItem[]
  payment   Payment?

  @@index([encounterId])
  @@index([patientId, createdAt])
  @@index([status, issuedAt])
  @@index([deletedAt])
  @@map("invoices")
}

/// One line on an invoice. `description`, `unitPrice`, and `amount` are a
/// snapshot of what was billed — the `Diagnosis` snapshot rule applied to
/// money: repricing a tariff or renaming a medication must never rewrite an
/// issued invoice. `serviceTariffId` / `medicationId` are provenance only,
/// `SetNull` so losing a catalog row never takes the billed line with it.
///
/// Items live and die with their invoice (`Cascade`): a DRAFT regenerate
/// replaces them wholesale, and a voided invoice keeps its lines because the
/// invoice row itself is never deleted.
model InvoiceItem {
  id              String          @id @default(uuid()) @db.Uuid
  invoiceId       String          @map("invoice_id") @db.Uuid
  itemType        InvoiceItemType @map("item_type")
  serviceTariffId String?         @map("service_tariff_id") @db.Uuid
  medicationId    String?         @map("medication_id") @db.Uuid
  description     String
  quantity        Int
  unitPrice       Decimal         @map("unit_price") @db.Decimal(12, 2)
  /// Always `quantity * unitPrice`, enforced by a CHECK in the migration —
  /// stored anyway because the row is a financial snapshot, not a view.
  amount          Decimal         @db.Decimal(12, 2)
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  invoice       Invoice        @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  serviceTariff ServiceTariff? @relation(fields: [serviceTariffId], references: [id], onDelete: SetNull)
  medication    Medication?    @relation(fields: [medicationId], references: [id], onDelete: SetNull)

  @@index([invoiceId])
  @@index([serviceTariffId])
  @@index([medicationId])
  @@map("invoice_items")
}

/// Settlement of one invoice. `invoiceId` is `@unique` on purpose: one full
/// payment per invoice is the v1 scope (partial payments are out), and the
/// constraint is that scope stated in the schema — relaxing it later is a
/// dropped index, not a rewrite. A payment recorded in error is corrected the
/// same way a wrong invoice is: void the invoice (P9-T03) and reissue, which
/// produces a fresh invoice for a fresh payment.
///
/// No `deletedAt`: a payment is money that changed hands, like a
/// `DispenseRecord` is stock that left the shelf — the row is permanent.
/// `cashierId` is `Restrict` for the same accountability reason as the
/// dispensing pharmacist: the person who took the money must stay resolvable.
model Payment {
  id              String        @id @default(uuid()) @db.Uuid
  invoiceId       String        @unique @map("invoice_id") @db.Uuid
  method          PaymentMethod
  /// Rupiah. Must equal the invoice's `totalAmount` — enforced in the service
  /// (cross-table), while the migration CHECK only rejects negatives.
  amount          Decimal       @db.Decimal(12, 2)
  /// External trace for non-cash methods: transfer slip, QRIS transaction id,
  /// or insurance approval number.
  referenceNumber String?       @map("reference_number")
  notes           String?
  paidAt          DateTime      @default(now()) @map("paid_at")
  cashierId       String        @map("cashier_id") @db.Uuid
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  cashier User    @relation("PaymentCashier", fields: [cashierId], references: [id], onDelete: Restrict)

  @@index([paidAt])
  @@index([cashierId])
  @@index([method, paidAt])
  @@map("payments")
}

model Role {
  id          String    @id @default(uuid()) @db.Uuid
  code        String    @unique
  name        String
  description String?
  isSystem    Boolean   @default(false) @map("is_system")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id            String          @id @default(uuid()) @db.Uuid
  permissionKey String          @unique @map("permission_key")
  resource      String
  action        String
  scope         PermissionScope
  description   String?
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  roles RolePermission[]

  @@index([resource, action, scope])
  @@map("permissions")
}

model RolePermission {
  id           String   @id @default(uuid()) @db.Uuid
  roleId       String   @map("role_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
}

model UserRole {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  roleId         String    @map("role_id") @db.Uuid
  assignedById   String?   @map("assigned_by_id") @db.Uuid
  assignedAt     DateTime  @default(now()) @map("assigned_at")
  unassignedById String?   @map("unassigned_by_id") @db.Uuid
  unassignedAt   DateTime? @map("unassigned_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  user         User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  role         Role  @relation(fields: [roleId], references: [id], onDelete: Restrict)
  assignedBy   User? @relation("RoleAssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)
  unassignedBy User? @relation("RoleUnassignedBy", fields: [unassignedById], references: [id], onDelete: SetNull)

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
  @@index([deletedAt])
  @@map("user_roles")
}

/// Outbox row for one encounter's SATUSEHAT bundle submission (P10-T04).
/// Created in the same transaction that closes the encounter, so a closed
/// visit can never silently miss the reporting queue, and clinical flows
/// never wait on Kemenkes availability.
///
/// The row carries scheduling state only — no payload snapshot. The bundle is
/// rebuilt from the clinical record at send time, so a diagnosis retracted
/// between close and submission is reported as corrected, not as signed.
/// One row per encounter: attempts increment in place, and the terminal
/// FAILED state is re-opened only by the admin retry surface (P10-T06).
model SatusehatSubmission {
  id                   String                    @id @default(uuid()) @db.Uuid
  encounterId          String                    @unique @map("encounter_id") @db.Uuid
  status               SatusehatSubmissionStatus @default(PENDING)
  attempts             Int                       @default(0)
  lastError            String?                   @map("last_error")
  /// Earliest instant the worker may (re)try; pushed forward exponentially on
  /// transient failures.
  nextAttemptAt        DateTime                  @default(now()) @map("next_attempt_at")
  lastAttemptAt        DateTime?                 @map("last_attempt_at")
  submittedAt          DateTime?                 @map("submitted_at")
  /// IHS Encounter id returned by the platform on success — the provenance
  /// link between the local record and the national one.
  satusehatEncounterId String?                   @map("satusehat_encounter_id")
  createdAt            DateTime                  @default(now()) @map("created_at")
  updatedAt            DateTime                  @updatedAt @map("updated_at")

  encounter Encounter @relation(fields: [encounterId], references: [id], onDelete: Restrict)

  @@index([status, nextAttemptAt])
  @@map("satusehat_submissions")
}

model AuditLog {
  id          String      @id @default(uuid()) @db.Uuid
  actorUserId String?     @map("actor_user_id") @db.Uuid
  action      AuditAction
  resource    String
  resourceId  String?     @map("resource_id")
  metadata    Json?
  requestId   String?     @map("request_id")
  occurredAt  DateTime    @default(now()) @map("occurred_at")

  actor User? @relation("AuditLogActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId, occurredAt])
  @@index([action, occurredAt])
  @@index([resource, resourceId])
  @@index([occurredAt])
  @@map("audit_logs")
}

/// BPJS PCare bridging credentials for one facility (P11-T02). Non-secret
/// identifiers are plaintext; the three secrets are sealed with AES-256-GCM
/// under BPJS_CREDENTIAL_ENCRYPTION_KEY and surface only as last-4 display
/// columns. `facilityId` is null on the single-tenant deployment — Postgres
/// unique indexes treat NULLs as distinct, so a hand-written partial unique
/// index in the migration is what actually keeps that row a singleton.
model BpjsPcareConfig {
  id                      String               @id @default(uuid()) @db.Uuid
  facilityId              String?              @unique @map("facility_id") @db.Uuid
  environment             BpjsPcareEnvironment
  consId                  String               @map("cons_id")
  kdProviderPpk           String               @map("kd_provider_ppk")
  pcareUsername           String               @map("pcare_username")
  secretKeyCiphertext     String               @map("secret_key_ciphertext")
  secretKeyLast4          String               @map("secret_key_last4")
  userKeyCiphertext       String               @map("user_key_ciphertext")
  userKeyLast4            String               @map("user_key_last4")
  pcarePasswordCiphertext String               @map("pcare_password_ciphertext")
  credentialKeyVersion    Int                  @default(1) @map("credential_key_version")
  isActive                Boolean              @default(true) @map("is_active")
  lastTestedAt            DateTime?            @map("last_tested_at")
  lastTestResult          String?              @map("last_test_result")
  createdAt               DateTime             @default(now()) @map("created_at")
  updatedAt               DateTime             @updatedAt @map("updated_at")

  @@map("bpjs_pcare_configs")
}

/// One row of a BPJS PCare reference catalog (P11-T03). The design doc lists
/// eight tables, but every catalog carries the identical shape (BPJS code,
/// display name, syncedAt), so they land as one enum-keyed table — the sync,
/// search, and mapping-validation surfaces stay generic instead of being
/// stamped out eight times. Rows are replaced wholesale per catalog on each
/// admin-triggered sync (POLI/DOKTER/KESADARAN/TINDAKAN/SPESIALIS/SARANA) or
/// upserted incrementally by keyword search-and-cache (DIAGNOSA/DPHO, whose
/// PCare endpoints are keyword lookups and cannot be enumerated). Dropdowns
/// and mapping screens read only this table — never live BPJS calls.
model BpjsReferenceItem {
  id      String               @id @default(uuid()) @db.Uuid
  catalog BpjsReferenceCatalog
  code    String
  display String
  /// Catalog-specific qualifier: for TINDAKAN rows the kdTkp bucket the row
  /// was fetched under ('10' rawat jalan, '20' rawat inap, '50' promotif);
  /// null for every other catalog.
  groupCode String?  @map("group_code")
  syncedAt  DateTime @map("synced_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([catalog, code])
  @@index([catalog, display])
  @@map("bpjs_reference_items")
}
