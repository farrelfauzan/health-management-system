enum PrivacyNoticeOutcome {
  ACKNOWLEDGED
  PROVIDED_ACKNOWLEDGEMENT_DECLINED
  DEFERRED_EMERGENCY
  /// The record was created by a machine-to-machine call with nobody present
  /// to receive the notice — today only BPJS `pasien baru` (P14-T04). It is a
  /// deferral, not an acknowledgement: the member acknowledged *BPJS's* notice
  /// in Mobile JKN, which is not the clinic's, and recording that as
  /// ACKNOWLEDGED would be fabricated evidence in an append-only legal record.
  /// The clinic owes this patient the notice at their first counter visit.
  DEFERRED_REMOTE_REGISTRATION
}

enum PrivacyNoticeLocale {
  id
  en
}

enum PrivacyNoticeSubjectType {
  SELF
  REPRESENTATIVE
}

enum PrivacyNoticeProvenance {
  FRONT_DESK
  PATIENT_PORTAL
  LEGACY_IMPORT
  EMERGENCY
  /// Created by the inbound BPJS Antrean bridge (P14-T04). Distinct from
  /// PATIENT_PORTAL: the patient never touched an HMS surface, and the only
  /// actor on the row is the reserved system account.
  BPJS_ANTREAN
  /// Created by the WhatsApp/Telegram customer-service channel (`PCS-T07`).
  /// Kept distinct from BPJS_ANTREAN even though both are machine-created
  /// deferrals: the two are owed the notice by different routes — a BPJS
  /// member arrives with a Mobile JKN booking, a channel customer arrives
  /// from a chat — and an auditor asking "which unnotified records came from
  /// the public chat channel" must not have to guess.
  CHANNEL_BOOKING
}

/// Lifecycle of a clinical encounter (the PMK 24/2022 medical record for one
/// visit). An encounter opens when the doctor starts seeing a checked-in
/// patient and is terminal once closed: FINISHED when the visit was delivered,
/// CANCELLED when it was opened in error. Records are never re-opened — a
/// correction is a new encounter, so the original stays auditable.
enum EncounterStatus {
  IN_PROGRESS
  FINISHED
  CANCELLED
}

/// Lifecycle of one SATUSEHAT outbox row. PENDING rows are due (or waiting
/// for their next backoff slot); SUBMITTED and FAILED are settled — FAILED is
/// re-opened only by an explicit admin retry (P10-T06), never by the worker.
enum SatusehatSubmissionStatus {
  PENDING
  SUBMITTED
  FAILED
}

