{
  "name": "health-management-system",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": ">=20.19.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --if-present dev",
    "build": "pnpm -r --if-present build",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "integration:test": "pnpm -r --if-present integration:test",
    "format": "pnpm -r --if-present format",
    "db:generate": "pnpm --filter @hms/api prisma:generate",
    "db:migrate:dev": "pnpm --filter @hms/api prisma:migrate:dev",
    "db:migrate:deploy": "pnpm --filter @hms/api prisma:migrate:deploy",
    "db:validate": "pnpm --filter @hms/api prisma:validate",
    "db:seed": "pnpm --filter @hms/api prisma:seed",
    "db:reset": "pnpm --filter @hms/api prisma:migrate:reset",
    "db:seed:sandbox-practitioner-nik": "pnpm --filter @hms/api seed:sandbox-practitioner-nik",
    "db:report:draft-patients": "pnpm --filter @hms/api report:draft-patients",
    "api:openapi:export": "pnpm --filter @hms/api openapi:export",
    "web:api:generate": "pnpm --filter @hms/web orval:generate",
    "api:contract:sync": "pnpm api:openapi:export && pnpm web:api:generate",
    "docker:dev:up": "docker compose -f infra/docker/docker-compose.dev.yml up -d postgres minio minio-init",
    "docker:dev:migrate": "docker compose -f infra/docker/docker-compose.dev.yml --profile tools run --rm migrate",
    "docker:dev:start": "docker compose -f infra/docker/docker-compose.dev.yml up -d api web",
    "docker:dev:pdf": "docker compose -f infra/docker/docker-compose.dev.yml --profile pdf up -d gotenberg",
    "docker:dev:down": "docker compose -f infra/docker/docker-compose.dev.yml down"
  },
  "pnpm": {
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-mh99-v99m-4gvg"
      ]
    },
    "overrides": {
      "brace-expansion@<1.1.18": "1.1.18",
      "brace-expansion@>=2.0.0 <2.1.4": "2.1.4",
      "brace-expansion@>=4.0.0 <5.0.9": "5.0.9",
      "fast-uri@<3.1.5": "3.1.5",
      "ip-address@<=10.3.0": "10.3.1",
      "js-yaml@>=3.0.0 <3.15.1": "3.15.1",
      "js-yaml@>=4.0.0 <4.3.1": "4.3.1",
      "nanoid@<3.3.18": "3.3.18",
      "postcss@<=8.5.17": "8.5.23",
      "sharp@<0.35.0": "0.35.0",
      "undici@>=7.0.0 <7.29.0": "7.29.0",
      "deepmerge-ts@<8.0.0": "8.0.1",
      "browserslist@<=4.28.6": "4.28.7",
      "mysql2@<3.22.0": "3.22.0"
    }
  }
}
